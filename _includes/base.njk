{% set useCityDiscovery = cityDiscovery.enabled and page.url == cityDiscovery.path %}{% set sfDistrictEditorial = sfDistrictEditorials.byPath[page.url] %}{% set useFinancialDistrictReference = financialDistrictReference.enabled and (page.url == "/commercial-real-estate/CA/san-francisco/financial-district/" or sfDistrictEditorial) %}<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-P38M67VE76"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-P38M67VE76');
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta property="og:image" content="https://www.rofo.com/images/og-default.png">

  {% set siteName = metadata.siteName or "Rofo" %}
  {% set defaultDescription = "Rofo helps businesses make better commercial real estate decisions by comparing markets, understanding tradeoffs, and starting the search in the right places." %}
  {% set siteUrl = metadata.siteUrl or "" %}
  {% set canonicalUrl = "" %}
  {% set pageTitle = siteName + " | Commercial Location Decisions" %}
  {% set pageDescription = (description or defaultDescription) | trim %}

  {% if canonical %}
    {% set canonicalUrl = canonical %}
  {% elseif siteUrl and page and page.url %}
    {% set canonicalUrl = siteUrl + page.url %}
  {% endif %}

  {% if title %}
    {% set pageTitle = title | trim %}
  {% endif %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {% if robots %}
    <meta name="robots" content="{{ robots }}">
  {% endif %}

  {% if canonicalUrl %}
    <link rel="canonical" href="{{ canonicalUrl }}">
  {% endif %}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ siteName }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">

  {% if canonicalUrl %}
    <meta property="og:url" content="{{ canonicalUrl }}">
  {% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
{% if useFinancialDistrictReference %}  <link rel="stylesheet" href="/assets/financial-district-reference.css">{% else %}  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/assets/css/system.css{% if page.url == "/find-locations/" %}?v={{ interviewAssets.stylesheetVersion }}{% endif %}">{% endif %}

{% if useCityDiscovery %}  <link rel="stylesheet" href="/assets/css/city-discovery.css">{% endif %}
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  {% if page.url == "/" %}
  <script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://www.rofo.com/#organization","name":"Rofo","url":"https://www.rofo.com/"},{"@type":"WebSite","@id":"https://www.rofo.com/#website","name":"Rofo","url":"https://www.rofo.com/","publisher":{"@id":"https://www.rofo.com/#organization"}}]}</script>
  {% endif %}
</head>
<body{% if useFinancialDistrictReference %} class="financial-district-reference"{% endif %}>

  {% if useFinancialDistrictReference %}{% set headerSearchHref = "/location-requirement/?city=" + (neighborhood.city | queryEncode) + "&state=" + (neighborhood.state_abbr | queryEncode) + "&district=" + (neighborhood.name | queryEncode) + "&source=district&sourcePath=" + (page.url | queryEncode) + "&marketId=" + (neighborhood.city_slug | queryEncode) + "&districtId=" + (neighborhood.slug | queryEncode) %}{% endif %}{% if useCityDiscovery %}{% set headerSearchHref = cityDiscovery.searchHref %}{% endif %}{% include "header.njk" %}

  <main>
    {{ content | safe }}
  </main>

{% include "footer.njk" %}

  <script src="/js/market-search.js" defer></script>
  <script src="/js/commercial-geography-experience.js" defer></script>
  {% if fieldPhotosPublic %}
    <script src="/js/field-photos-public.js" defer></script>
  {% endif %}
</body>
</html>
