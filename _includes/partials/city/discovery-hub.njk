<section class="city-discovery" aria-label="San Francisco commercial real estate guide">
  <div class="city-discovery__shell">
    {% include "partials/breadcrumbs.njk" %}
    <section class="city-discovery__hero" aria-labelledby="sf-discovery-heading">
      {% set fieldPhotoApproved = cityDiscovery.photo %}{% include "partials/shared/editorial-photo-slot.njk" %}{% set fieldPhotoApproved = null %}
      <div class="city-discovery__hero-copy">
        <div class="city-discovery__eyebrow">San Francisco commercial real estate</div>
        <h1 id="sf-discovery-heading">Explore San Francisco commercial real estate.</h1>
        <p>Discover neighborhoods, compare locations, and research buildings — then turn your insights into a personalized Location Brief.</p>
        <div class="city-discovery__actions"><a class="city-discovery__button" href="{{ cityDiscovery.searchHref }}">Start My Search <span aria-hidden="true">→</span></a><a class="city-discovery__button city-discovery__button--light" href="#sf-districts">Explore Districts</a></div>
      </div>
    </section>

    <nav class="city-discovery__types" aria-label="Explore San Francisco by space type">
    {% for type in cityDiscovery.types %}
      <a class="city-discovery__type" href="/commercial-real-estate/CA/san-francisco/{{ type.slug }}/">
        <span class="city-discovery__type-icon" aria-hidden="true">{% if type.icon == 'office' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 21V4h10v17M15 9h4v12M3 21h18M8 7h4M8 10h4M8 13h4M8 16h4M9 21v-2h3v2"/></svg>{% elseif type.icon == 'retail' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 10v11h16V10M3 10l2-7h14l2 7M3 10c0 3 4 3 4 0 0 3 5 3 5 0 0 3 5 3 5 0 0 3 4 3 4 0M9 21v-7h6v7"/></svg>{% elseif type.icon == 'industrial' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21V9l9-6 9 6v12H3zM7 21v-9h10v9M7 15h10M7 18h10"/></svg>{% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7l9-5 9 5-9 5-9-5zM3 12l9 5 9-5M3 17l9 5 9-5"/></svg>{% endif %}</span>
        <h2>{{ type.name }}</h2><p>{{ type.description }}</p><span class="city-discovery__link">Explore {{ type.name }} <span aria-hidden="true">→</span></span>
      </a>
    {% endfor %}
    </nav>

    <section class="city-discovery__chapter" id="sf-districts" aria-labelledby="sf-districts-heading">
      <div class="city-discovery__section-heading"><div><span class="city-discovery__kicker">Explore the city</span><h2 id="sf-districts-heading">San Francisco districts</h2><p>Every neighborhood has a different mix of buildings, business activity and daily routines. Explore the areas that fit the way your business works.</p></div><a class="city-discovery__link" href="#sf-all-districts">View all district guides <span aria-hidden="true">↓</span></a></div>
      {% set reviewedMap = reviewedMaps.byCityPath[page.url] %}{% set reviewedMapSuppressHeading = true %}{% set reviewedMapListId = "sf-city-map-places" %}{% include "partials/shared/reviewed-map.njk" %}{% set reviewedMapSuppressHeading = false %}{% set reviewedMapListId = null %}
      <nav class="city-discovery__districts" aria-label="Featured San Francisco district guides">{% for district in cityDiscovery.districts %}<a href="/commercial-real-estate/CA/san-francisco/{{ district.slug }}/">{{ district.name }} <span aria-hidden="true">→</span></a>{% endfor %}</nav>
      <details class="city-discovery__directory" id="sf-all-districts"><summary>Browse all San Francisco district guides</summary><nav aria-label="All San Francisco district guides"><ul>{% for district in cityNeighborhoods %}{% if district.slug != 'mission' %}<li><a href="{{ district.canonical_neighborhood_path }}">{% if district.slug == 'showplace-square' %}Showplace Square / Design District{% else %}{{ district.name }}{% endif %}</a>{% if district.slug == 'south-beach' %}<small>Existing guide</small>{% endif %}</li>{% endif %}{% endfor %}</ul></nav></details>
    </section>

    <section class="city-discovery__chapter" aria-labelledby="sf-comparisons-heading">
      <span class="city-discovery__kicker">Compare locations</span><h2 id="sf-comparisons-heading">See how San Francisco areas differ</h2><p class="city-discovery__section-intro">A few useful comparisons to help you narrow your focus.</p>
      <div class="city-discovery__comparisons">{% for comparison in cityDiscovery.comparisons %}<article class="city-discovery__comparison"><h3><a href="{{ comparison.path }}">{{ comparison.name }}</a></h3><p>{{ comparison.description }}</p><a class="city-discovery__link" href="{{ comparison.path }}">Compare the districts <span aria-hidden="true">→</span></a></article>{% endfor %}</div>
    </section>

    <div class="city-discovery__research-row">
      <section class="city-discovery__chapter" aria-labelledby="sf-buildings-heading"><span class="city-discovery__kicker">Featured buildings</span><h2 id="sf-buildings-heading">Notable buildings in San Francisco</h2><p class="city-discovery__section-intro">A few different commercial settings. These are research examples, not confirmed available spaces.</p><div class="city-discovery__buildings">{% for building in cityDiscovery.buildings %}<article class="city-discovery__building"><span class="city-discovery__building-type">{{ building.label }} · {{ building.district }}</span><h3><a href="{{ building.path }}">{{ building.name }}</a></h3><p>{{ building.description }}</p><a class="city-discovery__link" href="{{ building.path }}">View building profile <span aria-hidden="true">→</span></a></article>{% endfor %}</div></section>
      <section class="city-discovery__chapter" aria-labelledby="sf-resources-heading"><span class="city-discovery__kicker">Plan your search</span><h2 id="sf-resources-heading">San Francisco resources</h2><ul class="city-discovery__resources">{% for resource in cityDiscovery.resources %}<li><a href="/commercial-real-estate/lease-guide/{{ resource.slug }}/"><span>{{ resource.name }}</span><span aria-hidden="true">→</span></a></li>{% endfor %}</ul></section>
    </div>

    <section class="city-discovery__final" aria-labelledby="sf-next-heading"><div><h2 id="sf-next-heading">Turn your research into a plan.</h2><p>Tell us what you need and we'll create a Location Brief with recommendations and next steps for your San Francisco search.</p></div><a class="city-discovery__button" href="{{ cityDiscovery.searchHref }}">Start My Search <span aria-hidden="true">→</span></a></section>
  </div>
</section>
