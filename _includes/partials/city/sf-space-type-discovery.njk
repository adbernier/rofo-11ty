{% set discovery = sfCommercialGeographyExperience %}
<section class="city-card sf-space-type-discovery" data-commercial-geography-surface="sf-city" aria-labelledby="sf-space-type-heading">
  <div class="eyebrow">Explore San Francisco</div>
  <h2 id="sf-space-type-heading">What kind of space are you looking for?</h2>
  <p>Choose a space type first. Each opens a different set of San Francisco commercial environments.</p>
  <div class="sf-space-type-discovery__grid">
    {% for choice in discovery.spaceTypes %}
      <a class="sf-space-type-choice" href="{{ choice.path }}" data-geography-event="space_type_selected" data-market="san-francisco" data-property-type="{{ choice.id }}" data-source-surface="sf_city">
        <strong>{{ choice.label }}</strong>
        <span>{{ choice.geographies.length }} commercial environments</span>
        <em>Explore {{ choice.label }} →</em>
      </a>
    {% endfor %}
  </div>
</section>
