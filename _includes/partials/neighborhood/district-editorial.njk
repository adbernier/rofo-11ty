{% set districtSearchHref = "/location-requirement/?city=" + (neighborhood.city | queryEncode) + "&state=" + (neighborhood.state_abbr | queryEncode) + "&district=" + (neighborhood.name | queryEncode) + "&source=district&sourcePath=" + (page.url | queryEncode) + "&marketId=" + (neighborhood.city_slug | queryEncode) + "&districtId=" + (neighborhood.slug | queryEncode) %}
<div class="wrap"><nav class="crumb" aria-label="Breadcrumb"><a href="/commercial-real-estate/CA/san-francisco/">San Francisco</a> &nbsp;/&nbsp; {{ neighborhood.name }}</nav>
<section class="hero"><div><div class="eyebrow">San Francisco · District guide</div><h1>{{ neighborhood.name }}</h1>{% for paragraph in districtEditorial.introduction %}<p{% if loop.first %} class="lead"{% endif %}>{{ paragraph }}</p>{% endfor %}</div><aside class="actionbox"><div class="pill">Find your starting point</div><h3>Is {{ neighborhood.name }} right for your business?</h3><p>Tell us a little about what you're looking for. We'll suggest locations and buildings worth exploring.</p><a class="btn" href="{{ districtSearchHref }}">Start my search &nbsp; →</a><div class="small">Free to explore · No account needed for initial recommendations</div></aside></section>
{% include "partials/shared/district-photograph.njk" %}
<section class="section"><div class="eyebrow">The character of the area</div><h2>{{ districtEditorial.characterHeading }}</h2>{% for paragraph in districtEditorial.character %}<p class="intro">{{ paragraph }}</p>{% endfor %}<div class="twocol"><article class="alt"><h3>Worth considering if</h3><p>{{ districtEditorial.fit }}</p></article><article class="alt"><h3>What we'd check</h3><p>{{ districtEditorial.check }}</p></article></div></section>
<section class="section"><div class="eyebrow">Get oriented</div><h2>Explore the district</h2><p class="intro">{{ districtEditorial.geography }}</p>{% set reviewedMap = reviewedMaps.byDistrictPath[page.url] %}{% set reviewedMapSuppressHeading = true %}{% set reviewedMapListId = neighborhood.slug + "-building-links" %}{% include "partials/shared/reviewed-map.njk" %}{% set reviewedMapSuppressHeading = false %}{% set reviewedMapListId = null %}</section>
{% if districtEditorial.buildings.length %}<section class="section"><div class="eyebrow">Where we'd start</div><h2>Buildings worth exploring</h2><p class="intro">These buildings help explain the area and the choices worth investigating. They are starting points for research, not confirmed available spaces.</p><div class="twocol">{% for building in districtEditorial.buildings %}<article class="building"><div class="type">{{ building.label }}</div><h3>{{ building.name }}</h3><p>{{ building.description }}</p><div class="bottom"><a class="textlink" href="{{ building.path }}">View building profile →</a></div></article>{% endfor %}</div></section>{% endif %}
<section class="section"><div class="eyebrow">Compare nearby</div><h2>Other areas worth exploring</h2><div class="alternatives">{% for alternative in districtEditorial.alternatives %}<article class="alt"><h3>{{ alternative.name }}</h3><p>{{ alternative.reason }}</p><a class="textlink" href="{{ alternative.path }}">Explore district →</a></article>{% endfor %}</div></section>
<section class="section"><details><summary>Sources and further reading</summary><p class="small">Reviewed {{ districtEditorial.reviewed }}. Historic and building descriptions do not establish current availability, permitted uses or the condition of a particular suite.</p><ul>{% for source in districtEditorial.sources %}<li><a href="{{ source.url }}" rel="noopener">{{ source.title }}</a> — {{ source.basis }}</li>{% endfor %}</ul></details></section>
<section class="section" style="border:0;padding-bottom:25px"><div class="cta"><div><h2>Find places that fit your business.</h2><p>Tell us a little about what you're looking for. We'll suggest locations and buildings worth exploring.</p></div><a class="btn" href="{{ districtSearchHref }}">Start my search &nbsp; →</a></div></section></div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Markets","item":"https://www.rofo.com/markets/"},{"@type":"ListItem","position":2,"name":"San Francisco, CA","item":"https://www.rofo.com/commercial-real-estate/CA/san-francisco/"},{"@type":"ListItem","position":3,"name":{{ neighborhood.name | dump | safe }},"item":{{ (metadata.siteUrl + page.url) | dump | safe }}}]}</script>
