{% set representativeContent = neighborhood.representative_content %}
{% set representativeBuildingCards = neighborhood.representative_building_cards %}
{% if representativeContent and representativeContent.length %}
  <section class="city-card representative-building-cards" aria-labelledby="representative-building-cards-heading">
    <div class="eyebrow">Representative commercial environments</div>
    <h2 id="representative-building-cards-heading">What commercial space here can feel like</h2>
    <p>{{ neighborhood.representative_content_disclaimer }}</p>

    <div class="representative-building-card-grid">
      {% for item in representativeContent %}
        <article class="representative-building-card" data-representative-content-kind="{{ item.kind }}">
          <div class="representative-building-card__header">
            <p class="representative-building-card__type">{{ item.buildingType }}</p>
            <h3>{% if item.canonicalUrl %}<a href="{{ item.canonicalUrl }}">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %}</h3>
            {% if item.address %}<p class="representative-building-card__address">{{ item.address }}</p>{% endif %}
          </div>
          <p class="representative-building-card__descriptor">{{ item.descriptor }}</p>
          <p class="representative-building-card__reason">{{ item.representativeReason }}</p>
          {% if item.relevantSpaceTypes and item.relevantSpaceTypes.length %}
            <div class="representative-building-card__tags" aria-label="Relevant space types">
              {% for spaceType in item.relevantSpaceTypes %}<span>{{ spaceType | title }}</span>{% endfor %}
            </div>
          {% endif %}
          {% if item.caveat %}<p class="semantic-footnote"><strong>What to verify:</strong> {{ item.caveat }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% elseif representativeBuildingCards and representativeBuildingCards.length %}
  <section class="city-card representative-building-cards" aria-labelledby="representative-building-cards-heading">
    <div class="eyebrow">Example Buildings</div>
    <h2 id="representative-building-cards-heading">Buildings that help explain this district</h2>
    <p>
      These representative examples are drawn from existing Rofo building and historical listing signals. Use them to understand building types, district character, and validation questions; they do not indicate current availability.
    </p>

    <div class="representative-building-card-grid">
      {% for buildingCard in representativeBuildingCards %}
        <article class="representative-building-card">
          <div class="representative-building-card__header">
            <p class="representative-building-card__type">{{ buildingCard.building_type_summary }}</p>
            <h3>
              {% if buildingCard.canonical_path %}
                <a href="{{ buildingCard.canonical_path }}">{{ buildingCard.name }}</a>
              {% else %}
                {{ buildingCard.name }}
              {% endif %}
            </h3>
            <p class="representative-building-card__address">{{ buildingCard.address }}</p>
          </div>

          {% if buildingCard.size %}
            <p class="representative-building-card__meta">{{ buildingCard.size }}</p>
          {% endif %}

          <p class="representative-building-card__descriptor">{{ buildingCard.descriptor }}</p>
          <p class="representative-building-card__reason">{{ buildingCard.representative_reason }}</p>

          {% if buildingCard.decision_context or buildingCard.common_fit or buildingCard.tradeoff or buildingCard.validation_prompt %}
            <div class="representative-building-card__decision">
              {% if buildingCard.decision_context %}
                <p><strong>Why it matters:</strong> {{ buildingCard.decision_context }}</p>
              {% endif %}
              {% if buildingCard.common_fit %}
                <p><strong>Common fit:</strong> {{ buildingCard.common_fit }}</p>
              {% endif %}
              {% if buildingCard.tradeoff %}
                <p><strong>Tradeoff:</strong> {{ buildingCard.tradeoff }}</p>
              {% endif %}
              {% if buildingCard.validation_prompt %}
                <p><strong>Validate:</strong> {{ buildingCard.validation_prompt }}</p>
              {% endif %}
            </div>
          {% endif %}

          {% if buildingCard.keyword_tags and buildingCard.keyword_tags.length %}
            <div class="representative-building-card__tags" aria-label="Commercial context signals">
              {% for tag in buildingCard.keyword_tags %}
                <span>{{ tag }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
