{% set geographyViews = sfCommercialGeographyExperience.byGeographyId[neighborhood.slug] %}
{% if geographyViews and geographyViews.length %}
  {% set geography = geographyViews[0] %}
  <section class="city-card sf-geography-route-context" data-commercial-geography-surface="sf_geography_route" data-market="san-francisco" data-geography-id="{{ geography.id }}">
    <div class="sf-geography-breadcrumb" aria-label="Commercial geography hierarchy"><a href="{{ sfCommercialGeographyExperience.city.path }}">San Francisco</a><span>›</span><a href="{{ geography.spaceTypePath }}">{{ geography.spaceTypeLabel }}</a><span>›</span><strong>{{ geography.label }}</strong></div>
    <nav class="sf-space-type-selector" aria-label="{{ geography.label }} space types">{% for view in geographyViews %}<a href="{{ view.spaceTypePath }}#{{ view.id }}" {% if loop.first %}aria-current="page" class="is-current"{% endif %} data-geography-event="space_type_selected" data-property-type="{{ view.spaceType }}" data-geography-id="{{ geography.id }}" data-source-surface="sf_geography_route">{{ view.spaceTypeLabel }}</a>{% endfor %}</nav>
    <div class="eyebrow">{{ geography.geographyTypeLabel }}</div><h2>{{ geography.label }} commercial geography</h2><p>{{ geography.description }}</p>
    <div class="sf-evidence-label">Area pattern</div><div class="semantic-chip-row">{% for pattern in geography.areaPatterns %}<span>{{ pattern }}</span>{% endfor %}</div><p class="semantic-footnote">Area patterns describe geography context, not verified property capabilities.</p>
    {% if geography.orientation.length %}<h3>Orientation</h3><ul>{% for fact in geography.orientation %}<li>{{ fact }}</li>{% endfor %}</ul>{% endif %}
    {% if geography.representatives.length %}<h3>Representative properties and environments</h3><div class="sf-representative-grid">{% for property in geography.representatives.slice(0,2) %}<article class="sf-representative-card sf-representative-card--compact"><div class="sf-representative-card__visual" aria-hidden="true"><span>{{ property.propertyType | first }}</span><i></i><i></i></div><div class="sf-representative-card__body"><h4>{{ property.name }}</h4>{% if property.address %}<p>{{ property.address }}</p>{% endif %}<p><strong>Property type</strong><br>{{ property.propertyType }}</p><div class="sf-evidence-label">Area pattern</div><div class="semantic-chip-row">{% for pattern in property.areaPatterns.slice(0,3) %}<span>{{ pattern }}</span>{% endfor %}</div>{% if property.propertyVerified %}<p><strong>Property verified</strong><br>{{ property.propertyVerified }}</p>{% endif %}{% if property.investigate %}<p class="sf-investigate"><strong>Investigate</strong><br>{{ property.investigate }}</p>{% endif %}{% if property.canonicalUrl %}<a class="building-link" href="{{ property.canonicalUrl }}" data-geography-event="representative_property_selected" data-property-id="{{ property.id }}" data-geography-id="{{ geography.id }}" data-source-surface="sf_geography_route">Explore property →</a>{% endif %}</div></article>{% endfor %}</div>{% endif %}
    <div class="sf-investigation-boundary"><h3>What still needs investigation</h3><p>{{ sfCommercialGeographyExperience.availabilityFirewall }}</p></div>
    {% if geography.related.length %}<nav class="sf-related-geographies" aria-label="Related geographies"><strong>Compare</strong>{% for related in geography.related %}{% if related.path %}<a href="{{ related.path }}" data-geography-event="related_geography_selected" data-geography-id="{{ related.id }}" data-source-surface="sf_geography_route">{{ related.label }}</a>{% endif %}{% endfor %}</nav>{% endif %}
    <div class="sf-location-intelligence-cta"><div><h3>Not sure which area is right for your business?</h3><p>Compare the location against how your business actually operates.</p></div><a class="btn-primary" href="/find-locations/?city=San%20Francisco&state=CA&propertyType={{ geography.spaceType }}&source=commercial_geography&geography={{ geography.id }}" data-geography-event="location_intelligence_cta_clicked" data-geography-id="{{ geography.id }}" data-source-surface="sf_geography_route">Find the right location →</a></div>
  </section>
{% endif %}
