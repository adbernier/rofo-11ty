{% set locator = neighborhood.district_locator_map %}
{% if locator %}
  <section class="city-card neighborhood-locator-map{% if locator.promote_to_identity %} neighborhood-locator-map--identity{% endif %}" aria-labelledby="neighborhood-locator-map-title">
    <div class="neighborhood-locator-map__copy">
      <div class="eyebrow">{{ locator.eyebrow }}</div>
      <h2 id="neighborhood-locator-map-title">{{ locator.title }}</h2>
      <p>{{ locator.copy }}</p>
    </div>

    <figure class="neighborhood-locator-map__figure">
      {% if locator.variant == "financial_district_sf" %}
