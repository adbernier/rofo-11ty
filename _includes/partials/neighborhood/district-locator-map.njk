          <text x="328" y="116" class="neighborhood-locator-map__label">Jackson Square</text>
          <text x="322" y="248" class="neighborhood-locator-map__label">SoMa</text>
          <text x="548" y="324" class="neighborhood-locator-map__label">Mission Bay</text>
          <text x="160" y="158" class="neighborhood-locator-map__label">Union Square</text>
          <text x="92" y="112" class="neighborhood-locator-map__street">Market St</text>
          <text x="700" y="72" class="neighborhood-locator-map__street">Bay Bridge</text>
          <text x="720" y="238" class="neighborhood-locator-map__water-label">Embarcadero</text>
        </g>

        <g class="neighborhood-locator-map__note">
          <text x="34" y="508">Simplified contextual map, not a legal boundary</text>
        </g>
      </svg>
      {% elif locator.variant == "sf_central_context" %}
