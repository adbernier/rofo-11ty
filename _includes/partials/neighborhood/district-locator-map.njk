          <linearGradient id="financial-district-locator-water" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#e9f6fb" />
            <stop offset="100%" stop-color="#d7edf5" />
          </linearGradient>
          <linearGradient id="financial-district-locator-district" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#dbe7f8" />
            <stop offset="100%" stop-color="#b8cdea" />
