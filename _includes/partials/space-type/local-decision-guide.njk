{% if entry.localDecisionGuide %}
  <section class="content-card space-type-local-decision"{% if entry.localDecisionGuide.experimentId %} data-experiment="{{ entry.localDecisionGuide.experimentId }}"{% endif %} aria-labelledby="space-type-local-decision-heading">
    <div class="eyebrow">{{ entry.localDecisionGuide.eyebrow }}</div>
    <h2 id="space-type-local-decision-heading">{{ entry.localDecisionGuide.title }}</h2>
    <p>{{ entry.localDecisionGuide.introduction }}</p>

    {% if entry.localDecisionGuide.groups and entry.localDecisionGuide.groups.length %}
      <div class="space-type-decision-groups">
        {% for group in entry.localDecisionGuide.groups %}
          <details class="neighborhood-decision-guidance space-type-decision-group"{% if loop.first %} open{% endif %}>
            <summary>
              <strong>{{ group.title }}</strong>
              <span>{{ group.introduction }}</span>
            </summary>
            <div class="neighborhood-comparison-grid">
              {% for option in group.entries %}
                <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ option.path }}">
                  <h3>{{ option.name }}</h3>
                  <p>{{ option.summary }}</p>
                </a>
              {% endfor %}
            </div>
          </details>
        {% endfor %}
      </div>
    {% else %}
      <div class="neighborhood-comparison-grid">
        {% for option in entry.localDecisionGuide.entries %}
          {% if option.path %}
            <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ option.path }}">
              <div class="eyebrow">{{ option.label }}</div>
              <h3>{{ option.name }}</h3>
              <p>{{ option.summary }}</p>
              {% if option.strengths and option.strengths.length %}
                <p><strong>Strengths:</strong> {% for item in option.strengths %}{{ item }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
              {% endif %}
              {% if option.tradeoffs and option.tradeoffs.length %}
                <p><strong>Tradeoffs:</strong> {% for item in option.tradeoffs %}{{ item }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
              {% endif %}
            </a>
          {% else %}
            <article class="neighborhood-comparison-card">
              <div class="eyebrow">{{ option.label }}</div>
              <h3>{{ option.name }}</h3>
              <p>{{ option.summary }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if entry.localDecisionGuide.operatingPatterns and entry.localDecisionGuide.operatingPatterns.length %}
      <div class="neighborhood-decision-guidance">
        <h3>How the operating requirement changes the search</h3>
        <ul>
          {% for pattern in entry.localDecisionGuide.operatingPatterns %}
            <li><strong>{{ pattern.name }}:</strong> {{ pattern.explanation }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if entry.localDecisionGuide.parentContexts and entry.localDecisionGuide.parentContexts.length %}
      <div class="neighborhood-decision-guidance">
        <h3>How the broader neighborhoods relate</h3>
        <div class="neighborhood-comparison-grid">
          {% for context in entry.localDecisionGuide.parentContexts %}
            <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ context.path }}">
              <h4>{{ context.name }}</h4>
              <p>{{ context.explanation }}</p>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if entry.localDecisionGuide.contexts and entry.localDecisionGuide.contexts.length %}
      <div class="neighborhood-decision-guidance space-type-decision-contexts">
        <h3>Important context—not ordinary ranked choices</h3>
        <ul>
          {% for context in entry.localDecisionGuide.contexts %}
            <li><strong>{% if context.path %}<a href="{{ context.path }}">{{ context.name }}</a>{% else %}{{ context.name }}{% endif %}:</strong> {{ context.explanation }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if entry.localDecisionGuide.representativeEnvironment %}
      <div class="neighborhood-decision-guidance">
        <div class="eyebrow">{{ entry.localDecisionGuide.representativeEnvironment.label }}</div>
        <h3><a href="{{ entry.localDecisionGuide.representativeEnvironment.path }}">{{ entry.localDecisionGuide.representativeEnvironment.name }}</a></h3>
        <p>{{ entry.localDecisionGuide.representativeEnvironment.summary }}</p>
      </div>
    {% endif %}

    {% if entry.localDecisionGuide.representativeEnvironments and entry.localDecisionGuide.representativeEnvironments.length %}
      <div class="neighborhood-decision-guidance">
        <div class="eyebrow">Representative commercial environments</div>
        <h3>What Industrial space here can feel like</h3>
        <div class="neighborhood-comparison-grid">
          {% for example in entry.localDecisionGuide.representativeEnvironments %}
            <article class="neighborhood-comparison-card">
              <div class="eyebrow">{{ example.label }}</div>
              <h4><a href="{{ example.path }}">{{ example.name }}</a></h4>
              <p>{{ example.summary }}</p>
              {% if example.contextPath %}<p><a href="{{ example.contextPath }}">Understand {{ example.contextName }} →</a></p>{% endif %}
            </article>
          {% endfor %}
        </div>
        <p class="semantic-footnote">{{ entry.localDecisionGuide.representativeDisclaimer }}</p>
      </div>
    {% endif %}

    {% if entry.localDecisionGuide.relatedGuides and entry.localDecisionGuide.relatedGuides.length %}
      <div class="neighborhood-decision-guidance">
        <h3>Related space decisions</h3>
        <ul>
          {% for related in entry.localDecisionGuide.relatedGuides %}
            <li><strong><a href="{{ related.path }}">{{ related.name }}</a>:</strong> {{ related.explanation }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <div class="neighborhood-decision-guidance">
      <h3>What to verify before comparing spaces</h3>
      <ul>
        {% for item in entry.localDecisionGuide.validation %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>

    <p class="semantic-footnote">District guidance explains operating patterns, not current availability or verified capability in a particular suite.</p>

    {% if entry.localDecisionGuide.recommendation %}
      <div class="neighborhood-decision-guidance">
        <p><strong>{{ entry.localDecisionGuide.recommendation.prompt }}</strong></p>
        <a class="btn-primary" href="{{ entry.localDecisionGuide.recommendation.path }}">{{ entry.localDecisionGuide.recommendation.label }}</a>
      </div>
    {% endif %}
  </section>
{% endif %}
