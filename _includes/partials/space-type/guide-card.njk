{% if spaceType.guide %}
  <div class="city-card">
    <div class="eyebrow">Guide</div>
    <h2>{{ spaceType.guide.title }}</h2>
    <p>{{ spaceType.guide.intro }}</p>

    <div class="mini-guide">
      {% for item in spaceType.guide.items %}
        <div class="mini-guide__item">
          <h3>{{ item.heading }}</h3>
          <p>{{ item.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% set marketGuideKey = (stateAbbr | upper) + "/" + (city.slug | lower) + "/" + spaceType.slug %}
{% set marketGuide = marketGuideLookup[marketGuideKey] %}
{% if marketGuide %}
  <div class="city-card">
    <div class="eyebrow">Market Guide</div>
    <h2>{{ marketGuide.title }}</h2>
    <p>Compare average {{ marketGuide.space_type_short_label }} rents, leasing trends, and neighborhood options before starting your search.</p>
    <div class="button-row">
      <a class="btn-secondary" href="{{ marketGuide.url }}">Read the {{ marketGuide.city }} {{ marketGuide.space_type_short_label }} guide</a>
    </div>
  </div>
{% endif %}
