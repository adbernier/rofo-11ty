{% if reviewedMap %}
<link rel="stylesheet" href="/assets/reviewed-map.css">
<section class="rofo-map" data-rofo-map data-desktop="{{ reviewedMap.desktop | escape }}" data-mobile="{{ reviewedMap.mobile | escape }}" aria-label="{{ reviewedMap.title | escape }}">
  <h2>{{ reviewedMap.title | escape }}</h2>
  {% if reviewedMap.type != 'city' and (reviewedMap.cityUrl or (reviewedMap.type == 'property' and reviewedMap.districtUrl)) %}<p class="rofo-map__parent">{% if reviewedMap.cityUrl %}<a href="{{ reviewedMap.cityUrl | escape }}">{{ reviewedMap.cityName | escape }} areas</a>{% endif %}{% if reviewedMap.type == 'property' and reviewedMap.districtUrl %} · <a href="{{ reviewedMap.districtUrl | escape }}">{{ reviewedMap.districtName | escape }}</a>{% endif %}</p>{% endif %}
  <div class="rofo-map__layout">
    <div>
      <div class="rofo-map__canvas" data-map-canvas>
        <noscript><picture><source media="(max-width: 760px)" srcset="{{ reviewedMap.mobile | escape }}"><img src="{{ reviewedMap.desktop | escape }}" alt="{{ reviewedMap.title | escape }}. Numbered locations match the text list; shading marks approximate reference locations." width="800" height="560" loading="lazy" decoding="async"></picture></noscript>
        <p class="rofo-map__note" data-map-loading hidden>Loading map… The text list is available below.</p>
      </div>
      <div class="rofo-map__pages" data-map-pages hidden><button type="button" data-map-previous>{% if reviewedMap.type == 'city' %}Previous areas{% else %}Previous locations{% endif %}</button><span data-map-page-status></span><button type="button" data-map-next>{% if reviewedMap.type == 'city' %}More areas{% else %}More locations{% endif %} →</button></div>
      {% if reviewedMap.items.length > 12 %}<noscript><p class="rofo-map__note">The static map shows the first 12 areas. All areas are linked in the text list.</p></noscript>{% endif %}
      <p class="rofo-map__note">{% if reviewedMap.type == 'property' %}Dot shows an approximate address position.{% else %}Shading shows approximate locations, not district boundaries.{% endif %}</p>
    </div>
    <div>
      <div class="rofo-map__selected" data-map-summary aria-live="polite" aria-atomic="true">
        <h3>{{ reviewedMap.items[0].name | escape }}</h3>
        <p>{{ reviewedMap.items[0].description | escape }}</p>
        <p class="rofo-map__note">{{ reviewedMap.items[0].status | escape }}</p>
        {% if reviewedMap.items[0].url != page.url %}<a class="rofo-map__action" href="{{ reviewedMap.items[0].url | escape }}">{% if reviewedMap.items[0].kind == 'property' %}Explore this property{% elif reviewedMap.items[0].scope == 'citywide' %}Read this city guide{% else %}Explore this area{% endif %} →</a>{% endif %}
      </div>
      <details class="rofo-map__list"{% if reviewedMap.items.length == 1 and not reviewedMap.unmapped.length %} hidden{% endif %}><summary>Choose from the list ({{ (reviewedMap.items.length + reviewedMap.unmapped.length) | escape }})</summary>
        <ol>
          {% for item in reviewedMap.items %}<li data-map-item data-kind="{{ item.kind | escape }}" data-scope="{{ item.scope | escape }}" data-status="{{ item.status | escape }}" data-description="{{ item.description | escape }}">
            <button type="button" data-map-select="{{ loop.index0 | escape }}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}" hidden>{{ loop.index | escape }} · <span>{{ item.name | escape }}</span></button>
            <a href="{{ item.url | escape }}" data-map-link>{{ item.name | escape }} →</a>
          </li>{% endfor %}
          {% for item in reviewedMap.unmapped %}<li class="rofo-map__unplotted"><a href="{{ item.url | escape }}">{{ item.name | escape }} →</a><p class="rofo-map__note">Not plotted: {{ item.reason | escape }}</p></li>{% endfor %}
        </ol>
      </details>
    </div>
  </div>
  {% if reviewedMap.type == 'district' and reviewedMap.items.length == 1 %}<p class="rofo-map__note">No property address positions have been cleared for this map. No locations have been inferred from the area.</p>{% endif %}
  <details class="rofo-map__sources"><summary>Map sources and coverage</summary>
    <p>Road geometry: <a href="https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/Transportation/MapServer">U.S. Census Bureau TIGERweb</a>, checked 17 October 2026. <a href="https://www.census.gov/about/policies/open-gov.html">Census open data</a>. Location context: existing Rofo district records. These are reference locations, not surveyed edges or complete city coverage. Unshaded places may be unreviewed; the map does not establish overlaps or zoning.</p>
    <p>Property address positions use exact U.S. Census address matches, calculated along a street address range. Existing Phoenix points retain <a href="https://gis.maricopa.gov/arcgis/rest/services/Geocode/MaricopaCountyGeocodeService/GeocodeServer">Maricopa County GIS</a> address evidence. A dot does not identify a parcel, suite or entrance. Location evidence says nothing about availability or permitted use.</p>
    <a href="{{ reviewedMap.sourceRecord | escape }}">Geographic source records and review gaps →</a>
    {% if reviewedMap.unmapped.length %}<h3>Not plotted: geographic review needed</h3><ul>{% for item in reviewedMap.unmapped %}<li><a href="{{ item.url | escape }}">{{ item.name | escape }}</a> — {{ item.reason | escape }}</li>{% endfor %}</ul>{% endif %}
  </details>
</section>
<script src="/js/reviewed-map.js" defer></script>
{% elif mapReview %}
<section class="city-card rofo-map-review" aria-label="Map review status"><h2>Map position needs review</h2><p>This guide remains available, but we have not plotted an uncertain location.</p><details><summary>Why this area is not plotted</summary><p>{{ mapReview.reason | escape }}</p></details>{% if mapReview.cityUrl %}<p><a href="{{ mapReview.cityUrl | escape }}">Explore {{ mapReview.cityName | escape }} areas →</a></p>{% endif %}</section>
{% endif %}
