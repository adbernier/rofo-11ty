<aside
  class="search-profile-shell{% if searchProfileContext.layout %} search-profile-shell--{{ searchProfileContext.layout }}{% endif %}"
  id="{{ searchProfileContext.anchor_id or 'search-profile' }}"
  data-search-profile
  data-profile-layout="{{ searchProfileContext.layout or '' }}"
  data-profile-submit-enabled="{{ 'true' if searchProfileContext.submit_enabled else 'false' }}"
  data-profile-submit-endpoint="{{ searchProfileContext.submit_endpoint or '/api/leads/submit' }}"
  data-profile-context-target-area="{{ searchProfileContext.target_area or '' }}"
  data-profile-context-city="{{ searchProfileContext.city or '' }}"
  data-profile-context-district="{{ searchProfileContext.district or '' }}"
  data-profile-context-street="{{ searchProfileContext.street or '' }}"
  data-profile-context-type="{{ searchProfileContext.context_type or '' }}"
  data-profile-context-label="{{ searchProfileContext.context_label or '' }}"
  data-profile-page-url="{{ searchProfileContext.page_url or '' }}"
  data-profile-page-title="{{ searchProfileContext.page_title or '' }}"
  data-profile-state="{{ searchProfileContext.state or searchProfileContext.state_abbr or '' }}"
  data-profile-routing-market="{{ searchProfileContext.routing_market or '' }}"
  data-profile-routing-county="{{ searchProfileContext.routing_county or '' }}"
  data-profile-neighborhood-name="{{ searchProfileContext.neighborhood_name or '' }}"
  data-profile-neighborhood-slug="{{ searchProfileContext.neighborhood_slug or '' }}"
  data-profile-neighborhood-path="{{ searchProfileContext.neighborhood_path or '' }}"
  data-profile-commercial-area-id="{{ searchProfileContext.commercial_area_id or '' }}"
  data-profile-commercial-area-type="{{ searchProfileContext.commercial_area_type or '' }}"
  data-profile-compared-districts="{{ searchProfileContext.compared_districts or '' }}"
  data-profile-primary-archetype="{{ searchProfileContext.primary_archetype or '' }}"
  data-profile-business-ecosystem="{{ searchProfileContext.business_ecosystem or '' }}"
  data-profile-location-suggestions="{{ (searchProfileContext.location_suggestions or []) | join('||') }}"
  data-profile-default-space-type="{{ searchProfileContext.default_space_type or '' }}"
  data-profile-space-type-context="{{ searchProfileContext.space_type_context_label or '' }}"
  aria-label="Search profile"
>
  <div class="search-profile-backdrop" data-profile-close></div>
  <section class="search-profile-card" data-profile-card>
    <button class="search-profile-mobile-handle" type="button" data-profile-toggle aria-label="Open My Search Profile">
      <span></span>
    </button>

    {% if searchProfileContext.layout != "page" %}
      <div class="search-profile-card__top">
        <div>
          <span class="search-profile-card__badge">Recommended</span>
          <h2>{{ searchProfileContext.card_headline or "Get a personalized building shortlist" }}</h2>
          <p>Tell us what you're looking for and we'll recommend buildings that fit.</p>
          <p class="search-profile-card__trust">Curated by local experts • Free • No obligation</p>
        </div>
        <button class="search-profile-icon-button" type="button" data-profile-toggle aria-label="Collapse My Search Profile">
          <span aria-hidden="true">−</span>
        </button>
      </div>

      <button class="search-profile-summary" type="button" data-profile-toggle aria-expanded="true">
        <span>
          <strong>Find buildings that fit your business</strong>
          <small data-profile-summary-title>Free • Curated by local experts</small>
        </span>
        <span class="search-profile-summary__action" aria-hidden="true">Start Search</span>
        <span class="search-profile-summary__icon" data-profile-expand-icon aria-hidden="true">+</span>
      </button>
    {% endif %}

    <div class="search-profile-card__body" data-profile-body>
      <div class="search-profile-step-meter" data-profile-editor>
        <span data-profile-step-count>1 / 5</span>
      </div>

      <div class="search-profile-progress" aria-label="Search profile progress" data-profile-editor>
        <span data-profile-progress-bar></span>
      </div>

      <div class="search-profile-preview" data-profile-preview data-profile-editor>
        <span data-profile-preview-empty>No profile yet</span>
        <ul data-profile-preview-list hidden></ul>
      </div>

      <form class="search-profile-form" data-profile-form data-profile-editor>
        <fieldset class="search-profile-fieldset" data-profile-step="targetArea">
          {% if searchProfileContext.space_type_context_label %}
            <p class="search-profile-fieldset__context">{{ searchProfileContext.space_type_context_label }}</p>
          {% endif %}
          <legend>Location</legend>
          <div class="search-profile-options search-profile-options--multi search-profile-location-options" data-profile-location-options></div>
          <div class="search-profile-other" data-profile-location-other hidden>
            <label for="search-profile-target-area">Other location</label>
            <input id="search-profile-target-area" name="targetArea" type="text" placeholder="City, district, or street" data-profile-location-other-input>
          </div>
        </fieldset>

        <fieldset class="search-profile-fieldset" data-profile-step="spaceType" hidden>
          <legend>Space Type</legend>
          <div class="search-profile-options" data-profile-options="spaceType">
            <button type="button" data-profile-value="Office">Office</button>
            <button type="button" data-profile-value="Industrial / Warehouse">Industrial</button>
            <button type="button" data-profile-value="Retail">Retail</button>
            <button type="button" data-profile-value="Medical">Medical</button>
            <button type="button" data-profile-value="Flex">Flex</button>
            <button type="button" data-profile-value="Coworking">Coworking</button>
          </div>
        </fieldset>

        <fieldset class="search-profile-fieldset" data-profile-step="people" hidden>
          <legend>How many people are you planning for?</legend>
          <div class="search-profile-options" data-profile-options="people"></div>
        </fieldset>

        <fieldset class="search-profile-fieldset" data-profile-step="use" hidden>
          <legend>Use</legend>
          <div class="search-profile-options" data-profile-options="use"></div>
        </fieldset>

        <fieldset class="search-profile-fieldset" data-profile-step="size" hidden>
          <legend>Size</legend>
          <div class="search-profile-options" data-profile-options="size"></div>
        </fieldset>

        <fieldset class="search-profile-fieldset" data-profile-step="timing" hidden>
          <legend>When would you like to move?</legend>
          <div class="search-profile-options" data-profile-options="timing"></div>
        </fieldset>

        <fieldset class="search-profile-fieldset" data-profile-step="workspaceStyle" hidden>
          <legend>Workspace Style</legend>
          <div class="search-profile-options" data-profile-options="workspaceStyle"></div>
        </fieldset>

        <fieldset class="search-profile-fieldset" data-profile-step="important" hidden>
          <legend>Important</legend>
          <div class="search-profile-options search-profile-options--multi" data-profile-options="important"></div>
        </fieldset>

        <fieldset class="search-profile-fieldset" data-profile-step="features" hidden>
          <legend>What features are important to your business?</legend>
          <p class="search-profile-fieldset__helper">Select anything important.</p>
          <div class="search-profile-options search-profile-options--multi" data-profile-options="features"></div>
          <div class="search-profile-other" data-profile-feature-other hidden>
            <label for="search-profile-feature-other">Anything else to consider?</label>
            <input id="search-profile-feature-other" name="featureOther" type="text" data-profile-input="featureOther">
          </div>
        </fieldset>
        <p class="search-profile-step-error" data-profile-step-error hidden>Select a space type, size, and location to find matching buildings.</p>
      </form>

      <div class="search-profile-actions" data-profile-editor>
        <button class="btn-secondary" type="button" data-profile-prev>Previous</button>
        <button class="btn-primary" type="button" data-profile-next>Next</button>
        <button class="search-profile-reset" type="button" data-profile-reset>Reset</button>
      </div>

      <section class="search-profile-contact-step" data-profile-contact hidden>
        <div>
          <h3>Your building shortlist is almost ready.</h3>
        </div>

        <ul class="search-profile-contact-step__reminder" data-profile-contact-reminder></ul>

        <div class="search-profile-contact-step__fields">
          <p class="search-profile-contact-step__field-heading">Where should we send your shortlist?</p>

          <label class="search-profile-contact-step__field" for="search-profile-contact-name">
            <span>Name</span>
            <input id="search-profile-contact-name" name="profileContactName" type="text" autocomplete="name" data-profile-contact-input="name">
          </label>

          <label class="search-profile-contact-step__field" for="search-profile-contact-email">
            <span>Email</span>
            <input id="search-profile-contact-email" name="profileContactEmail" type="email" autocomplete="email" data-profile-contact-input="email">
          </label>

          <label class="search-profile-contact-step__field search-profile-contact-step__field--optional" for="search-profile-contact-phone">
            <span>Phone <em>Optional — only if you'd like a call.</em></span>
            <input id="search-profile-contact-phone" name="profileContactPhone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(415) 555-1234" data-profile-contact-input="phone">
          </label>
          <p class="search-profile-contact-step__error" data-profile-contact-phone-error hidden>Enter a 10-digit phone number or leave it blank.</p>
          <p class="search-profile-contact-step__error" data-profile-contact-submit-error hidden>We could not send your profile. Please try again.</p>
        </div>

        <details class="search-profile-contact-step__note-toggle">
          <summary>+ Anything else we should know? <span>(optional)</span></summary>
          <label for="search-profile-extra-note">Additional requirements</label>
          <textarea id="search-profile-extra-note" name="featureOther" rows="3" placeholder="Loading dock, lab space, parking, budget, move timing, sublease, or other requirements" data-profile-input="featureOther"></textarea>
        </details>

        <p class="search-profile-contact-step__note">No spam • No obligation</p>

        <div class="search-profile-contact-step__actions">
          <button class="btn-primary" type="button" data-profile-contact-submit>Get My Personalized Shortlist</button>
          <button class="search-profile-edit-link" type="button" data-profile-edit>Edit profile</button>
        </div>
      </section>

      <section class="search-profile-finished" data-profile-finished hidden>
        <div class="search-profile-finished__intro">
          <h3>Your building shortlist request has been sent.</h3>
          <p>We'll use this profile to prepare matching buildings and nearby alternatives.</p>
        </div>

        <div>
          <ul class="search-profile-finished__list" data-profile-final-list></ul>
        </div>

        <div class="search-profile-finished__actions">
          <button class="btn-secondary" type="button" data-profile-edit>Edit profile</button>
        </div>
      </section>
    </div>
  </section>
</aside>
