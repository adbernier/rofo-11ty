{% set promptContext = recommendationPromptContext or searchProfileContext or {} %}
{% set promptSource = promptContext.context_type or "page" %}
{% set promptCity = promptContext.city or "" %}
{% set promptState = promptContext.state or promptContext.state_abbr or "" %}
{% set promptMarketId = promptContext.market_id or "" %}
{% set promptJourney = promptContext.journey or "" %}
{% set promptDistrict = promptContext.neighborhood_name or promptContext.district or "" %}
{% set promptDistrictId = promptContext.neighborhood_slug or promptContext.district_id or "" %}
{% set promptLabel = promptContext.context_label or promptDistrict or promptCity or "" %}
{% set promptSpaceType = promptContext.default_space_type or "" %}
{% set promptBusinessIdentity = promptContext.business_identity or promptContext.business_archetype or "" %}
{% set promptIntelligenceState = promptContext.intelligence_state or "" %}
{% set promptSourcePath = page.url or promptContext.page_url or "" %}
{% set promptComparisonA = "" %}
{% set promptComparisonB = "" %}
{% if promptContext.location_suggestions and promptContext.location_suggestions.length %}
  {% set promptComparisonA = promptContext.location_suggestions[0] or "" %}
  {% set promptComparisonB = promptContext.location_suggestions[1] or "" %}
{% endif %}
{% set promptIsIndustrial = (promptSpaceType | lower).includes("industrial") or (promptLabel | lower).includes("industrial") or (promptDistrict | lower).includes("industrial") %}

{% set promptSpaceTypeNormalized = promptSpaceType | lower %}
{% set promptHasSupportedSfType = not promptSpaceType or promptSpaceTypeNormalized.includes("office") or promptSpaceTypeNormalized.includes("retail") or promptSpaceTypeNormalized.includes("service") or promptSpaceTypeNormalized.includes("industrial") or promptSpaceTypeNormalized.includes("warehouse") or promptSpaceTypeNormalized.includes("flex") %}
{% set promptHasDistrictIntelligence = promptCity == "San Francisco" and promptHasSupportedSfType %}
{% if promptSource == "business_brief" and promptCity and promptBusinessIdentity %}
  {% set promptHeadline = "Find " + promptCity + " office locations that fit " + promptBusinessIdentity %}
  {% set promptBody = "Rofo already understands the business context. Tell us a little about your team and location priorities, and we'll compare " + promptCity + " commercial districts to identify strong fits and tradeoffs." %}
{% elseif promptSource == "district" and promptDistrict and promptHasDistrictIntelligence %}
  {% set promptHeadline = "Is " + promptDistrict + " right for your business?" %}
  {% set promptBody = "Rofo compares " + promptDistrict + " with other " + promptCity + " areas based on your business, team, commute needs, and priorities." %}
{% elseif (promptSource == "city" or promptSource == "market_guide") and promptCity and promptHasDistrictIntelligence %}
  {% set promptHeadline = "Find the " + promptCity + " locations that fit your business" %}
  {% set promptBody = "Not sure where to look? Rofo compares your business, workforce, customers and location priorities against our intelligence on " + promptCity + " commercial districts to identify areas worth considering—and explain the tradeoffs." %}
{% elseif promptSource == "comparison" %}
  {% set promptHeadline = "Which location is the better fit for your business?" %}
  {% if promptComparisonA and promptComparisonB %}
    {% set promptBody = "Compare " + promptComparisonA + ", " + promptComparisonB + ", and nearby alternatives based on your business." %}
  {% else %}
    {% set promptBody = "Compare these locations and nearby alternatives based on your business." %}
  {% endif %}
{% elseif promptSource == "space_type" and promptHasDistrictIntelligence %}
  {% set promptTypeLabel = (promptSpaceType or "office") | lower %}
  {% set promptHeadline = "Find the right " + promptCity + " " + promptTypeLabel + " location" %}
  {% set promptBody = "Rofo compares your business, employee and customer geography, and location priorities across " + promptCity + " " + promptTypeLabel + " areas to identify places worth considering—and explain why." %}
{% else %}
  {% set promptHeadline = "Find commercial locations that fit your business" %}
  {% set promptBody = "Tell Rofo what you're looking for and we'll help organize the location and property requirements that matter for your search." %}
{% endif %}

{% set promptParams = [] %}
{% if promptCity %}{% set promptParams = (promptParams.push("city=" + (promptCity | queryEncode)), promptParams) %}{% endif %}
{% if promptState %}{% set promptParams = (promptParams.push("state=" + (promptState | queryEncode)), promptParams) %}{% endif %}
{% if promptSource == "district" and promptDistrict %}
  {% set promptParams = (promptParams.push("district=" + (promptDistrict | queryEncode)), promptParams) %}
{% elseif promptSource != "comparison" and promptLabel and not promptCity %}
  {% set promptParams = (promptParams.push("location=" + (promptLabel | queryEncode)), promptParams) %}
{% endif %}
{% if promptSource == "comparison" and promptComparisonA %}
  {% set promptParams = (promptParams.push("locationA=" + (promptComparisonA | queryEncode)), promptParams) %}
{% endif %}
{% if promptSource == "comparison" and promptComparisonB %}
  {% set promptParams = (promptParams.push("locationB=" + (promptComparisonB | queryEncode)), promptParams) %}
{% endif %}
{% if promptSpaceType %}{% set promptParams = (promptParams.push("spaceType=" + (promptSpaceType | queryEncode)), promptParams) %}{% endif %}
{% if promptBusinessIdentity %}{% set promptParams = (promptParams.push("businessArchetype=" + (promptBusinessIdentity | queryEncode)), promptParams) %}{% endif %}
{% if promptSource %}{% set promptParams = (promptParams.push("source=" + (promptSource | queryEncode)), promptParams) %}{% endif %}
{% if promptSourcePath %}{% set promptParams = (promptParams.push("sourcePath=" + (promptSourcePath | queryEncode)), promptParams) %}{% endif %}
{% if promptMarketId %}{% set promptParams = (promptParams.push("marketId=" + (promptMarketId | queryEncode)), promptParams) %}{% elseif promptCity == "San Francisco" %}{% set promptParams = (promptParams.push("marketId=san-francisco"), promptParams) %}{% endif %}
{% if promptDistrictId %}{% set promptParams = (promptParams.push("districtId=" + (promptDistrictId | queryEncode)), promptParams) %}{% endif %}
{% if promptJourney %}{% set promptParams = (promptParams.push("journey=" + (promptJourney | queryEncode)), promptParams) %}{% endif %}
{% set promptBase = "/best-fit-locations/" %}
{% set promptHref = promptBase + ("?" + (promptParams | join("&")) if promptParams.length else "") %}

<section
  class="recommendation-prompt-card"
  data-recommendation-prompt
  data-prompt-source="{{ promptSource }}"
  data-prompt-city="{{ promptCity }}"
  data-prompt-district="{{ promptDistrict }}"
  data-prompt-space-type="{{ promptSpaceType }}"
  data-prompt-source-path="{{ promptSourcePath }}"
  data-prompt-intelligence-state="{{ promptIntelligenceState }}"
  aria-label="Get location recommendations"
>
  <div class="recommendation-prompt-card__content">
    <div class="recommendation-prompt-card__badge">Location intelligence</div>
    <h2>{{ promptHeadline }}</h2>
    <p>{{ promptBody }}</p>
    <p class="recommendation-prompt-card__microcopy">About 60 seconds.</p>
  </div>
  <div class="recommendation-prompt-card__actions">
    <a class="recommendation-prompt-card__button" href="{{ promptHref }}" data-recommendation-prompt-click>
      See My Best-Fit Locations <span aria-hidden="true">→</span>
    </a>
    <a class="recommendation-prompt-card__example" href="/how-rofo-works/">How Rofo works <span aria-hidden="true">→</span></a>
  </div>
</section>

<script>
  (() => {
    const endpoint = "/api/analytics/search-profile";
    const prompts = document.querySelectorAll("[data-recommendation-prompt]:not([data-prompt-bound])");
    if (!prompts.length) return;

    function send(eventName, card) {
      const payload = {
        event_name: eventName,
        profile_version: "recommendation_prompt_v1",
        context: {
          page_type: card.dataset.promptSource || "",
          page_url: card.dataset.promptSourcePath || window.location.pathname,
          city: card.dataset.promptCity || "",
          district: card.dataset.promptDistrict || "",
          location_display: card.dataset.promptDistrict || card.dataset.promptCity || "",
          space_type: card.dataset.promptSpaceType || "",
          intelligence_state: card.dataset.promptIntelligenceState || "",
          device_type: window.matchMedia && window.matchMedia("(max-width: 767px)").matches ? "mobile" : "desktop",
        },
        profile: {
          profile_version: "recommendation_prompt_v1",
          space_type: card.dataset.promptSpaceType || "",
          intelligence_state: card.dataset.promptIntelligenceState || "",
        },
        attribution: {
          referrer: document.referrer || "",
          landing_page: window.location.href,
          entry_page_type: card.dataset.promptSource || "",
        },
      };

      try {
        const body = JSON.stringify(payload);
        if (navigator.sendBeacon) {
          const blob = new Blob([body], { type: "application/json" });
          if (navigator.sendBeacon(endpoint, blob)) return;
        }
        fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body,
          credentials: "same-origin",
          keepalive: true,
        }).catch(() => {});
      } catch (error) {}
    }

    prompts.forEach((card) => {
      card.dataset.promptBound = "true";
      send("recommendation_prompt_viewed", card);
      card.querySelectorAll("[data-recommendation-prompt-click]").forEach((link) => {
        link.addEventListener("click", () => send("recommendation_prompt_clicked", card), { once: true });
      });
    });
  })();
</script>
