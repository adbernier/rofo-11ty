{% set mobilePromptContext = searchProfileContext or {} %}
{% if not mobilePromptContext.context_type %}
  {% if neighborhood %}
    {% set mobilePromptContext = {
      "context_type": "district",
      "city": neighborhood.city,
      "state": neighborhood.state_abbr,
      "district": neighborhood.name,
      "neighborhood_name": neighborhood.name,
      "neighborhood_slug": neighborhood.slug,
      "default_space_type": neighborhood.public_decision_surface.defaultSpaceType or ""
    } %}
  {% elseif comparison %}
    {% set mobilePromptContext = {
      "context_type": "comparison",
      "city": comparison.city,
      "state": comparison.state_abbr,
      "location_suggestions": [comparison.district_a_name, comparison.district_b_name]
    } %}
  {% elseif guide %}
    {% set mobilePromptContext = {
      "context_type": "market_guide",
      "city": guide.city,
      "state": guide.state_abbr,
      "default_space_type": guideSearchProfileSpaceType or ""
    } %}
  {% elseif entry %}
    {% set mobilePromptContext = {
      "context_type": "space_type",
      "city": entry.city.city,
      "state": entry.city.state_abbr,
      "default_space_type": searchProfileDefaultSpaceType or entry.spaceType.label
    } %}
  {% elseif city and city.city %}
    {% set mobilePromptContext = {
      "context_type": "city",
      "city": city.city,
      "state": city.state_abbr
    } %}
  {% endif %}
{% endif %}
{% set mobilePromptSource = mobilePromptContext.context_type or "page" %}
{% set mobilePromptCity = mobilePromptContext.city or "" %}
{% set mobilePromptState = mobilePromptContext.state or mobilePromptContext.state_abbr or "" %}
{% set mobilePromptDistrict = mobilePromptContext.neighborhood_name or mobilePromptContext.district or "" %}
{% set mobilePromptDistrictId = mobilePromptContext.neighborhood_slug or mobilePromptContext.district_id or "" %}
{% set mobilePromptSpaceType = mobilePromptContext.default_space_type or "" %}
{% set mobilePromptSourcePath = page.url or mobilePromptContext.page_url or "" %}
{% set mobilePromptLocationA = "" %}
{% set mobilePromptLocationB = "" %}
{% if mobilePromptContext.location_suggestions and mobilePromptContext.location_suggestions.length %}
  {% set mobilePromptLocationA = mobilePromptContext.location_suggestions[0] or "" %}
  {% set mobilePromptLocationB = mobilePromptContext.location_suggestions[1] or "" %}
{% endif %}
{% set mobileParams = [] %}
{% if mobilePromptCity %}{% set mobileParams = (mobileParams.push("city=" + (mobilePromptCity | queryEncode)), mobileParams) %}{% endif %}
{% if mobilePromptState %}{% set mobileParams = (mobileParams.push("state=" + (mobilePromptState | queryEncode)), mobileParams) %}{% endif %}
{% if mobilePromptDistrict and mobilePromptSource == "district" %}{% set mobileParams = (mobileParams.push("district=" + (mobilePromptDistrict | queryEncode)), mobileParams) %}{% endif %}
{% if mobilePromptLocationA and mobilePromptSource == "comparison" %}{% set mobileParams = (mobileParams.push("locationA=" + (mobilePromptLocationA | queryEncode)), mobileParams) %}{% endif %}
{% if mobilePromptLocationB and mobilePromptSource == "comparison" %}{% set mobileParams = (mobileParams.push("locationB=" + (mobilePromptLocationB | queryEncode)), mobileParams) %}{% endif %}
{% if mobilePromptSpaceType %}{% set mobileParams = (mobileParams.push("spaceType=" + (mobilePromptSpaceType | queryEncode)), mobileParams) %}{% endif %}
{% if mobilePromptSource %}{% set mobileParams = (mobileParams.push("source=" + (mobilePromptSource | queryEncode)), mobileParams) %}{% endif %}
{% if mobilePromptSourcePath %}{% set mobileParams = (mobileParams.push("sourcePath=" + (mobilePromptSourcePath | queryEncode)), mobileParams) %}{% endif %}
{% set mobileSpaceTypeNormalized = mobilePromptSpaceType | lower %}
{% set mobileHasSupportedSfType = not mobilePromptSpaceType or mobileSpaceTypeNormalized.includes("office") or mobileSpaceTypeNormalized.includes("retail") or mobileSpaceTypeNormalized.includes("service") or mobileSpaceTypeNormalized.includes("industrial") or mobileSpaceTypeNormalized.includes("warehouse") or mobileSpaceTypeNormalized.includes("flex") %}
{% set mobileUsesVnext = mobilePromptCity == "San Francisco" and mobileHasSupportedSfType %}
{% if mobileUsesVnext %}
  {% set mobileParams = (mobileParams.push("marketId=san-francisco"), mobileParams) %}
  {% if mobilePromptDistrictId %}{% set mobileParams = (mobileParams.push("districtId=" + (mobilePromptDistrictId | queryEncode)), mobileParams) %}{% endif %}
  {% set mobileParams = (mobileParams.push("journey=new"), mobileParams) %}
{% endif %}
{% set mobilePromptBase = "/location-requirement/" if mobileUsesVnext else "/find-locations/" %}
{% set mobilePromptHref = mobilePromptBase + ("?" + (mobileParams | join("&")) if mobileParams.length else "") %}

<section class="search-profile-mobile-entry" aria-label="Create your Business Profile">
  <div>
    <h2>Create your Business Profile</h2>
    <p>Get a location recommendation before you search for space.</p>
  </div>
  <a class="btn-primary" href="{{ mobilePromptHref }}">See My Best-Fit Locations</a>
</section>
