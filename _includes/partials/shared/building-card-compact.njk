{% set placeholderSrc = building | buildingPlaceholder %}
{% set buildingPath = building.building_path %}
{% set isNeighborhoodBuildingCard = building_card_variant == "neighborhood" %}
{% set buildingTitle = building.address or building.display_name or building.name %}
{% set buildingDisplayTitle = building.short_display_name if isNeighborhoodBuildingCard and building.short_display_name else buildingTitle %}
{% set buildingMetaType = building.editorial_type_label if isNeighborhoodBuildingCard and building.editorial_type_label else building.type %}
{% set buildingMetaDetail = building.editorial_descriptor if isNeighborhoodBuildingCard and building.editorial_descriptor else building.size_label %}

<article class="building-card-compact{% if isNeighborhoodBuildingCard %} building-card-compact--neighborhood{% endif %}">

  <div class="building-card-compact__media">
    <a
      href="{{ buildingPath }}"
      aria-label="View {{ buildingTitle }}"
    >
      <img
        class="building-card-compact__image"
        src="{{ building.hero_image or placeholderSrc }}"
        alt="{{ buildingTitle }}"
        loading="lazy"
        decoding="async"
      />
    </a>

    <div class="building-card-compact__overlay">
      <h3 class="building-card-compact__title">
        <a href="{{ buildingPath }}">
          {{ buildingDisplayTitle }}
        </a>
      </h3>

      {% if buildingMetaType or buildingMetaDetail %}
        <p class="building-card-compact__meta">
          {% if buildingMetaType %}{{ buildingMetaType }}{% endif %}
          {% if buildingMetaType and buildingMetaDetail %} · {% endif %}
          {% if buildingMetaDetail %}{{ buildingMetaDetail }}{% endif %}
        </p>
      {% endif %}

      {% if building.featured_company_name and building.featured_company_slug %}
  <p class="building-presented-by">
    Presented by
    <a href="/commercial-real-estate/company/{{ building.featured_company_slug }}/">
      {{ building.featured_company_name }}
    </a>
  </p>
{% endif %}
    </div>
  </div>

</article>
