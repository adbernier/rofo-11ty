{% set facts = buildingBrief.quickFacts or buildingBrief.snapshot or [] %}
{% if facts and facts.length %}
  <section class="building-brief-section building-brief-section--facts">
    <div class="building-brief-section__header">
      <div class="eyebrow">Quick facts</div>
      <h2>Building Snapshot</h2>
    </div>
    <div class="building-brief-snapshot">
      {% for item in facts %}
        {% if item.value %}
          {% set displayLabel = item.label
            | replace("Representative role", "Business use")
            | replace("Primary ecosystem", "Environment")
            | replace("Source-supported ", "")
            | replace("Loading context", "Loading")
            | replace("Clear-height context", "Clear height")
            | replace("Parking context", "Parking")
            | replace("Access context", "Access")
            | replace("Zoning context", "Use rules")
            | replace("Systems context", "Building systems")
            | replace("Office context", "Office")
            | replace("Yard context", "Yard")
            | replace("Customer presence", "Customer access")
            | replace("Operating context", "Operating use")
          %}
          {% set displayValue = item.value
            | buildingProfileText
          %}
          <div class="building-brief-snapshot__item">
            <dt><span class="building-snapshot-icon" aria-hidden="true"></span>{{ displayLabel }}</dt>
            <dd>{{ displayValue }}</dd>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}
