{% set advantages = buildingBrief.advantages or [] %}
{% set tradeoffs = buildingBrief.tradeoffs or [] %}
{% if (advantages and advantages.length) or (tradeoffs and tradeoffs.length) %}
  <section class="building-brief-section">
    <div class="building-brief-section__header">
      <div class="eyebrow">Decision</div>
      <h2>Location Advantages and Things to Consider</h2>
    </div>
    <div class="building-decision-grid">
      {% if advantages and advantages.length %}
        <div class="building-decision-panel">
          <h3>Location advantages</h3>
          <ul class="mini-list">
            {% for item in advantages %}
              <li>{{ item | buildingProfileText }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if tradeoffs and tradeoffs.length %}
        <div class="building-decision-panel">
          <h3>Things to consider</h3>
          <ul class="mini-list">
            {% for item in tradeoffs %}
              <li>{{ item | buildingProfileText }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}
