{% set operationalProfile = buildingBrief.operationalProfile or [] %}
{% set environmentExplanation = buildingBrief.environmentExplanation %}
{% set representativeCompanies = buildingBrief.representativeCompanies or [] %}
{% if (operationalProfile and operationalProfile.length) or environmentExplanation or buildingBrief.buildingExperience or (representativeCompanies and representativeCompanies.length) %}
  <section class="building-brief-section building-brief-section--characteristics">
    <div class="building-brief-section__header">
      <div class="eyebrow">Characteristics</div>
      <h2>Location & Building Characteristics</h2>
    </div>

    {% if environmentExplanation %}
      <div class="building-operational-explainer">
        {% if environmentExplanation.whyItExists %}
          <p>{{ environmentExplanation.whyItExists | buildingProfileText }}</p>
        {% endif %}
        {% if environmentExplanation.whyChooseThisEnvironment %}
          <p>{{ environmentExplanation.whyChooseThisEnvironment | buildingProfileText }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if buildingBrief.buildingExperience %}
      <p class="building-characteristics-lead">{{ buildingBrief.buildingExperience | buildingProfileText }}</p>
    {% endif %}

    {% if operationalProfile and operationalProfile.length %}
      <div class="building-operational-grid">
        {% for item in operationalProfile %}
          <div class="building-operational-card">
            <h3>{{ item.label }}</h3>
            <p>{{ item.summary | buildingProfileText }}</p>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if representativeCompanies and representativeCompanies.length %}
      <div class="building-characteristics-businesses">
        <h3>Business types this helps explain</h3>
        <ul class="mini-list">
          {% for item in representativeCompanies %}
            <li>{{ item | buildingProfileText }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </section>
{% endif %}
