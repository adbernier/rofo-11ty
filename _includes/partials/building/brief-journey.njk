<div class="building-brief-journey">
  {% set buildingImportance = buildingBrief.buildingImportance or buildingBrief.rofoTake %}
  {% if buildingImportance %}
    <section class="building-brief-section building-brief-section--take building-profile-intro">
      <div class="eyebrow">Building Profile</div>
      <h2>{{ buildingBriefName }} as an example of {{ buildingBriefArea.name if buildingBriefArea else building.city }}</h2>
      <p class="building-profile-explainer">
        This profile uses {{ buildingBriefName }} to explain the type of commercial environment businesses commonly evaluate in {% if buildingBriefArea %}{{ buildingBriefArea.name }}{% else %}{{ building.city }}{% endif %}. It is intended to help compare location fit, not advertise current availability.
      </p>
      <p class="building-brief-take">{{ buildingImportance | buildingProfileText }}</p>
    </section>
  {% endif %}

  {% include "partials/building/brief-facts.njk" %}
  {% include "partials/building/brief-fit.njk" %}
  {% include "partials/building/brief-operational-profile.njk" %}

  {% include "partials/building/brief-district-context.njk" %}
  {% include "partials/building/brief-decision.njk" %}
  {% include "partials/building/brief-alternatives.njk" %}

  {% if buildingBrief.validationNotes and buildingBrief.validationNotes.length %}
    <section class="building-brief-section">
      <div class="building-brief-section__header">
        <div class="eyebrow">Verify</div>
        <h2>What to Verify</h2>
        <p>Use these questions when touring space, speaking with a broker, or comparing proposals.</p>
      </div>
      <ul class="building-question-list">
        {% for item in buildingBrief.validationNotes %}
          <li>{{ item | buildingProfileText }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% include "partials/building/brief-related-insights.njk" %}
  {% include "partials/building/brief-status-note.njk" %}

  {% set productTransitionVariant = "building" %}
  {% set productTransitionCtaUrl = "/find-locations/?city=" + (building.city | urlencode) + "&state=" + building.state_abbr %}
  {% include "partials/building/product-transition-card.njk" %}
  {% set productTransitionVariant = "" %}
  {% set productTransitionCtaUrl = "" %}
</div>
