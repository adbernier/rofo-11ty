---
layout: base.njk
pagination:
  data: rofoInsights
  size: 1
  alias: insight
permalink: "/insights/{{ insight.slug }}/index.html"
eleventyComputed:
  title: "{{ insight.title }} | Rofo Insight"
  description: "{{ insight.summary }}"
  canonical: "{{ metadata.siteUrl }}/insights/{{ insight.slug }}/"
---

<main class="rofo-insight-page">
  <div class="rofo-insight-shell">
    {% set relatedInsightItems = [] %}
    {% if insight.relatedInsights and insight.relatedInsights.length %}
      {% for relatedSlug in insight.relatedInsights %}
        {% for candidate in rofoInsights %}
          {% if candidate.published and candidate.slug == relatedSlug %}
            {% set relatedInsightItems = (relatedInsightItems.push(candidate), relatedInsightItems) %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endif %}

    <nav class="rofo-insight-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Rofo</a>
      <span>/</span>
      <span>Rofo Insight</span>
    </nav>

    <header class="rofo-insight-hero">
      <div class="rofo-insight-eyebrow"><span aria-hidden="true">&#128161;</span> Rofo Insight</div>
      <h1>{{ insight.title }}</h1>
      <div class="rofo-insight-meta">
        <span>{{ insight.readingTime or insight.readTime or "3 minute read" }}</span>
        {% if insight.primaryMarket %}
          <span>{{ insight.primaryMarket }}</span>
        {% endif %}
        {% if insight.category %}
          <span>{{ insight.category }}</span>
        {% endif %}
        {% if insight.spaceTypes and insight.spaceTypes.length %}
          <span>{{ insight.spaceTypes[0] | capitalize }}</span>
        {% endif %}
      </div>
      <p>{{ insight.heroSummary or insight.summary }}</p>
    </header>

    <article class="rofo-insight-document">
      <section class="rofo-insight-section rofo-insight-section--summary">
        <h2>Executive summary</h2>
        <p>{{ insight.summary }}</p>
      </section>

      <section class="rofo-insight-section">
        <h2>Why this matters</h2>
        <p>{{ insight.whyThisMatters }}</p>
      </section>

      <section class="rofo-insight-section">
        <h2>What businesses often overlook</h2>
        <p>{{ insight.commonAssumption }}</p>
      </section>

      <section class="rofo-insight-section">
        <h2>What Rofo has learned</h2>
        <ul class="rofo-insight-observations">
          {% for observation in insight.whatRofoHasLearned %}
            <li>{{ observation }}</li>
          {% endfor %}
        </ul>
      </section>

      <section class="rofo-insight-section">
        <h2>When this location is the better fit</h2>
        <p>{{ insight.betterFit }}</p>
      </section>

      <section class="rofo-insight-section">
        <h2>When another district may be stronger</h2>
        <p>{{ insight.anotherDistrictMayBeStronger }}</p>
      </section>

      {% if insight.relatedComparisons and insight.relatedComparisons.length %}
        <section class="rofo-insight-section">
          <h2>Related Comparisons</h2>
          <div class="rofo-insight-link-grid">
            {% for comparison in insight.relatedComparisons %}
              <a href="{{ comparison.url }}">{{ comparison.label }}</a>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if insight.relatedCityPage %}
        <section class="rofo-insight-section">
          <h2>Related City</h2>
          <div class="rofo-insight-link-grid">
            <a href="{{ insight.relatedCityPage }}">{{ insight.primaryMarket }} commercial real estate</a>
            <a href="{{ insight.relatedCityPage }}insights/">{{ insight.primaryMarket }} Insights</a>
          </div>
        </section>
      {% endif %}

      {% if insight.relatedDistrictPages and insight.relatedDistrictPages.length %}
        <section class="rofo-insight-section">
          <h2>Related Districts</h2>
          <div class="rofo-insight-link-grid">
            {% for districtPath in insight.relatedDistrictPages %}
              <a href="{{ districtPath }}">
                {{ insight.relatedDistricts[loop.index0] or districtPath }}
              </a>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if insight.relatedBuildings and insight.relatedBuildings.length %}
        <section class="rofo-insight-section">
          <h2>Representative Buildings</h2>
          <p>Representative buildings help translate the district strategy into real commercial environments. They are examples for context, not claims of current availability.</p>
          <div class="rofo-insight-link-grid rofo-insight-link-grid--buildings">
            {% for building in insight.relatedBuildings %}
              <a href="{{ building.url }}">
                <span>{{ building.label }}</span>
                {% if building.district %}<em>{{ building.district }}</em>{% endif %}
              </a>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if relatedInsightItems.length %}
        <section class="rofo-insight-section">
          <h2>Related Rofo Insights</h2>
          <div class="rofo-related-insight-grid">
            {% for relatedInsight in relatedInsightItems.slice(0, 4) %}
              <a class="rofo-related-insight-card" href="/insights/{{ relatedInsight.slug }}/">
                <span>{{ relatedInsight.readingTime or relatedInsight.readTime or "3 minute read" }}</span>
                <strong>{{ relatedInsight.title }}</strong>
                <em>{{ relatedInsight.summary }}</em>
              </a>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      <section class="rofo-insight-section rofo-insight-continue">
        <div class="rofo-insight-eyebrow">Continue Exploring San Francisco</div>
        <h2>Keep building the location picture.</h2>
        <p>Use the related districts, comparisons, buildings, and Location Brief flow to move from commercial reasoning to a market-specific recommendation.</p>
        <div class="rofo-insight-continue__grid">
          {% if insight.relatedDistrictPages and insight.relatedDistrictPages.length %}
            <a href="{{ insight.relatedDistrictPages[0] }}">Explore {{ insight.relatedDistricts[0] or "a related district" }}</a>
          {% endif %}
          {% if insight.relatedComparisons and insight.relatedComparisons.length %}
            <a href="{{ insight.relatedComparisons[0].url }}">Compare {{ insight.relatedComparisons[0].label }}</a>
          {% endif %}
          {% if relatedInsightItems.length %}
            <a href="/insights/{{ relatedInsightItems[0].slug }}/">Read {{ relatedInsightItems[0].title }}</a>
          {% endif %}
          {% if insight.relatedBuildings and insight.relatedBuildings.length %}
            <a href="{{ insight.relatedBuildings[0].url }}">View representative buildings</a>
          {% endif %}
          <a href="{{ insight.relatedLocationBrief or '/find-locations/' }}">Generate a Location Brief</a>
        </div>
      </section>
    </article>

    <section class="rofo-insight-cta" aria-labelledby="rofo-insight-cta-heading">
      <div>
        <div class="rofo-insight-eyebrow">Still deciding?</div>
        <h2 id="rofo-insight-cta-heading">Generate a personalized Location Brief.</h2>
        <p>Rofo compares markets against your business priorities and shows where the search should start.</p>
      </div>
      <a class="btn-primary" href="{{ insight.relatedLocationBrief or '/find-locations/' }}">Find My Best Locations</a>
    </section>
  </div>
</main>
