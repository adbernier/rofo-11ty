---
layout: base.njk
permalink: /location-requirement/
eleventyExcludeFromCollections: true
robots: noindex,nofollow
title: "Build Your Location Search | Rofo"
description: "Tell Rofo what matters to your business and see San Francisco office locations worth considering."
---
<link rel="stylesheet" href="/assets/requirement-prototype.css">
<main class="requirement-prototype" data-requirement-prototype data-requirement-experience="public">
  <script type="application/json" data-requirement-markets>{{ commercialGeography.markets | dump | safe }}</script>
  <script type="application/json" data-requirement-districts>{{ requirementPrototypeDistrictGeography | dump | safe }}</script>
  <script type="application/json" data-sf-office-recommendation-model>{{ sfOfficeRecommendationModel | dump | safe }}</script>
  <script type="application/json" data-sf-access-foundation>{{ sfAccessFoundationV0 | dump | safe }}</script>
  <script type="application/json" data-sf-office-composition-foundation>{{ sfOfficeCompositionFoundation | dump | safe }}</script>
  <header class="requirement-prototype__header"><div><p class="requirement-prototype__eyebrow">Location search</p><h1>Find locations that fit your business.</h1><p>Answer a few questions and see the locations that best fit your business.</p></div></header>
  <section class="requirement-bootstrap" data-requirement-loading aria-live="polite">Preparing your location search…</section>
  <section class="requirement-interview" data-interview aria-live="polite" hidden>
    <div class="requirement-interview__orientation"><span data-stage-label>Location search</span><span data-question-position></span></div>
    <div class="requirement-interview__progress" aria-label="Location search progress"><span data-progress-bar></span></div>
    <div class="requirement-interview__layout">
      <div class="requirement-question" data-question-card><p class="requirement-prototype__eyebrow" data-question-kicker>Location search</p><h2 data-question-prompt></h2><p class="requirement-question__help requirement-question__help--visible" data-question-visible-help hidden></p><div class="requirement-answer" data-answer-control></div><details class="requirement-question__why" data-question-help hidden><summary>Why this matters</summary><p></p></details><p class="requirement-question__error" data-question-error hidden></p><div class="requirement-question__actions"><button class="requirement-button requirement-button--previous" type="button" data-back-question><span aria-hidden="true">←</span> Previous</button><button class="requirement-button requirement-button--primary" type="button" data-continue-question disabled>Continue</button></div></div>
      <aside class="requirement-search-summary" aria-label="Your search"><h2>Your search</h2><p data-search-summary-empty>Rofo will keep track of what it learns here.</p><div data-search-summary></div></aside>
    </div>
  </section>
  <section class="requirement-complete" data-requirement-complete hidden><header><p class="requirement-prototype__eyebrow">Your search</p><h2 data-requirement-title>Location search</h2><p>Rofo has enough context to recommend locations. You can still change any answer.</p></header><div class="requirement-readiness-summary" data-readiness-summary></div><div class="requirement-summary-grid" data-requirement-summary></div><div class="requirement-complete__actions"><button class="requirement-button requirement-button--primary" type="button" data-view-recommendations>Show recommended locations</button><button type="button" data-refine-requirement>Change my answers</button></div></section>
  <section class="requirement-preview" data-recommendation-preview hidden><h2 data-preview-heading></h2><p data-preview-intro></p><div data-preview-results></div><div data-candidate-comparisons></div><button type="button" data-back-to-requirement>Edit my search</button></section>
  <section hidden aria-hidden="true"><div data-preview-coverage></div><div data-access-shadow></div><div data-composition-debug></div><div data-debug-meta></div><div data-requirement-criteria></div><pre data-debug-json></pre></section>
</main>
<script src="/js/recommendations/normalize-sf-office-profile.js" defer></script><script src="/js/recommendations/sf-office-recommendation-resolver.js" defer></script><script src="/js/requirements/requirement-to-sf-office-recommendation.js" defer></script><script src="/js/requirements/requirement-location-intelligence-preview.js" defer></script><script src="/js/access/access-intelligence-schema.js" defer></script><script src="/js/access/requirement-access-profile.js" defer></script><script src="/js/access/access-fit-evaluator.js" defer></script><script src="/js/access/access-shadow-evaluator.js" defer></script><script src="/js/recommendations/private-location-composition.js" defer></script><script src="/js/recommendations/private-recommendation-readiness.js" defer></script><script type="module" src="/js/requirement-prototype.js"></script>
