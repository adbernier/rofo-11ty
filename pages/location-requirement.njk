---
layout: base.njk
permalink: /location-requirement/
eleventyExcludeFromCollections: true
robots: noindex,nofollow
title: "Build Your Location Search | Rofo"
description: "Tell Rofo what matters to your business and see San Francisco office locations worth considering."
---
<link rel="stylesheet" href="/assets/requirement-prototype.css">
<main class="requirement-prototype" data-requirement-prototype data-requirement-experience="public">
  <script type="application/json" data-requirement-markets>{{ commercialGeography.markets | dump | safe }}</script>
  <script type="application/json" data-requirement-districts>{{ requirementPrototypeDistrictGeography | dump | safe }}</script>
  <script type="application/json" data-sf-office-recommendation-model>{{ sfOfficeRecommendationModel | dump | safe }}</script>
  <script type="application/json" data-sf-access-foundation>{{ sfAccessFoundationV0 | dump | safe }}</script>
  <script type="application/json" data-sf-office-composition-foundation>{{ sfOfficeCompositionFoundation | dump | safe }}</script>
  <header class="requirement-prototype__header"><div><p class="requirement-prototype__eyebrow">Location search</p><h1>Find locations that fit your business.</h1><p>Answer a short sequence of practical questions. Rofo will show useful alternatives and their tradeoffs.</p></div></header>
  <nav class="requirement-prototype__scenarios" aria-label="Test scenarios" hidden><div data-scenario-buttons></div></nav>
  <section class="requirement-understanding" data-understanding hidden><div data-understanding-summary></div></section>
  <section class="requirement-interview" data-interview aria-live="polite">
    <div class="requirement-interview__orientation"><span data-stage-label>Starting the search</span><span data-question-position></span></div>
    <div class="requirement-question" data-question-card><p class="requirement-prototype__eyebrow" data-question-kicker>Location search</p><h2 data-question-prompt></h2><p class="requirement-question__help requirement-question__help--visible" data-question-visible-help hidden></p><div class="requirement-answer" data-answer-control></div><details class="requirement-question__why" data-question-help hidden><summary>Why this matters</summary><p></p></details><p class="requirement-question__error" data-question-error hidden></p><div class="requirement-question__actions"><button type="button" data-back-question>Back</button><button class="requirement-button requirement-button--primary" type="button" data-continue-question disabled>Continue</button><button type="button" data-finish-early>Review what we know</button></div></div>
  </section>
  <section class="requirement-complete" data-requirement-complete hidden><header><p class="requirement-prototype__eyebrow">Your search</p><h2 data-requirement-title>Location search</h2><p>Rofo has enough context to recommend locations. You can still change any answer.</p></header><div class="requirement-readiness-summary" data-readiness-summary></div><div class="requirement-summary-grid" data-requirement-summary></div><div class="requirement-complete__actions"><button class="requirement-button requirement-button--primary" type="button" data-view-recommendations>Show recommended locations</button><button type="button" data-refine-requirement>Change my answers</button><button type="button" data-export-requirement hidden>Export JSON</button></div></section>
  <section class="requirement-preview" data-recommendation-preview hidden><h2 data-preview-heading></h2><p data-preview-intro></p><div data-preview-results></div><div data-candidate-comparisons></div><button type="button" data-back-to-requirement>Edit my search</button></section>
  <button type="button" data-toggle-understanding hidden>What Rofo understands</button><button type="button" data-reset-requirement hidden>Reset</button>
  <section hidden aria-hidden="true"><div data-preview-coverage></div><div data-access-shadow></div><div data-composition-debug></div><div data-debug-meta></div><div data-requirement-criteria></div><pre data-debug-json></pre></section>
</main>
