---
layout: base.njk
pagination:
  data: marketGuides
  size: 1
  alias: guide
permalink: "{{ guide.output_path }}"
eleventyComputed:
  title: "{{ guide.title }} | Rofo"
  description: "{{ guide.meta_description }}"
  canonical: "{{ metadata.siteUrl }}{{ guide.url }}"
---

{% set crumbs = [
  { "label": "Markets", "url": "/markets/" },
  { "label": guide.city + ", " + guide.state_abbr, "url": guide.city_url },
  { "label": guide.title, "url": guide.url }
] %}
{% set siteUrl = metadata.siteUrl or "https://www.rofo.com" %}
{% set guideAbsoluteUrl = siteUrl + guide.url %}
{% set marketSnapshot = guide.market_snapshot or {} %}
{% set snapshotTitle = marketSnapshot.snapshot_title or "Market Snapshot" %}
{% set guideSnapshotItems = [] %}
{% if marketSnapshot.average_rent %}
  {% set guideSnapshotItems = (guideSnapshotItems.push({ "label": "Average Rent", "value": marketSnapshot.average_rent, "note": marketSnapshot.average_rent_label, "direction": marketSnapshot.average_rent_direction }), guideSnapshotItems) %}
{% endif %}
{% if marketSnapshot.availability_rate %}
  {% set guideSnapshotItems = (guideSnapshotItems.push({ "label": "Availability", "value": marketSnapshot.availability_rate, "note": marketSnapshot.availability_label, "direction": marketSnapshot.availability_direction }), guideSnapshotItems) %}
{% endif %}
{% if marketSnapshot.market_trend %}
  {% set guideSnapshotItems = (guideSnapshotItems.push({ "label": "Market Trend", "value": marketSnapshot.market_trend, "note": marketSnapshot.market_trend_label, "direction": marketSnapshot.market_trend_direction }), guideSnapshotItems) %}
{% endif %}
{% if marketSnapshot.notable_areas and marketSnapshot.notable_areas.length %}
  {% set guideSnapshotItems = (guideSnapshotItems.push({ "label": "Notable Areas", "areas": marketSnapshot.notable_areas, "note": marketSnapshot.notable_areas_label }), guideSnapshotItems) %}
{% endif %}
{% set guideSearchProfileLocationSuggestions = [] %}
{% if guide.nearby_markets and guide.nearby_markets.length %}
  {% for nearby in guide.nearby_markets.slice(0, 6) %}
    {% set guideSearchProfileLocationSuggestions = (guideSearchProfileLocationSuggestions.push(nearby.city), guideSearchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}
{% set guideSearchProfileSpaceType = "" %}
{% if guide.guide_kind == "space-type" %}
  {% if guide.space_type == "industrial-space" or guide.space_type == "warehouse-space" %}
    {% set guideSearchProfileSpaceType = "Industrial / Warehouse" %}
  {% elseif guide.space_type == "retail-space" %}
    {% set guideSearchProfileSpaceType = "Retail" %}
  {% elseif guide.space_type == "flex-space" %}
    {% set guideSearchProfileSpaceType = "Flex" %}
  {% elseif guide.space_type == "coworking-space" %}
    {% set guideSearchProfileSpaceType = "Coworking" %}
  {% else %}
    {% set guideSearchProfileSpaceType = "Office" %}
  {% endif %}
{% endif %}
{% set guideSearchProfileHeadline = "Get a personalized " + guide.city + " building shortlist" %}
{% set guideSearchProfileSpaceContextLabel = "" %}
{% if guide.guide_kind == "space-type" %}
  {% set guideSearchProfileHeadlineType = (guide.space_type_label_lower or guide.space_type_label or "") | replace(" space", "") %}
  {% set guideSearchProfileHeadline = "Get a personalized " + guide.city + " " + guideSearchProfileHeadlineType + " shortlist" %}
  {% set guideSearchProfileSpaceContextLabel = "Searching for: " + guide.space_type_label %}
{% endif %}
{% set searchProfileContext = {
  "layout": "inline",
  "submit_enabled": true,
  "submit_endpoint": "/api/leads/submit",
  "target_area": guide.city,
  "city": guide.city,
  "district": "",
  "street": "",
  "state": guide.state_abbr,
  "context_type": "market_guide",
  "context_label": guide.title,
  "page_url": metadata.siteUrl + page.url,
  "page_title": title,
  "routing_market": guide.routing_market or (guide.city_slug + "-" + (guide.state_abbr | lower)),
  "routing_county": guide.county or "",
  "neighborhood_name": "",
  "neighborhood_slug": "",
  "neighborhood_path": "",
  "commercial_area_id": "",
  "commercial_area_type": "market_guide",
  "location_suggestions": guideSearchProfileLocationSuggestions,
  "default_space_type": guideSearchProfileSpaceType,
  "space_type_context_label": guideSearchProfileSpaceContextLabel,
  "card_headline": guideSearchProfileHeadline
} %}

<section class="city-page market-page market-page--guide">
  <div class="city-shell">
    {% include "partials/breadcrumbs.njk" %}

    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ guide.title | dump | safe }},
  "description": {{ guide.meta_description | dump | safe }},
  "url": {{ guideAbsoluteUrl | dump | safe }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ guideAbsoluteUrl | dump | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": "Rofo",
    "url": {{ siteUrl | dump | safe }}
  },
  "about": [
    {{ guide.city | dump | safe }},
    {% if guide.guide_kind == "space-type" %}
    {{ guide.space_type_label | dump | safe }},
    {% endif %}
    "Commercial real estate market guide"
  ],
  "spatialCoverage": {
    "@type": "Place",
    "name": {{ (guide.city + ", " + guide.state_abbr) | dump | safe }}
  },
  "temporalCoverage": {{ guide.market_date | dump | safe }}{% if guide.sources and guide.sources.length %},
  "citation": [
    {% for source in guide.sources %}
    {
      "@type": "CreativeWork",
      "name": {{ source.name | dump | safe }},
      "url": {{ source.url | dump | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]{% endif %}
}
    </script>

    <div class="market-guide-layout">
      <div class="market-guide-main">
        <div class="city-hero market-guide-hero-layout market-guide-hero-layout--content-only">
          <div class="city-card">
            <div class="city-hero-copy">
              <div class="eyebrow">Market Guide</div>
              <h1>{{ guide.title }}</h1>
              <p class="lead">{{ guide.summary_short or guide.summary }}</p>
              <div class="pill-row">
                <span class="pill">{{ guide.city }}, {{ guide.state_abbr }}</span>
                {% if guide.market_date %}
                  <span class="pill">{{ guide.market_date }}</span>
                {% endif %}
                {% if guide.guide_kind == "space-type" %}
                  <span class="pill">{{ guide.space_type_label }}</span>
                {% endif %}
              </div>
              <div class="button-row">
                <a class="btn-primary" href="#search-profile">Get a personalized shortlist</a>
                <a class="btn-secondary" href="{{ guide.city_url }}">Explore {{ guide.city }}</a>
                {% if guide.guide_kind == "space-type" %}
                  <a class="btn-secondary" href="{{ guide.city_market_guide_url }}">Read the {{ guide.city }} market guide</a>
                {% endif %}
              </div>
              {% include "partials/shared/search-profile-mobile-entry.njk" %}
            </div>
          </div>
        </div>

        <div class="page-stack">
      <div class="city-card city-card--full">
        <div class="eyebrow">Quick Facts</div>
        <h2>{{ guide.city }} market quick facts</h2>
        <div class="guide-grid">
          <div class="guide-mini-card">
            <div class="stat-label">City</div>
            <div class="stat-value">{{ guide.city }}</div>
            <p class="stat-note">{{ guide.state_abbr }}</p>
          </div>
          <div class="guide-mini-card">
            <div class="stat-label">County</div>
            <div class="stat-value">{{ guide.county or "Available by market" }}</div>
            <p class="stat-note">Regional market context</p>
          </div>
          {% if guide.population_label %}
            <div class="guide-mini-card">
              <div class="stat-label">Population</div>
              <div class="stat-value">{{ guide.population_label }}</div>
              <p class="stat-note">
                {% if guide.data_source_label %}
                  {{ guide.data_source_label }}{% if guide.data_source_year %}, {{ guide.data_source_year }}{% endif %}
                {% else %}
                  City population context
                {% endif %}
              </p>
            </div>
          {% endif %}
          {% if guide.representative_building_count %}
            <div class="guide-mini-card">
              <div class="stat-label">Buildings</div>
              <div class="stat-value">{{ guide.representative_building_count }}</div>
              <p class="stat-note">Example buildings in Rofo data</p>
            </div>
          {% endif %}
          {% if guide.available_space_types and guide.available_space_types.length %}
            <div class="guide-mini-card">
              <div class="stat-label">Common Space Types</div>
              <div class="stat-value">{{ guide.available_space_types.length }}</div>
              <p class="stat-note">
                {% for type in guide.available_space_types %}
                  {{ type.label }}{% if not loop.last %}, {% endif %}
                {% endfor %}
              </p>
            </div>
          {% endif %}
          {% if guide.nearby_markets and guide.nearby_markets.length %}
            <div class="guide-mini-card">
              <div class="stat-label">Nearby Markets</div>
              <div class="stat-value">{{ guide.nearby_markets.length }}</div>
              <p class="stat-note">
                {% for nearby in guide.nearby_markets %}
                  {% if loop.index <= 3 %}{{ nearby.city }}{% if not loop.last and loop.index < 3 %}, {% endif %}{% endif %}
                {% endfor %}
              </p>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="city-card city-card--full">
        <div class="eyebrow">Market Overview</div>
        <h2>Commercial real estate in {{ guide.city }}</h2>
        <p>{{ guide.market_overview }}</p>
      </div>

      {% if guide.guide_kind == "city" and guideSnapshotItems.length >= 2 %}
        <div class="city-card city-card--full">
          <div class="eyebrow">{{ snapshotTitle }}</div>
          <h2>{{ guide.city }} {{ snapshotTitle }}</h2>
          {% if marketSnapshot.summary %}
            <p>{{ marketSnapshot.summary }}</p>
          {% endif %}
          <div class="guide-grid">
            {% for item in guideSnapshotItems %}
              <div class="guide-mini-card">
                <div class="stat-label">{{ item.label }}</div>
                {% if item.areas and item.areas.length %}
                  <div class="stat-value stat-value--list">
                    {% for area in item.areas %}
                      <span>{{ area }}</span>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="stat-value">
                    {{ item.value }}
                    {% if item.direction == "up" %}
                      <span class="stat-direction" aria-label="Up">↑</span>
                    {% elseif item.direction == "down" %}
                      <span class="stat-direction" aria-label="Down">↓</span>
                    {% elseif item.direction == "flat" %}
                      <span class="stat-direction" aria-label="Flat">→</span>
                    {% endif %}
                  </div>
                {% endif %}
                {% if item.note %}
                  <p class="stat-note">{{ item.note }}</p>
                {% endif %}
              </div>
            {% endfor %}
          </div>
          {% if marketSnapshot.rent_note or marketSnapshot.availability_note or marketSnapshot.tenant_takeaway %}
            <div class="guide-list">
              {% if marketSnapshot.rent_note %}
                <p>{{ marketSnapshot.rent_note }}</p>
              {% endif %}
              {% if marketSnapshot.availability_note %}
                <p>{{ marketSnapshot.availability_note }}</p>
              {% endif %}
              {% if marketSnapshot.tenant_takeaway %}
                <p>{{ marketSnapshot.tenant_takeaway }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% elseif guide.guide_kind == "space-type" and (guide.average_rent or guide.market_date) %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Market Snapshot</div>
          <h2>{{ guide.city }}{% if guide.guide_kind == "space-type" %} {{ guide.space_type_label_lower }}{% endif %} market snapshot</h2>
          <div class="guide-grid">
            {% if guide.average_rent %}
              <div class="guide-mini-card">
                <div class="stat-label">Average Rent</div>
                <div class="stat-value">{{ guide.average_rent }}</div>
                {% if guide.rent_basis %}<p class="stat-note">{{ guide.rent_basis }}</p>{% endif %}
              </div>
            {% endif %}
            {% if guide.market_date %}
              <div class="guide-mini-card">
                <div class="stat-label">Market Date</div>
                <div class="stat-value">{{ guide.market_date }}</div>
                <p class="stat-note">Snapshot for current market context</p>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if guide.trends and guide.trends.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Current Trends</div>
          <h2>What tenants are seeing now</h2>
          <ul class="guide-list">
            {% for trend in guide.trends %}
              <li>{{ trend }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if guide.available_space_types and guide.available_space_types.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Space Types</div>
          <h2>Commercial space types in {{ guide.city }}</h2>
          <div class="guide-grid">
            {% for type in guide.available_space_types %}
              <div class="guide-mini-card">
                <h3>{{ type.label }} in {{ guide.city }}</h3>
                <p>{{ type.use_case }}</p>
                <a class="building-link" href="{{ type.url }}">View {{ type.label_lower }} in {{ guide.city }}</a>
                {% if type.guide_url and type.guide_url != guide.url %}
                  <a class="building-link" href="{{ type.guide_url }}">Read the {{ type.label_lower }} guide</a>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if guide.best_for and guide.best_for.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Best Fit</div>
          <h2>Who this market is best for</h2>
          <ul class="guide-list">
            {% for item in guide.best_for %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if guide.neighborhoods and guide.neighborhoods.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Neighborhood Breakdown</div>
          <h2>Where to compare {{ guide.space_type_label_lower }} options</h2>
          <div class="guide-grid">
            {% for neighborhood in guide.neighborhoods %}
              <div class="guide-mini-card">
                <h3>{{ neighborhood.name }}</h3>
                <p>{{ neighborhood.summary }}</p>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if guide.neighborhood_strategy and guide.neighborhood_strategy.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Neighborhood Strategy</div>
          <h2>How to compare areas in {{ guide.city }}</h2>
          <div class="guide-grid">
            {% for item in guide.neighborhood_strategy %}
              <div class="guide-mini-card">
                <h3>{{ item.label }}</h3>
                <p><strong>Consider:</strong> {{ item.areas }}</p>
                <p>{{ item.summary }}</p>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if guide.nearby_market_guides and guide.nearby_market_guides.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Nearby Markets</div>
          <h2>{% if guide.guide_kind == "space-type" %}{% if not guide.has_inventory %}Start with nearby {{ guide.space_type_label_lower }} markets{% else %}Nearby {{ guide.space_type_label_lower }} markets to consider{% endif %}{% else %}Nearby commercial real estate guides{% endif %}</h2>
          <p>
            {% if guide.guide_kind == "space-type" and not guide.has_inventory %}
              This guide covers {{ guide.city }} market context, but nearby markets may have more active {{ guide.space_type_label_lower }} options to compare.
            {% elseif guide.guide_kind == "space-type" %}
              Compare nearby {{ guide.space_type_noun }} markets if you are flexible on location, commute, pricing, or building type.
            {% else %}
              Compare nearby market guides if you are flexible on location, commute, space type, or building fit.
            {% endif %}
          </p>
          <div class="guide-grid">
            {% for nearbyGuide in guide.nearby_market_guides %}
              <div class="guide-mini-card">
                <h3>{{ nearbyGuide.city }}, {{ nearbyGuide.state_abbr }}</h3>
                <a class="building-link" href="{{ nearbyGuide.guide_url }}">Read the {{ nearbyGuide.city }} guide</a>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if guide.nearby_markets and guide.nearby_markets.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Nearby City Pages</div>
          <h2>Compare nearby commercial real estate markets</h2>
          <p>Nearby markets can be useful if you are flexible on location, commute, space type, or building fit.</p>
          <div class="guide-grid">
            {% for nearby in guide.nearby_markets %}
              {% if loop.index <= 6 %}
                <div class="guide-mini-card">
                  <h3>{{ nearby.city }}, {{ nearby.state_abbr }}</h3>
                  <a class="building-link" href="{{ nearby.url }}">Explore {{ nearby.city }} commercial real estate</a>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if guide.representative_buildings and guide.representative_buildings.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Example Buildings</div>
          <h2>Example buildings in {{ guide.city }}</h2>
          <div class="building-grid">
            {% for building in guide.representative_buildings %}
              {% include "partials/shared/building-card-compact.njk" %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <div class="city-card city-card--full">
        <div class="eyebrow">Space Planning</div>
        <h2>What size {{ guide.space_type_label_lower }} do you need?</h2>
        <p>
          Most businesses start by estimating team size, operational needs, customer access, storage needs, and future growth. If you are unsure, compare a few size ranges before narrowing the search.
        </p>
        <ul class="guide-list">
          <li>Under 1,000 sqft can work for smaller teams, service businesses, or focused local operations.</li>
          <li>1,000-5,000 sqft often fits growing businesses that need a practical mix of work, customer, or support areas.</li>
          <li>5,000+ sqft is usually evaluated around layout, operational flow, and future expansion needs.</li>
        </ul>
      </div>

      {% if not guide.has_inventory %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Finding Space</div>
          <h2>How to find space in {{ guide.city }}</h2>
          <p>
            Some markets have useful rent and neighborhood context before Rofo has active {{ guide.space_type_label_lower }} inventory to browse. Tell us what you need and we can help identify options, compare nearby markets, or connect you with local market support.
          </p>
        </div>
      {% endif %}

      {% if guide.leasing_tips and guide.leasing_tips.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Leasing Tips</div>
          <h2>How to approach the search</h2>
          <ul class="guide-list">
            {% for tip in guide.leasing_tips %}
              <li>{{ tip }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <div class="city-card city-card--full">
        <div class="eyebrow">Next Steps</div>
        {% if guide.guide_kind == "space-type" and guide.has_inventory %}
          <h2>Compare {{ guide.space_type_label_lower }} in {{ guide.city }}</h2>
          <p>
            Use Rofo to compare current {{ guide.space_type_label_lower }} options in {{ guide.city }} or step back to the broader city market.
          </p>
          <div class="button-row">
            <a class="btn-primary" href="{{ guide.space_type_url }}">View {{ guide.space_type_label_lower }} in {{ guide.city }}</a>
            <a class="btn-secondary" href="{{ guide.city_url }}">Explore the {{ guide.city }} market</a>
          </div>
        {% else %}
          <h2>We can help you find space in this market</h2>
          <p>
            Share the type of space, size range, and timing you are considering, and Rofo can help you evaluate {{ guide.city }} or nearby {{ guide.space_type_noun }} markets.
          </p>
          <div class="button-row">
            <a class="btn-primary" href="/#contact">Get help finding space</a>
            <a class="btn-secondary" href="{{ guide.city_url }}">Explore the {{ guide.city }} market</a>
          </div>
        {% endif %}
      </div>

      <div id="market-guide-contact" class="guide-lead-section">
        <div class="guide-lead-card guide-lead-card--intro cta-band">
          <div class="kicker">GET HELP</div>
          <h2>Tell us what you need</h2>

          <p class="cta-band__lead">
            Help us understand your space, timing, and priorities—we’ll point you in the right direction.
          </p>

          <div class="cta-band__prompts">
            <div class="cta-band__prompt">
              <strong>Type of space</strong>
              <span>Office, retail, industrial, flex, or coworking</span>
            </div>

            <div class="cta-band__prompt">
              <strong>Size or team</strong>
              <span>A rough range or headcount is enough</span>
            </div>

            <div class="cta-band__prompt">
              <strong>Location</strong>
              <span>Your target area or nearby options</span>
            </div>

            <div class="cta-band__prompt">
              <strong>Timeline</strong>
              <span>Now, soon, or just exploring</span>
            </div>
          </div>

          <div class="cta-band__footer">
            You don’t need all the answers—we’ll help you figure it out.
          </div>
        </div>

        <div class="guide-lead-card guide-lead-card--form form-card">
          <div class="eyebrow">GET HELP</div>
          <h2>Find the right space for your business</h2>
          <p>Tell us what you need — we’ll follow up with a few spaces that fit.</p>

          <form action="/api/leads/submit" method="POST">
            <input type="hidden" name="source" value="rofo-market-guide">
            <input type="hidden" name="page_type" value="market-guide">
            <input type="hidden" name="city" value="{{ guide.city }}">
            <input type="hidden" name="state" value="{{ guide.state_abbr }}">
            <input type="hidden" name="market" value="{{ guide.city }}, {{ guide.state_abbr }}">
            <input type="hidden" name="page_url" value="{{ metadata.siteUrl }}{{ page.url }}">
            <input type="hidden" name="rofo_source" value="{{ metadata.siteUrl }}{{ page.url }}">
            <input type="hidden" name="routing_market" value="{{ guide.routing_market }}">
            <input type="hidden" name="routing_county" value="{{ guide.routing_county }}">
            <input type="hidden" name="routing_space_type" value="{{ guide.routing_space_type }}">
            <input type="hidden" name="routing_candidates" value="{{ guide.routing_candidates | join(',') }}">
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none">
            <input type="text" name="company_website" style="display:none;">
            <input type="hidden" name="form_start_time" value="">
            <script>
              document.currentScript.previousElementSibling.value = Date.now();
            </script>

            <div class="form-grid">
              <div class="field">
                <label for="guide-lead-name">Name</label>
                <input id="guide-lead-name" name="name" type="text" placeholder="Your name" required>
              </div>
              <div class="field">
                <label for="guide-lead-email">Email</label>
                <input id="guide-lead-email" name="email" type="email" placeholder="you@example.com" required>
              </div>
              <div class="field">
                <label for="guide-lead-phone">Phone</label>
                <input id="guide-lead-phone" name="phone" type="tel" placeholder="Your phone number" required>
              </div>
              <div class="field">
                <label for="guide-lead-location">Where are you looking?</label>
                <input id="guide-lead-location" name="location" type="text" value="{{ guide.city }}, {{ guide.state_abbr }}" placeholder="City, State" required>
              </div>
              <div class="field">
                <label for="guide-lead-space-type">What type of space do you need?</label>
                <select id="guide-lead-space-type" name="space_type" required>
                  <option value="">Select one</option>
                  <option{% if guide.space_type == "office-space" %} selected{% endif %}>Office Space</option>
                  <option{% if guide.space_type == "retail-space" %} selected{% endif %}>Retail Space</option>
                  <option{% if guide.space_type == "industrial-space" %} selected{% endif %}>Industrial Space</option>
                  <option{% if guide.space_type == "coworking-space" %} selected{% endif %}>Coworking Space</option>
                  <option{% if guide.space_type == "flex-space" %} selected{% endif %}>Flex Space</option>
                  <option>Not Sure</option>
                </select>
              </div>
              <div class="field">
                <label for="guide-lead-size">Space size</label>
                <select id="guide-lead-size" name="space_needed" required>
                  <option value="">Select one</option>
                  <option>Under 1,000 sqft</option>
                  <option>1,000–2,500 sqft</option>
                  <option>2,500–5,000 sqft</option>
                  <option>5,000–10,000 sqft</option>
                  <option>10,000+ sqft</option>
                  <option>Not Sure</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="guide-lead-notes">Other requirements for your space <span class="optional">(optional)</span></label>
              <textarea id="guide-lead-notes" name="notes" placeholder="Example: office near clients, retail storefront, warehouse space, target move date"></textarea>
            </div>

            <div class="form-actions">
              <label class="checkbox">
                <input type="checkbox" name="human_check" required>
                I’m a real person looking for space
              </label>

              <div class="form-note">
                No spam. Just helpful options to get you started.
              </div>

              <button class="btn-primary" type="submit">See Available Spaces</button>
            </div>
          </form>
        </div>
      </div>

      {% if guide.faqs and guide.faqs.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">FAQ</div>
          <h2>{{ guide.city }} commercial real estate FAQ</h2>
          <div class="guide-grid">
            {% for item in guide.faqs %}
              <div class="guide-mini-card">
                <h3>{{ item.question }}</h3>
                <p>{{ item.answer }}</p>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if guide.sources and guide.sources.length %}
        <div class="city-card city-card--full">
          <div class="eyebrow">Sources</div>
          <h2>Market data sources</h2>
          <ul class="guide-list">
            {% for source in guide.sources %}
              <li>
                <a href="{{ source.url }}" rel="nofollow noopener" target="_blank">{{ source.name }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
        </div>
      </div>

      <aside class="market-guide-search-profile">
        {% include "partials/shared/recommendation-prompt-card.njk" %}
      </aside>
    </div>
  </div>
</section>
