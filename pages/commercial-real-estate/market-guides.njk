---
layout: base.njk
permalink: /commercial-real-estate/market-guides/index.html
title: Commercial Real Estate Market Guides | Rofo
description: Explore practical office, industrial, and retail market guides with average rents, local leasing trends, neighborhood notes, and nearby markets.
---

{% set sortedGuides = marketGuides | sort(attribute="city") %}
{% set siteUrl = metadata.siteUrl or "https://www.rofo.com" %}
{% set indexUrl = siteUrl + "/commercial-real-estate/market-guides/" %}

<section class="city-page">
  <div class="city-shell">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Commercial Real Estate Market Guides",
  "description": {{ description | dump | safe }},
  "url": {{ indexUrl | dump | safe }},
  "publisher": {
    "@type": "Organization",
    "name": "Rofo",
    "url": {{ siteUrl | dump | safe }}
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {% for guide in sortedGuides %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "name": {{ guide.title | dump | safe }},
        "url": {{ (siteUrl + guide.url) | dump | safe }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
}
    </script>

    <div class="city-card city-card--full">
      <div class="eyebrow">Market Guides</div>
      <h1>Commercial Real Estate Market Guides</h1>
      <p class="lead">
        Explore practical office, industrial, and retail market guides with average rents, local leasing trends, neighborhood notes, and nearby markets.
      </p>
      <p>
        These guides are built from broker reports, local market data, and Rofo’s 20+ years helping businesses find commercial space.
      </p>
    </div>

    <div class="guide-grid">
      {% for guide in sortedGuides %}
        <article class="guide-mini-card">
          <div class="eyebrow">{{ guide.city }}, {{ guide.state_abbr }}</div>
          <h2>{{ guide.title }}</h2>
          {% if guide.summary_short %}
            <p>{{ guide.summary_short }}</p>
          {% endif %}

          <ul class="mini-list">
            <li><strong>Average rent:</strong> {{ guide.average_rent }}</li>
            <li><strong>Market date:</strong> {{ guide.market_date }}</li>
          </ul>

          <a class="btn-secondary" href="{{ guide.url }}">Read the guide</a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
