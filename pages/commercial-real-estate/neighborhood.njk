---
layout: base.njk
pagination:
  data: neighborhoodPages
  size: 1
  alias: neighborhood
permalink: "{{ neighborhood.canonical_neighborhood_path }}"
eleventyComputed:
  title: "Commercial Real Estate in {{ neighborhood.name }}, {{ neighborhood.city }}, {{ neighborhood.state_abbr }} | Rofo"
  description: "Explore commercial real estate context, buildings, and common business environments in {{ neighborhood.name }}, {{ neighborhood.city }}."
  canonical: "{{ metadata.siteUrl }}{{ neighborhood.canonical_neighborhood_path }}"
  robots: "{% if neighborhood.noindex %}noindex,follow{% endif %}"
---

{% set crumbs = [
  { "label": "Markets", "url": "/markets/" },
  { "label": neighborhood.city + ", " + neighborhood.state_abbr, "url": "/commercial-real-estate/" + neighborhood.state_abbr + "/" + neighborhood.city_slug + "/" },
  { "label": neighborhood.name, "url": neighborhood.canonical_neighborhood_path }
] %}
{% set hasSignals = neighborhood.approximate_semantic_signals and neighborhood.approximate_semantic_signals.length %}
{% set hasBuildings = neighborhood.representative_buildings and neighborhood.representative_buildings.length %}
{% set hasNearby = neighborhood.nearby_neighborhoods and neighborhood.nearby_neighborhoods.length %}
{% set hasSpaceTypes = neighborhood.approximate_space_types and neighborhood.approximate_space_types.length %}
{% set cityUrl = "/commercial-real-estate/" + neighborhood.state_abbr + "/" + neighborhood.city_slug + "/" %}
{% set cityLeadUrl = cityUrl + "?neighborhood_name=" + neighborhood.name + "&neighborhood_slug=" + neighborhood.slug + "&neighborhood_path=" + neighborhood.canonical_neighborhood_path + "&commercial_area_id=" + (neighborhood.commercial_area_id or "") + "&commercial_area_type=" + (neighborhood.commercial_area_type or "") + "#market-contact-form" %}
{% set areaTerm = neighborhood.commercial_area_type_label or "neighborhood" %}
{% set areaTermDisplay = areaTerm | capitalize %}
{% set hasMapHero = neighborhood.map_hero and not neighborhood.map_hero.suppress_map_hero %}

<section class="city-page neighborhood-public neighborhood-page-review">
  <div class="city-shell">
    {% include "partials/breadcrumbs.njk" %}

    <div class="city-hero">
      <div class="city-card">
        <div class="city-hero-copy">
          <div class="eyebrow">{{ areaTermDisplay }} Guide</div>
          <h1>Commercial Real Estate in {{ neighborhood.name }}</h1>
          <p class="lead">
            Explore commercial buildings, nearby areas, and related space types in {{ neighborhood.name }}, {{ neighborhood.city }}.
          </p>
          <div class="pill-row">
            <span class="pill">{{ neighborhood.city }}, {{ neighborhood.state_abbr }}</span>
            <span class="pill">{{ areaTermDisplay }} guide</span>
            {% if neighborhood.approximate_building_count %}
              <span class="pill">{{ neighborhood.approximate_building_count }} buildings</span>
            {% endif %}
          </div>
          <div class="button-row">
            <a class="btn-primary" href="#neighborhood-contact-form">Get help finding space</a>
            <a class="btn-secondary" href="{{ cityUrl }}market-guide/">Read market guide</a>
          </div>
        </div>
      </div>

      {% if hasMapHero %}
        {% include "partials/neighborhood/map-hero.njk" %}
      {% else %}
        <div class="city-sidecard neighborhood-review-note">
          <div class="eyebrow">{{ areaTermDisplay }} Guide</div>
          <h2>Explore {{ neighborhood.name }}</h2>
          <p>
            Use this page as a starting point for comparing {{ neighborhood.name }} with the broader {{ neighborhood.city }} commercial real estate market.
          </p>
        </div>
      {% endif %}
    </div>

    <div class="neighborhood-layout">
      <div class="neighborhood-main">
        {% if not hasMapHero %}
          <section class="city-card">
            <div class="eyebrow">Neighborhood Overview</div>
            <h2>{{ neighborhood.name }} commercial real estate</h2>
            <p>
              {{ neighborhood.name }} is part of the broader {{ neighborhood.city }} commercial real estate market.
              Use this page to compare buildings in the area, review related space types, and explore nearby commercial areas.
            </p>
          </section>
        {% endif %}

        <section class="city-card">
          <div class="eyebrow">At a Glance</div>
          <h2>{{ neighborhood.name }} at a glance</h2>
          <div class="neighborhood-card-grid neighborhood-card-grid--compact">
            <div class="neighborhood-mini-card">
              <h3>Buildings</h3>
              <p>{{ neighborhood.approximate_building_count }} selected commercial buildings</p>
            </div>
            <div class="neighborhood-mini-card">
              <h3>Space types</h3>
              <p>
                {% if hasSpaceTypes %}
                  {% for type in neighborhood.approximate_space_types %}
                    {{ type | capitalize }}{% if not loop.last %}, {% endif %}
                  {% endfor %}
                {% else %}
                  Office, retail, and other commercial space
                {% endif %}
              </p>
            </div>
            <div class="neighborhood-mini-card">
              <h3>Nearby areas</h3>
              <p>
                {% if hasNearby %}
                  {{ neighborhood.nearby_neighborhoods.length }} nearby areas
                {% else %}
                  Broader {{ neighborhood.city }} market
                {% endif %}
              </p>
            </div>
          </div>

          {% if hasSignals %}
            <div class="semantic-chip-row neighborhood-chip-row">
              {% for signal in neighborhood.approximate_semantic_signals %}
                <span class="semantic-chip">{{ signal }}</span>
              {% endfor %}
            </div>
            <p class="semantic-footnote">
              Common signals may reflect historical or contextual patterns. They do not represent live availability.
            </p>
          {% else %}
            <div class="neighborhood-context-fallback">
              <h3>Commercial context</h3>
              <p>
                Review buildings, space types, and nearby areas as you compare {{ neighborhood.name }} with the broader {{ neighborhood.city }} market.
              </p>
            </div>
          {% endif %}
        </section>

        <section class="city-card">
          <div class="eyebrow">Buildings to Explore</div>
          {% if hasBuildings %}
            <h2>Buildings in {{ neighborhood.name }}</h2>
            <p>
              Browse selected commercial buildings in {{ neighborhood.name }}.
            </p>
            <div class="building-grid neighborhood-building-grid">
              {% for b in neighborhood.representative_buildings %}
                {% set building = b %}
                {% include "partials/shared/building-card-compact.njk" %}
              {% endfor %}
            </div>
          {% else %}
            <h2>Explore opportunities in {{ neighborhood.name }}</h2>
            <p>
              Use this page as a starting point for comparing {{ neighborhood.name }} with nearby areas, related space types, and the broader {{ neighborhood.city }} market.
            </p>
            <div class="button-row">
              <a class="btn-primary" href="{{ cityLeadUrl }}">Get help exploring this area</a>
              <a class="btn-secondary" href="{{ cityUrl }}">View {{ neighborhood.city }} market</a>
            </div>
          {% endif %}
        </section>

        <section class="city-card">
          <div class="eyebrow">Related Space Types</div>
          <h2>Related space types</h2>
          <p>
            Explore commercial space types across the broader {{ neighborhood.city }} market.
          </p>
          {% if neighborhood.approximate_space_types and neighborhood.approximate_space_types.length %}
            <div class="pill-row">
              {% for type in neighborhood.approximate_space_types %}
                <a class="pill" href="{{ cityUrl }}{{ type }}-space/">{{ type | capitalize }} space</a>
              {% endfor %}
            </div>
          {% else %}
            <p>Explore office, retail, industrial, flex, and coworking options across the broader {{ neighborhood.city }} market.</p>
          {% endif %}
        </section>

        <section class="city-card">
          <div class="eyebrow">Nearby Neighborhoods</div>
          <h2>Nearby areas</h2>
          <p>
            Compare {{ neighborhood.name }} with nearby {{ neighborhood.city }} neighborhoods and commercial districts.
          </p>
          {% if hasNearby %}
            <div class="neighborhood-comparison-grid">
              {% for nearby in neighborhood.nearby_neighborhoods %}
                <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ nearby.url }}">
                  <h3>{{ nearby.name }}</h3>
                  <p>{{ nearby.city }}, {{ nearby.state_abbr }}</p>
                </a>
              {% endfor %}
            </div>
          {% else %}
            <p>Use the broader {{ neighborhood.city }} market page to compare nearby commercial areas.</p>
          {% endif %}
        </section>

        <section class="city-card">
          <div class="eyebrow">Broader Market</div>
          <h2>Compare the broader {{ neighborhood.city }} market</h2>
          <p>
            Use the broader city page and market guide to continue comparing commercial real estate options across {{ neighborhood.city }}.
          </p>
          <div class="button-row">
            <a class="btn-primary" href="{{ cityUrl }}">Explore {{ neighborhood.city }}</a>
            <a class="btn-secondary" href="{{ cityUrl }}market-guide/">Read the {{ neighborhood.city }} market guide</a>
          </div>
        </section>
      </div>

      <aside class="neighborhood-sidebar">
        {% if not hasMapHero %}
          <div class="city-card neighborhood-sticky-card">
            <div class="eyebrow">Neighborhood Context</div>
            <h2>Explore {{ neighborhood.name }}</h2>
            <p>
              Use this page as a starting point for comparing {{ neighborhood.name }} with other parts of {{ neighborhood.city }}.
            </p>
            <ul class="mini-list">
              <li>Buildings in this area</li>
              <li>Nearby {{ neighborhood.city }} areas</li>
              <li>Related commercial space types</li>
              <li>Broader {{ neighborhood.city }} market guide</li>
            </ul>
          </div>
        {% endif %}

        <div id="neighborhood-contact-form" class="city-form city-card neighborhood-lead-form">
          <div class="eyebrow">Get help finding space</div>
          <h2>Find space in {{ neighborhood.name }}</h2>
          <p>
            Tell us what you’re looking for. Rofo can help you compare {{ neighborhood.name }} with nearby areas and the broader {{ neighborhood.city }} market.
          </p>

          <form action="/api/leads/submit" method="POST" class="rofo-formspree-form">
            <input type="hidden" name="source" value="rofo-neighborhood-page">
            <input type="hidden" name="lead_type" value="neighborhood">
            <input type="hidden" name="page_type" value="neighborhood">
            <input type="hidden" name="city" value="{{ neighborhood.city }}">
            <input type="hidden" name="state" value="{{ neighborhood.state_abbr }}">
            <input type="hidden" name="market" value="{{ neighborhood.city }}, {{ neighborhood.state_abbr }}">
            <input type="hidden" name="page_url" value="{{ metadata.siteUrl }}{{ page.url }}">
            <input type="hidden" name="rofo_source" value="{{ metadata.siteUrl }}{{ page.url }}">
            <input type="hidden" name="neighborhood_name" value="{{ neighborhood.name }}">
            <input type="hidden" name="neighborhood_slug" value="{{ neighborhood.slug }}">
            <input type="hidden" name="neighborhood_path" value="{{ neighborhood.canonical_neighborhood_path }}">
            <input type="hidden" name="commercial_area_id" value="{{ neighborhood.commercial_area_id or '' }}">
            <input type="hidden" name="commercial_area_type" value="{{ neighborhood.commercial_area_type or '' }}">
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none">
            <input type="text" name="company_website" style="display:none;">
            <input type="hidden" name="form_start_time" value="">
            <script>
              document.currentScript.previousElementSibling.value = Date.now();
            </script>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-name">Name</label>
                <input id="neighborhood-lead-name" name="name" type="text" placeholder="Your name" required>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-email">Email</label>
                <input id="neighborhood-lead-email" name="email" type="email" placeholder="you@example.com" required>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-phone">Phone</label>
                <input id="neighborhood-lead-phone" name="phone" type="tel" placeholder="Your phone number" required>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-space-type">What type of space do you need?</label>
                <select id="neighborhood-lead-space-type" name="space_type" required>
                  <option value="">Select one</option>
                  <option>Office Space</option>
                  <option>Retail Space</option>
                  <option>Industrial Space</option>
                  <option>Coworking Space</option>
                  <option>Flex Space</option>
                  <option>Not Sure</option>
                </select>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-size">Space size</label>
                <select id="neighborhood-lead-size" name="space_needed" required>
                  <option value="">Select one</option>
                  <option>Under 1,000 sqft</option>
                  <option>1,000–2,500 sqft</option>
                  <option>2,500–5,000 sqft</option>
                  <option>5,000–10,000 sqft</option>
                  <option>10,000+ sqft</option>
                  <option>Not Sure</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="neighborhood-lead-notes">Other requirements for your space <span class="optional">(optional)</span></label>
              <textarea
                id="neighborhood-lead-notes"
                name="notes"
                placeholder="Example: office near transit, flexible timing, compare nearby areas"
              ></textarea>
            </div>

            <div class="btn-row">
              <label>
                <input type="checkbox" name="human_check" required>
                I’m a real person looking for space
              </label>
              <button class="btn-primary" type="submit">Get help finding space in {{ neighborhood.name }}</button>
            </div>

            <p class="form-note">✓ Compare nearby areas • ✓ Understand market context • ✓ Connect with trusted local help</p>
          </form>
        </div>
      </aside>
    </div>
  </div>
</section>
