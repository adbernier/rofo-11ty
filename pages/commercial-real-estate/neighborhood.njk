---
layout: base.njk
fieldPhotosPublic: true
pagination:
  data: neighborhoodPages
  size: 1
  alias: neighborhood
permalink: "{{ neighborhood.canonical_neighborhood_path }}"
eleventyComputed:
  title: "{{ neighborhood.name }} Commercial Real Estate | {{ neighborhood.city }}, {{ neighborhood.state_abbr }} | Rofo"
  description: "{{ neighborhood.meta_description or ('Understand why businesses consider ' + (neighborhood.meta_context_label or ((neighborhood.display_name_with_article or neighborhood.name) + ', ' + neighborhood.city)) + '. Compare tradeoffs, nearby alternatives, and representative buildings before narrowing the search.') }}"
  canonical: "{{ metadata.siteUrl }}{{ neighborhood.canonical_neighborhood_path }}"
  robots: "{% if neighborhood.noindex %}noindex,follow{% endif %}"
---

{% set crumbs = [
  { "label": "Markets", "url": "/markets/" },
  { "label": neighborhood.city + ", " + neighborhood.state_abbr, "url": "/commercial-real-estate/" + neighborhood.state_abbr + "/" + neighborhood.city_slug + "/" },
  { "label": neighborhood.name, "url": neighborhood.canonical_neighborhood_path }
] %}
{% set hasSignals = neighborhood.approximate_semantic_signals and neighborhood.approximate_semantic_signals.length %}
{% set hasBuildings = neighborhood.representative_buildings and neighborhood.representative_buildings.length %}
{% set hasRepresentativeBuildingCards = neighborhood.representative_building_cards and neighborhood.representative_building_cards.length %}
{% set hasNearby = neighborhood.nearby_neighborhoods and neighborhood.nearby_neighborhoods.length %}
{% set hasSpaceTypes = neighborhood.approximate_space_types and neighborhood.approximate_space_types.length %}
{% set cityUrl = "/commercial-real-estate/" + neighborhood.state_abbr + "/" + neighborhood.city_slug + "/" %}
{% set cityLeadUrl = cityUrl + "?neighborhood_name=" + neighborhood.name + "&neighborhood_slug=" + neighborhood.slug + "&neighborhood_path=" + neighborhood.canonical_neighborhood_path + "&commercial_area_id=" + (neighborhood.commercial_area_id or "") + "&commercial_area_type=" + (neighborhood.commercial_area_type or "") + "#market-contact-form" %}
{% set areaTerm = neighborhood.commercial_area_type_label or "neighborhood" %}
{% set areaTermDisplay = areaTerm | capitalize %}
{% set neighborhoodDisplayNameWithArticle = neighborhood.display_name_with_article or neighborhood.name %}
{% set neighborhoodDisplayNameSentence = neighborhood.display_name_with_article_sentence or neighborhood.name %}
{% set hasIdentityLocatorMap = neighborhood.district_locator_map and neighborhood.district_locator_map.promote_to_identity %}
{% set districtIdentity = neighborhood.district_identity %}
{% set hasDedicatedCommercialDistricts = neighborhood.public_commercial_districts and neighborhood.public_commercial_districts.districts and neighborhood.public_commercial_districts.districts.length %}
{% set isDistrictIdentityPage = districtIdentity or hasIdentityLocatorMap or hasDedicatedCommercialDistricts %}
{% set hasMapHero = neighborhood.map_hero and not neighborhood.map_hero.suppress_map_hero and (((neighborhood.map_hero.map_system == "v2" or neighborhood.map_hero.map_system == "v3") and neighborhood.map_hero.center_point and neighborhood.map_hero.label_position) or (neighborhood.map_hero.approximate_polygon and neighborhood.map_hero.label_position)) %}
{% set approvedEditorialSignal = neighborhood.approved_editorial_signal %}
{% set isAtlantaEditorialPilot = approvedEditorialSignal and neighborhood.city == "Atlanta" and neighborhood.state_abbr == "GA" %}
{% set editorialDistrictMap = editorialDistrictMaps.byDistrictPath[neighborhood.canonical_neighborhood_path] %}
{% set searchProfileLocationSuggestions = [] %}
{% if neighborhood.commercial_location_model and neighborhood.commercial_location_model.compare_with and neighborhood.commercial_location_model.compare_with.length %}
  {% for comparison in neighborhood.commercial_location_model.compare_with.slice(0, 6) %}
    {% set searchProfileLocationSuggestions = (searchProfileLocationSuggestions.push(comparison.district_name), searchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}
{% if hasNearby %}
  {% for nearby in neighborhood.nearby_neighborhoods.slice(0, 6) %}
    {% set searchProfileLocationSuggestions = (searchProfileLocationSuggestions.push(nearby.name), searchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}
{% set neighborhoodSearchProfileTargetArea = neighborhood.city %}
{% if neighborhoodDisplayNameWithArticle and neighborhoodDisplayNameWithArticle != neighborhood.city %}
  {% set neighborhoodSearchProfileTargetArea = neighborhood.city + " — " + neighborhoodDisplayNameWithArticle %}
{% endif %}
{% set neighborhoodInsights = [] %}
{% set neighborhoodPrimaryInsights = [] %}
{% set districtBuildingComparisons = [] %}
{% for insight in rofoInsights %}
  {% if insight.published and insight.relatedDistrictPages and insight.relatedDistrictPages.length %}
    {% for districtPath in insight.relatedDistrictPages %}
      {% if districtPath == neighborhood.canonical_neighborhood_path %}
        {% if loop.index0 == 0 %}
          {% set neighborhoodPrimaryInsights = (neighborhoodPrimaryInsights.push(insight), neighborhoodPrimaryInsights) %}
        {% else %}
          {% set neighborhoodInsights = (neighborhoodInsights.push(insight), neighborhoodInsights) %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}
{% for comparison in commercialBuildingComparisons.comparisons %}
  {% if comparison.buildingA.district.path == neighborhood.canonical_neighborhood_path or comparison.buildingB.district.path == neighborhood.canonical_neighborhood_path %}
    {% set districtBuildingComparisons = (districtBuildingComparisons.push(comparison), districtBuildingComparisons) %}
  {% endif %}
{% endfor %}

<section class="city-page neighborhood-public neighborhood-page-review">
  <div class="city-shell">
    {% set compactBreadcrumbs = true %}
    {% include "partials/breadcrumbs.njk" %}

    <div class="neighborhood-layout neighborhood-layout--primary-rail">
      <div class="neighborhood-main">
        <div class="city-hero{% if hasMapHero and not editorialDistrictMap %} city-hero--map-card{% endif %}{% if hasIdentityLocatorMap and not editorialDistrictMap %} city-hero--district-identity{% endif %}{% if editorialDistrictMap %} city-hero--editorial-district-map{% endif %}">
          <div class="city-card city-hero__intro-card">
            <div class="city-hero-copy">
              <div class="eyebrow">{{ districtIdentity.eyebrow or (areaTermDisplay + " Guide") }}</div>
              <h1>{{ districtIdentity.title or ("Commercial Real Estate in " + neighborhood.name) }}</h1>
              <p class="lead">
                {{ districtIdentity.lead or ("Explore commercial buildings, nearby areas, and related space types in " + neighborhoodDisplayNameWithArticle + ", " + neighborhood.city + ".") }}
              </p>
              <div class="pill-row">
                <span class="pill">{{ neighborhood.city }}, {{ neighborhood.state_abbr }}</span>
                <span class="pill">{{ districtIdentity.guide_label or (areaTermDisplay + " guide") }}</span>
              </div>
              <div class="button-row">
                {% if not neighborhood.commercial_location_model %}
                  <a class="btn-primary" href="#neighborhood-contact-form">Get current availability</a>
                {% endif %}
                <a class="btn-secondary" href="{{ cityUrl }}market-guide/">Read market guide</a>
              </div>
              {% if isDistrictIdentityPage or neighborhood.commercial_location_model %}
                {% include "partials/shared/search-profile-mobile-entry.njk" %}
              {% endif %}
            </div>
          </div>

          {% if editorialDistrictMap %}
            {% set editorialDistrictMapVariant = "hero" %}
            {% include "partials/shared/editorial-district-map.njk" %}
            {% set editorialDistrictMapVariant = "" %}
            {% set hasGlanceBestFit = neighborhood.commercial_location_model and neighborhood.commercial_location_model.best_fit_businesses and neighborhood.commercial_location_model.best_fit_businesses.length %}
            {% set hasGlanceNearby = (neighborhood.commercial_location_model and neighborhood.commercial_location_model.compare_with and neighborhood.commercial_location_model.compare_with.length) or hasNearby %}
            {% set hasGlanceTypicalSearch = (neighborhood.commercial_location_model and neighborhood.commercial_location_model.primary_archetype_label) or hasSpaceTypes %}
            {% if hasGlanceBestFit or hasGlanceNearby or hasGlanceTypicalSearch %}
              <section class="city-card neighborhood-hero-glance">
                <div class="eyebrow">At a glance</div>
                <div class="neighborhood-hero-glance__rows">
                  {% if hasGlanceBestFit %}
                    <div class="neighborhood-hero-glance__row">
                      <span>Best fit</span>
                      <strong>{{ neighborhood.commercial_location_model.best_fit_businesses[0] }}</strong>
                    </div>
                  {% endif %}
                  {% if hasGlanceNearby %}
                    <div class="neighborhood-hero-glance__row">
                      <span>Nearby areas</span>
                      <strong>
                        {% if neighborhood.commercial_location_model and neighborhood.commercial_location_model.compare_with and neighborhood.commercial_location_model.compare_with.length %}
                          {% for comparison in neighborhood.commercial_location_model.compare_with.slice(0, 3) %}
                            {{ comparison.district_name }}{% if not loop.last %}, {% endif %}
                          {% endfor %}
                        {% else %}
                          {% for nearby in neighborhood.nearby_neighborhoods.slice(0, 3) %}
                            {{ nearby.name }}{% if not loop.last %}, {% endif %}
                          {% endfor %}
                        {% endif %}
                      </strong>
                    </div>
                  {% endif %}
                  {% if hasGlanceTypicalSearch %}
                    <div class="neighborhood-hero-glance__row">
                      <span>Typical search</span>
                      <strong>
                        {% if neighborhood.commercial_location_model and neighborhood.commercial_location_model.primary_archetype_label %}
                          {{ neighborhood.commercial_location_model.primary_archetype_label }}
                        {% else %}
                          {% for type in neighborhood.approximate_space_types.slice(0, 3) %}
                            {{ type | capitalize }}{% if not loop.last %}, {% endif %}
                          {% endfor %}
                        {% endif %}
                      </strong>
                    </div>
                  {% endif %}
                </div>
              </section>
            {% endif %}
          {% elif hasMapHero %}
            {% include "partials/neighborhood/map-hero.njk" %}
          {% elif not hasIdentityLocatorMap %}
            <div class="city-sidecard neighborhood-review-note">
              <div class="eyebrow">{{ areaTermDisplay }} Guide</div>
              <h2>Explore {{ neighborhoodDisplayNameWithArticle }}</h2>
              <p>
                Use this page as a starting point for comparing {{ neighborhoodDisplayNameWithArticle }} with the broader {{ neighborhood.city }} commercial real estate market.
              </p>
            </div>
          {% endif %}
        </div>

        {% set fieldPhotoSubjectType = "district" %}
        {% set fieldPhotoSubjectId = neighborhood.commercial_area_id or ((neighborhood.state_abbr | lower) + "-" + neighborhood.city_slug + "-" + neighborhood.slug) %}
        {% set fieldPhotoPlacement = "district" %}
        {% include "partials/shared/editorial-photo-slot.njk" %}

        {% if hasIdentityLocatorMap and not editorialDistrictMap %}
          {% include "partials/neighborhood/district-locator-map.njk" %}
        {% endif %}

        {% if neighborhood.neighborhood_image_path %}
          <figure class="neighborhood-image-block">
            <img
              src="{{ neighborhood.neighborhood_image_path }}"
              alt="{{ neighborhood.name }} commercial streetscape in {{ neighborhood.city }}, {{ neighborhood.state_abbr }}"
              width="1600"
              height="900"
              loading="lazy"
            >
          </figure>
        {% endif %}

        {% if not hasIdentityLocatorMap and not editorialDistrictMap %}
          {% include "partials/neighborhood/district-locator-map.njk" %}
        {% endif %}

        {% if not hasMapHero and not isDistrictIdentityPage %}
          <section class="city-card">
            <div class="eyebrow">Neighborhood Overview</div>
            <h2>Commercial real estate in {{ neighborhoodDisplayNameWithArticle }}</h2>
            <p>
              {{ neighborhoodDisplayNameSentence }} is part of the broader {{ neighborhood.city }} commercial real estate market.
              Use this page to compare buildings in the area, review related space types, and explore nearby commercial areas.
            </p>
          </section>
        {% endif %}

        {% set featuredInsight = neighborhoodPrimaryInsights[0] or neighborhoodInsights[0] %}
        {% set insightList = neighborhoodPrimaryInsights.concat(neighborhoodInsights) %}
        {% set insightModuleTitle = "Insights about " + neighborhood.name %}
        {% set insightModuleSummary = "Commercial observations from Rofo about how businesses compare " + neighborhood.name + " with nearby San Francisco districts." %}
        {% set insightHubUrl = "/commercial-real-estate/CA/san-francisco/insights/" if neighborhood.city == "San Francisco" and neighborhood.state_abbr == "CA" else cityUrl + "insights/" %}
        {% include "partials/shared/rofo-insight-card.njk" %}
        {% set insightList = "" %}
        {% set insightModuleTitle = "" %}
        {% set insightModuleSummary = "" %}
        {% set insightHubUrl = "" %}

        {% if neighborhood.public_decision_surface %}
          {% include "partials/neighborhood/public-decision-surface.njk" %}
        {% elseif neighborhood.neighborhood_intelligence %}
          {% include "partials/neighborhood/intelligence.njk" %}
        {% else %}
          <section class="city-card">
            <div class="eyebrow">At a Glance</div>
            <h2>{{ neighborhoodDisplayNameSentence }} at a glance</h2>
            <div class="neighborhood-card-grid neighborhood-card-grid--compact">
              <div class="neighborhood-mini-card">
                <h3>Representative setting</h3>
                <p>{% if neighborhood.foundation_without_buildings %}District-level operating context; property capability requires separate validation{% else %}Selected examples of the local commercial environment{% endif %}</p>
              </div>
              <div class="neighborhood-mini-card">
                <h3>Space types</h3>
                <p>
                  {% if hasSpaceTypes %}
                    {% for type in neighborhood.approximate_space_types %}
                      {{ type | capitalize }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                  {% else %}
                    Office, retail, and other commercial space
                  {% endif %}
                </p>
              </div>
              <div class="neighborhood-mini-card">
                <h3>Nearby areas</h3>
                <p>
                  {% if hasNearby %}
                    Nearby commercial alternatives
                  {% else %}
                    Broader {{ neighborhood.city }} market
                  {% endif %}
                </p>
              </div>
            </div>

            {% if hasSignals %}
              <div class="semantic-chip-row neighborhood-chip-row">
                {% for signal in neighborhood.approximate_semantic_signals %}
                  <span class="semantic-chip">{{ signal }}</span>
                {% endfor %}
              </div>
              <p class="semantic-footnote">
                Common signals may reflect historical or contextual patterns. They do not represent live availability.
              </p>
            {% else %}
              <div class="neighborhood-context-fallback">
                <h3>Commercial context</h3>
                <p>
                  Review buildings, space types, and nearby areas as you compare {{ neighborhoodDisplayNameWithArticle }} with the broader {{ neighborhood.city }} market.
                </p>
              </div>
            {% endif %}
          </section>
        {% endif %}

        {% include "partials/neighborhood/location-decision.njk" %}

        {% include "partials/neighborhood/commercial-market-evidence.njk" %}

        {% include "partials/neighborhood/curated-district-media.njk" %}

        {% if approvedEditorialSignal and not isAtlantaEditorialPilot %}
          <section class="city-card neighborhood-approved-signal" aria-labelledby="neighborhood-approved-signal-heading">
            <div class="eyebrow">Commercial area context</div>
            <h2 id="neighborhood-approved-signal-heading">{{ approvedEditorialSignal.approved_public_label }}</h2>
            <p>{{ approvedEditorialSignal.approved_public_copy }}</p>
          </section>
        {% endif %}

        {% if not isDistrictIdentityPage %}
          {% include "partials/neighborhood/nearby-commercial-districts.njk" %}
        {% endif %}

        {% if hasBuildings and not neighborhood.representative_content.length %}
          <section class="city-card">
            <div class="eyebrow">Representative Buildings</div>
            <h2>Representative buildings in {{ neighborhoodDisplayNameWithArticle }}</h2>
            <p>
              Selected examples that help ground the area's commercial texture.
            </p>
            <div class="building-grid neighborhood-building-grid">
              {% for b in neighborhood.representative_buildings %}
                {% set building = b %}
                {% set building_card_variant = "neighborhood" %}
                {% include "partials/shared/building-card-compact.njk" %}
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% include "partials/neighborhood/representative-building-cards.njk" %}

        {% include "partials/neighborhood/example-location-briefs.njk" %}

        {% if districtBuildingComparisons and districtBuildingComparisons.length %}
          <section class="city-card">
            <div class="eyebrow">Related comparisons</div>
            <h2>Building comparisons for {{ neighborhoodDisplayNameWithArticle }}</h2>
            <p>
              Use these comparisons to see how representative buildings express different tradeoffs within and around the district.
            </p>
            <div class="neighborhood-comparison-grid">
              {% for comparison in districtBuildingComparisons %}
                {% if loop.index <= 4 %}
                  <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ comparison.path }}">
                    <h3>{{ comparison.short_title }}</h3>
                    <p>{{ comparison.summary }}</p>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% include "partials/neighborhood/market-narrative.njk" %}

        {% if isDistrictIdentityPage %}
          {% include "partials/neighborhood/nearby-commercial-districts.njk" %}
        {% endif %}

        <section class="city-card">
          <div class="eyebrow">Related Space Types</div>
          <h2>Related space types</h2>
          <p>
            Explore commercial space types across the broader {{ neighborhood.city }} market.
          </p>
          {% if neighborhood.approximate_space_types and neighborhood.approximate_space_types.length %}
            <div class="pill-row">
              {% for type in neighborhood.approximate_space_types %}
                <a class="pill" href="{{ cityUrl }}{{ type }}-space/">{{ type | capitalize }} space</a>
              {% endfor %}
            </div>
          {% else %}
            <p>Explore office, retail, industrial, flex, and coworking options across the broader {{ neighborhood.city }} market.</p>
          {% endif %}
        </section>

        {% if not hasDedicatedCommercialDistricts %}
          <section class="city-card">
            <div class="eyebrow">Nearby Neighborhoods</div>
            <h2>Nearby areas</h2>
            <p>
              Compare {{ neighborhoodDisplayNameWithArticle }} with nearby {{ neighborhood.city }} neighborhoods and commercial districts.
            </p>
            {% if hasNearby %}
              <div class="neighborhood-comparison-grid">
                {% for nearby in neighborhood.nearby_neighborhoods %}
                  <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ nearby.url }}">
                    <h3>{{ nearby.name }}</h3>
                    <p>{{ nearby.note or (nearby.city + ", " + nearby.state_abbr) }}</p>
                  </a>
                {% endfor %}
              </div>
            {% else %}
              <p>Use the broader {{ neighborhood.city }} market page to compare nearby commercial areas.</p>
            {% endif %}
          </section>
        {% endif %}

        <section class="city-card">
          <div class="eyebrow">Broader Market</div>
          <h2>Compare the broader {{ neighborhood.city }} market</h2>
          <p>
            Use the broader city page and market guide to continue comparing commercial real estate options across {{ neighborhood.city }}.
          </p>
          <div class="button-row">
            <a class="btn-primary" href="{{ cityUrl }}">Explore {{ neighborhood.city }}</a>
            <a class="btn-secondary" href="{{ cityUrl }}market-guide/">Read the {{ neighborhood.city }} market guide</a>
          </div>
        </section>
      </div>

      <aside class="neighborhood-sidebar">
        {% if isDistrictIdentityPage or neighborhood.commercial_location_model %}
          {% set searchProfileContext = {
            "layout": "inline",
            "submit_enabled": true,
            "submit_endpoint": "/api/leads/submit",
            "target_area": neighborhoodSearchProfileTargetArea,
            "city": neighborhood.city,
            "district": neighborhoodDisplayNameWithArticle,
            "street": "",
            "state": neighborhood.state_abbr,
            "context_type": "district",
            "context_label": neighborhoodDisplayNameWithArticle,
            "page_url": metadata.siteUrl + page.url,
            "page_title": title,
            "routing_market": neighborhood.routing_market or (neighborhood.city_slug + "-" + (neighborhood.state_abbr | lower)),
            "routing_county": neighborhood.routing_county or "",
            "neighborhood_name": neighborhood.name,
            "neighborhood_slug": neighborhood.slug,
            "neighborhood_path": neighborhood.canonical_neighborhood_path,
            "commercial_area_id": neighborhood.commercial_area_id or "",
            "commercial_area_type": neighborhood.commercial_area_type or "",
            "primary_archetype": neighborhood.commercial_location_model.primary_archetype or "",
            "business_ecosystem": neighborhood.commercial_location_model.primary_archetype_label or "",
            "location_suggestions": searchProfileLocationSuggestions,
            "default_space_type": neighborhood.public_decision_surface.defaultSpaceType or "",
            "card_headline": "Get a personalized " + neighborhood.name + " building shortlist"
          } %}
          {% include "partials/shared/recommendation-prompt-card.njk" %}
        {% endif %}

        {% if not hasMapHero and not (isDistrictIdentityPage or neighborhood.commercial_location_model) %}
          <div class="city-card neighborhood-sticky-card">
            <div class="eyebrow">{% if isDistrictIdentityPage %}District Context{% else %}Neighborhood Context{% endif %}</div>
            <h2>Explore {{ neighborhoodDisplayNameWithArticle }}</h2>
            <p>
              Use this page as a starting point for comparing {{ neighborhoodDisplayNameWithArticle }} with other parts of {{ neighborhood.city }}.
            </p>
            <ul class="mini-list">
              <li>Buildings in this area</li>
              <li>Nearby {{ neighborhood.city }} areas</li>
              <li>Related commercial space types</li>
              <li>Broader {{ neighborhood.city }} market guide</li>
            </ul>
          </div>
        {% endif %}

        {% if not (isDistrictIdentityPage or neighborhood.commercial_location_model) %}
        <details id="neighborhood-contact-form" class="city-form city-card neighborhood-lead-form neighborhood-briefing-card">
          <summary>
            <span class="eyebrow">{% if neighborhood.commercial_location_model %}Location decision help{% else %}Current availability{% endif %}</span>
            <span class="neighborhood-briefing-card__headline">{% if neighborhood.commercial_location_model %}Find locations that fit{% else %}Get current availability in {{ neighborhoodDisplayNameWithArticle }}{% endif %}</span>
            <span class="neighborhood-briefing-card__body">
              {% if neighborhood.commercial_location_model %}
                Enter what matters to compare locations, buildings, and alternatives that fit.
              {% else %}
                See current spaces, asking rents, and nearby alternatives in {{ neighborhoodDisplayNameWithArticle }}.
              {% endif %}
            </span>
            <span class="neighborhood-briefing-card__button">{% if neighborhood.commercial_location_model %}Create My Location Brief{% else %}Request availability report{% endif %}</span>
            <span class="neighborhood-briefing-card__reassurance">{% if neighborhood.commercial_location_model %}No obligation. Compare relevant markets, buildings, and alternatives.{% else %}No obligation. Compare relevant spaces and nearby alternatives.{% endif %}</span>
          </summary>
          <form action="/api/leads/submit" method="POST" class="rofo-formspree-form">
            <input type="hidden" name="source" value="rofo-neighborhood-page">
            <input type="hidden" name="lead_type" value="neighborhood">
            <input type="hidden" name="page_type" value="neighborhood">
            <input type="hidden" name="city" value="{{ neighborhood.city }}">
            <input type="hidden" name="state" value="{{ neighborhood.state_abbr }}">
            <input type="hidden" name="market" value="{{ neighborhood.city }}, {{ neighborhood.state_abbr }}">
            <input type="hidden" name="page_url" value="{{ metadata.siteUrl }}{{ page.url }}">
            <input type="hidden" name="rofo_source" value="{{ metadata.siteUrl }}{{ page.url }}">
            <input type="hidden" name="neighborhood_name" value="{{ neighborhood.name }}">
            <input type="hidden" name="neighborhood_slug" value="{{ neighborhood.slug }}">
            <input type="hidden" name="neighborhood_path" value="{{ neighborhood.canonical_neighborhood_path }}">
            <input type="hidden" name="commercial_area_id" value="{{ neighborhood.commercial_area_id or '' }}">
            <input type="hidden" name="commercial_area_type" value="{{ neighborhood.commercial_area_type or '' }}">
            {% if neighborhood.commercial_location_model %}
              <input type="hidden" name="location_decision_selected_district" value="{{ neighborhood.name }}">
              <input type="hidden" name="location_decision_primary_archetype" value="{{ neighborhood.commercial_location_model.primary_archetype }}">
              <input type="hidden" name="location_decision_compared_districts" value="{% for comparison in neighborhood.commercial_location_model.compare_with %}{{ comparison.district_name }}{% if not loop.last %}, {% endif %}{% endfor %}">
            {% endif %}
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none">
            <input type="text" name="company_website" style="display:none;">
            <input type="hidden" name="form_start_time" value="">
            <script>
              document.currentScript.previousElementSibling.value = Date.now();
            </script>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-name">Name</label>
                <input id="neighborhood-lead-name" name="name" type="text" placeholder="Your name" autocomplete="name" required>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-email">Email</label>
                <input id="neighborhood-lead-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-phone">Phone</label>
                <input id="neighborhood-lead-phone" name="phone" type="tel" placeholder="Best phone number" autocomplete="tel" required>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-space-type">Space type</label>
                <select id="neighborhood-lead-space-type" name="space_type" required>
                  <option value="">Select one</option>
                  <option>Office Space</option>
                  <option>Retail Space</option>
                  <option>Industrial Space</option>
                  <option>Coworking Space</option>
                  <option>Flex Space</option>
                  <option>Not Sure</option>
                </select>
                {% if neighborhood.commercial_location_model %}
                  <input type="hidden" name="location_decision_business_use_case" value="captured_from_space_type">
                {% endif %}
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-size">Approximate size</label>
                <select id="neighborhood-lead-size" name="space_needed" required>
                  <option value="">Select one</option>
                  <option>Under 1,000 sqft</option>
                  <option>1,000–2,500 sqft</option>
                  <option>2,500–5,000 sqft</option>
                  <option>5,000–10,000 sqft</option>
                  <option>10,000+ sqft</option>
                  <option>Not Sure</option>
                </select>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="neighborhood-lead-timing">Timing</label>
                <select id="neighborhood-lead-timing" name="timing" required>
                  <option value="">Select one</option>
                  <option>As soon as possible</option>
                  <option>1–3 months</option>
                  <option>3–6 months</option>
                  <option>6+ months</option>
                  <option>Still researching</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="neighborhood-lead-notes">Briefing notes <span class="optional">(optional)</span></label>
              <textarea
                id="neighborhood-lead-notes"
                name="notes"
                placeholder="Example: preferred blocks, budget range, transit needs, nearby areas to compare"
              ></textarea>
            </div>

            <div class="btn-row">
              <label>
                <input type="checkbox" name="human_check" required>
                I’m a real person looking for space
              </label>
              <button class="btn-primary" type="submit">{% if neighborhood.commercial_location_model %}Create My Location Brief{% else %}Request availability report{% endif %}</button>
            </div>

            <p class="form-note">{% if neighborhood.commercial_location_model %}Location fit, current options, and nearby alternatives for {{ neighborhoodDisplayNameWithArticle }}.{% else %}Current spaces, asking rents, recent context, and nearby alternatives for {{ neighborhoodDisplayNameWithArticle }}.{% endif %}</p>
          </form>
        </details>
        {% endif %}
      </aside>
    </div>
  </div>
</section>

{% if not (isDistrictIdentityPage or neighborhood.commercial_location_model) %}
  <script>
    (function () {
      var details = document.getElementById("neighborhood-contact-form");
      if (!details) return;

      function openBriefingCard() {
        if (window.location.hash !== "#neighborhood-contact-form") return;
        details.open = true;
      }

      openBriefingCard();
      window.addEventListener("hashchange", openBriefingCard);
    })();
  </script>
{% endif %}
<script>
  (function () {
    var storageKey = "rofoLocationBriefV2Return";
    try {
      var context = JSON.parse(sessionStorage.getItem(storageKey) || "null");
      if (!context || !/^\/(?:operator\/location-brief-v2|location-brief)\/LB2-[A-F0-9]{24}$/i.test(context.url || "")) return;
      var shell = document.querySelector(".neighborhood-public .city-shell");
      if (!shell) return;
      var container = document.createElement("div");
      var link = document.createElement("a");
      container.className = "location-brief-return";
      link.href = context.url;
      link.textContent = "← " + (context.label || "Back to my Location Brief");
      container.appendChild(link);
      shell.insertBefore(container, shell.firstChild);
    } catch (error) {
      // Public district content and canonical behavior remain unchanged without private return context.
    }
  })();
</script>
