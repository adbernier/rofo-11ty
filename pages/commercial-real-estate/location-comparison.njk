---
layout: base.njk
pagination:
  data: locationComparisonPages
  size: 1
  alias: comparison
permalink: "{{ comparison.path }}"
eleventyComputed:
  title: "{{ comparison.page_title }}"
  description: "{{ comparison.meta_description }}"
  canonical: "{{ metadata.siteUrl }}{{ comparison.path }}"
---

{% set crumbs = [
  { "label": "Markets", "url": "/markets/" },
  { "label": comparison.city + ", " + comparison.state_abbr, "url": "/commercial-real-estate/" + comparison.state_abbr + "/" + comparison.city_slug + "/" },
  { "label": comparison.short_title, "url": comparison.path }
] %}

<section class="city-page neighborhood-public location-comparison-page">
  <div class="city-shell">
    {% include "partials/breadcrumbs.njk" %}

    <div class="city-hero city-hero--district-identity">
      <div class="city-card">
        <div class="city-hero-copy">
          <div class="eyebrow">Location comparison</div>
          <h1>{{ comparison.title }}</h1>
          <p class="lead">
            Compare which commercial district is a better fit before narrowing to specific spaces.
          </p>
          <div class="button-row">
            <a class="btn-primary" href="#comparison-contact-form">Find locations that fit</a>
            <a class="btn-secondary" href="/commercial-real-estate/{{ comparison.state_abbr }}/{{ comparison.city_slug }}/market-guide/">Read market guide</a>
          </div>
        </div>
      </div>
    </div>

    <div class="neighborhood-layout">
      <div class="neighborhood-main">
        <section class="city-card">
          <div class="eyebrow">Quick read</div>
          <h2>Which district fits better?</h2>
          <div class="location-comparison-panel-grid">
            <div class="location-comparison-panel location-comparison-panel--summary">
              <h3><a class="building-link" href="{{ comparison.district_a_path }}">{{ comparison.district_a_name }}</a></h3>
              <p class="location-comparison-panel__prompt">Choose this district if:</p>
              <ul class="mini-list location-comparison-panel__list">
                {% for item in comparison.district_a.best_fit_businesses %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
            <div class="location-comparison-panel location-comparison-panel--summary">
              <h3><a class="building-link" href="{{ comparison.district_b_path }}">{{ comparison.district_b_name }}</a></h3>
              <p class="location-comparison-panel__prompt">Choose this district if:</p>
              <ul class="mini-list location-comparison-panel__list">
                {% for item in comparison.district_b.best_fit_businesses %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Commercial environment</div>
          <h2>How the districts differ</h2>
          <ul class="mini-list">
            {% for note in comparison.comparison_notes %}
              <li>{{ note }}</li>
            {% endfor %}
          </ul>
        </section>

        <section class="city-card">
          <div class="eyebrow">Business fit</div>
          <h2>Best fit by district</h2>
          <div class="location-comparison-panel-grid">
            <div class="location-comparison-panel">
              <h3>{{ comparison.district_a_name }}</h3>
              <p class="location-comparison-panel__meta">{{ comparison.district_a.primary_archetype_label }}</p>
              <p>{{ comparison.district_a.commercial_thesis }}</p>
              <ul class="mini-list location-comparison-panel__list">
                {% for item in comparison.district_a.best_fit_businesses %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
            <div class="location-comparison-panel">
              <h3>{{ comparison.district_b_name }}</h3>
              <p class="location-comparison-panel__meta">{{ comparison.district_b.primary_archetype_label }}</p>
              <p>{{ comparison.district_b.commercial_thesis }}</p>
              <ul class="mini-list location-comparison-panel__list">
                {% for item in comparison.district_b.best_fit_businesses %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">{{ comparison.decision_context_label }}</div>
          <h2>{{ comparison.decision_context_heading }}</h2>
          <div class="location-comparison-panel-grid">
            <div class="location-comparison-panel">
              <h3>{{ comparison.district_a_name }} tends to work better for</h3>
              <ul class="mini-list location-comparison-panel__list">
                {% for item in comparison.district_a_decision_context %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
            <div class="location-comparison-panel">
              <h3>{{ comparison.district_b_name }} tends to work better for</h3>
              <ul class="mini-list location-comparison-panel__list">
                {% for item in comparison.district_b_decision_context %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Decision guidance</div>
          <h2>Less ideal for</h2>
          <div class="location-comparison-panel-grid">
            <div class="location-comparison-panel location-comparison-panel--quiet">
              <h3>{{ comparison.district_a_name }}</h3>
              <ul class="mini-list location-comparison-panel__list">
                {% for item in comparison.district_a.poor_fit_businesses %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
            <div class="location-comparison-panel location-comparison-panel--quiet">
              <h3>{{ comparison.district_b_name }}</h3>
              <ul class="mini-list location-comparison-panel__list">
                {% for item in comparison.district_b.poor_fit_businesses %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Continue comparing</div>
          <h2>Review each district guide</h2>
          <div class="button-row">
            <a class="btn-primary" href="{{ comparison.district_a_path }}">{{ comparison.district_a_detail_cta }}</a>
            <a class="btn-secondary" href="{{ comparison.district_b_path }}">{{ comparison.district_b_detail_cta }}</a>
          </div>
        </section>

        {% if comparison.related_alternatives and comparison.related_alternatives.length %}
          <section class="city-card">
            <div class="eyebrow">Related location decisions</div>
            <h2>Businesses comparing these districts also evaluate</h2>
            <div class="neighborhood-comparison-grid">
              {% for alternative in comparison.related_alternatives %}
                <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ alternative.url }}">
                  <h3>{{ alternative.district_name }}</h3>
                  <p>{{ alternative.reason }}</p>
                </a>
              {% endfor %}
            </div>
          </section>
        {% endif %}
      </div>

      <aside class="neighborhood-sidebar">
        <details id="comparison-contact-form" class="city-form city-card neighborhood-lead-form neighborhood-briefing-card">
          <summary>
            <span class="eyebrow">Location decision help</span>
            <span class="neighborhood-briefing-card__headline">Find locations that fit</span>
            <span class="neighborhood-briefing-card__body">
              Tell us what matters and we’ll help compare locations, buildings, and alternatives that fit.
            </span>
            <span class="neighborhood-briefing-card__button">Find locations that fit</span>
            <span class="neighborhood-briefing-card__reassurance">No obligation. We’ll help compare relevant markets, buildings, and alternatives.</span>
          </summary>
          <form action="/api/leads/submit" method="POST" class="rofo-formspree-form">
            <input type="hidden" name="source" value="rofo-location-comparison-page">
            <input type="hidden" name="lead_type" value="location_comparison">
            <input type="hidden" name="page_type" value="location_comparison">
            <input type="hidden" name="city" value="{{ comparison.city }}">
            <input type="hidden" name="state" value="{{ comparison.state_abbr }}">
            <input type="hidden" name="market" value="{{ comparison.city }}, {{ comparison.state_abbr }}">
            <input type="hidden" name="page_url" value="{{ metadata.siteUrl }}{{ page.url }}">
            <input type="hidden" name="rofo_source" value="{{ metadata.siteUrl }}{{ page.url }}">
            <input type="hidden" name="location_decision_selected_district" value="{{ comparison.title }}">
            <input type="hidden" name="location_decision_primary_archetype" value="{{ comparison.district_a.primary_archetype }}, {{ comparison.district_b.primary_archetype }}">
            <input type="hidden" name="location_decision_compared_districts" value="{{ comparison.compared_districts_value }}">
            <input type="hidden" name="location_decision_business_use_case" value="captured_from_space_type">
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none">
            <input type="text" name="company_website" style="display:none;">
            <input type="hidden" name="form_start_time" value="">
            <script>
              document.currentScript.previousElementSibling.value = Date.now();
            </script>

            <div class="form-stack">
              <div class="field">
                <label for="comparison-lead-name">Name</label>
                <input id="comparison-lead-name" name="name" type="text" placeholder="Your name" autocomplete="name" required>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="comparison-lead-email">Email</label>
                <input id="comparison-lead-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="comparison-lead-phone">Phone</label>
                <input id="comparison-lead-phone" name="phone" type="tel" placeholder="Best phone number" autocomplete="tel" required>
              </div>
            </div>

            <div class="form-stack">
              <div class="field">
                <label for="comparison-lead-space-type">Space type</label>
                <select id="comparison-lead-space-type" name="space_type" required>
                  <option value="">Select one</option>
                  <option>Office Space</option>
                  <option>Industrial Space</option>
                  <option>Flex Space</option>
                  <option>Retail Space</option>
                  <option>Not Sure</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="comparison-lead-notes">What are you comparing? <span class="optional">(optional)</span></label>
              <textarea
                id="comparison-lead-notes"
                name="notes"
                placeholder="Example: team size, preferred commute, client-facing needs, warehouse/flex needs, or districts you are considering"
              ></textarea>
            </div>

            <div class="btn-row">
              <label>
                <input type="checkbox" name="human_check" required>
                I’m a real person evaluating locations
              </label>
              <button class="btn-primary" type="submit">Find locations that fit</button>
            </div>

            <p class="form-note">District fit, current options, and nearby alternatives for {{ comparison.short_title }}.</p>
          </form>
        </details>
      </aside>
    </div>
  </div>
</section>

<script>
  (function () {
    var details = document.getElementById("comparison-contact-form");
    if (!details) return;

    function openBriefingCard() {
      if (window.location.hash !== "#comparison-contact-form") return;
      details.open = true;
    }

    openBriefingCard();
    window.addEventListener("hashchange", openBriefingCard);
  })();
</script>
