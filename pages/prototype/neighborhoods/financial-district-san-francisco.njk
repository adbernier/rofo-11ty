<section class="city-page neighborhood-prototype">
  <div class="city-shell">
    {% include "partials/breadcrumbs.njk" %}

    <div class="neighborhood-prototype__notice">
      Controlled prototype page. This is not linked from navigation or sitemap, and it does not represent live inventory.
    </div>

    <section class="neighborhood-hero city-card">
      <div class="neighborhood-hero__content">
        <div class="eyebrow">Business District Prototype</div>
        <h1>San Francisco Financial District</h1>
        <p class="lead">
          A central business district for teams that value client access, transit options, professional image, and proximity to other downtown firms and services.
        </p>
        <div class="neighborhood-chip-row" aria-label="Best fit businesses">
          {% for fit in bestFits %}
            <span class="neighborhood-chip">{{ fit }}</span>
          {% endfor %}
        </div>
        <div class="neighborhood-hero__actions">
          <a class="btn-primary" href="#neighborhood-cta">Compare this district</a>
          <a class="btn-secondary" href="#nearby-districts">Nearby districts</a>
        </div>
      </div>
      <aside class="neighborhood-hero__panel">
        <div class="stat-label">Nearby districts to compare</div>
        <ul class="mini-list">
          <li>Jackson Square for a more boutique downtown environment</li>
          <li>SoMa for creative, technology, and flexible workspace patterns</li>
          <li>Union Square for retail, hospitality, and visitor-facing context</li>
          <li>Mission Bay for newer buildings and life science adjacency</li>
        </ul>
      </aside>
    </section>

    <div class="neighborhood-layout">
      <aside class="neighborhood-sidebar">
        <section class="city-card neighborhood-sticky-card" id="neighborhood-cta">
          <div class="eyebrow">Get Guidance</div>
          <h2>Tell us what kind of environment you're looking for</h2>
          <p>
            We'll help compare the Financial District with nearby options like Jackson Square, SoMa, and Mission Bay. This does not imply live availability.
          </p>
          <form class="neighborhood-prototype-form" aria-label="Prototype neighborhood guidance form">
            <div class="field">
              <label for="neighborhood-name">Name</label>
              <input id="neighborhood-name" type="text" name="name" autocomplete="name">
            </div>
            <div class="field">
              <label for="neighborhood-email">Email</label>
              <input id="neighborhood-email" type="email" name="email" autocomplete="email">
            </div>
            <div class="field">
              <label for="neighborhood-phone">Phone</label>
              <input id="neighborhood-phone" type="tel" name="phone" autocomplete="tel">
            </div>
            <div class="field">
              <label for="neighborhood-company">Company</label>
              <input id="neighborhood-company" type="text" name="company" autocomplete="organization">
            </div>
            <div class="field">
              <label for="neighborhood-size">Approximate size</label>
              <select id="neighborhood-size" name="space_needed">
                <option value="">Select a range</option>
                <option>Under 1,000 sqft</option>
                <option>1,000-2,500 sqft</option>
                <option>2,500-5,000 sqft</option>
                <option>5,000-10,000 sqft</option>
                <option>10,000+ sqft</option>
                <option>Not sure</option>
              </select>
            </div>
            <div class="field">
              <label for="neighborhood-timing">Desired timing</label>
              <select id="neighborhood-timing" name="timing">
                <option value="">Select timing</option>
                <option>Now</option>
                <option>Next 3 months</option>
                <option>3-6 months</option>
                <option>Just exploring</option>
              </select>
            </div>
            <div class="field">
              <label for="neighborhood-requirements">What kind of space/environment are you looking for?</label>
              <textarea id="neighborhood-requirements" name="requirements" rows="4"></textarea>
            </div>
            <button class="btn-primary" type="button">Get neighborhood guidance</button>
            <p class="form-note">
              Static prototype form. Later this could be wired into Rofo's lead workflow with district metadata.
            </p>
          </form>
        </section>
      </aside>

      <main class="neighborhood-main">
        <section class="city-card neighborhood-fit-card">
          <div class="eyebrow">Best Fit</div>
          <h2>Is the Financial District a good fit?</h2>
          <div class="neighborhood-fit-grid">
            {% for group in quickFitGroups %}
              <article class="neighborhood-fit-group">
                <h3>{{ group.title }}</h3>
                <div class="neighborhood-fit-chip-row">
                  {% for item in group.items %}
                    <span>{{ item }}</span>
                  {% endfor %}
                </div>
              </article>
            {% endfor %}
            <article class="neighborhood-fit-group neighborhood-fit-group--wide">
              <h3>Consider Nearby Districts If You Need</h3>
              <ul class="neighborhood-fit-list">
                {% for item in nearbyFitItems %}
                  <li><strong>{{ item.need }}</strong> <span aria-hidden="true">&rarr;</span> {{ item.district }}</li>
                {% endfor %}
              </ul>
            </article>
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Decision Fit</div>
          <h2>Why businesses choose the Financial District</h2>
          <p>
            Businesses choose the Financial District when the address and surrounding environment matter as much as the space itself. The district can reduce friction for meetings because clients, advisors, partners, banks, lawyers, accountants, and consultants are often already moving through downtown San Francisco.
          </p>
          <p>
            For teams, the district offers a traditional downtown work environment. That can help companies that want a recognizable address, a more formal client impression, and access to a larger base of professional office buildings.
          </p>
          <div class="neighborhood-callout">
            The main tenant question is fit: does a central business address and transit-heavy environment matter more than parking ease, production space, or a more creative neighborhood feel?
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Workspace Environment</div>
          <h2>Building styles and workspace environment</h2>
          <p>
            The Financial District has one of San Francisco's clearest office identities. The building environment includes high-rise office towers, older downtown commercial buildings, historic properties, and smaller boutique office options near Jackson Square and the northern edge of the district.
          </p>
          <div class="neighborhood-card-grid">
            {% for item in workspaceTypes %}
              <article class="neighborhood-mini-card">
                <h3>{{ item.title }}</h3>
                <p>{{ item.body }}</p>
              </article>
            {% endfor %}
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Access</div>
          <h2>Transit, parking, and accessibility</h2>
          <p>
            Access is one of the main reasons companies evaluate the Financial District. The location can support employees, clients, and visitors coming from different parts of the city and region, but parking-sensitive businesses should evaluate tradeoffs carefully.
          </p>
          <div class="neighborhood-card-grid neighborhood-card-grid--compact">
            {% for item in accessItems %}
              <article class="neighborhood-mini-card">
                <h3>{{ item.title }}</h3>
                <p>{{ item.body }}</p>
              </article>
            {% endfor %}
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Daily Experience</div>
          <h2>Food, amenities, and the workday</h2>
          <p>
            The daily experience around the office affects whether a location works after move-in. In the Financial District, convenience is the business point: nearby services can make meetings, errands, client visits, and employee workdays easier.
          </p>
          <div class="neighborhood-check-grid">
            {% for item in dailyItems %}
              <div class="neighborhood-check-item">{{ item }}</div>
            {% endfor %}
          </div>
        </section>

        <section class="city-card" id="nearby-districts">
          <div class="eyebrow">Compare Districts</div>
          <h2>Nearby district comparisons</h2>
          <p>
            Most tenants should compare the Financial District with nearby business districts before choosing a location. The right answer depends on client access, building style, daily experience, and how the team works.
          </p>
          <div class="neighborhood-comparison-grid">
            {% for item in comparisons %}
              <article class="neighborhood-comparison-card">
                <div class="stat-label">{{ item.type }}</div>
                <h3>{{ item.name }}</h3>
                <p>{{ item.body }}</p>
              </article>
            {% endfor %}
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Representative Buildings</div>
          <h2>Examples of the district's building fabric</h2>
          <p>
            These buildings are representative examples selected from historical Rofo building and activity signals. They are not presented as current options, and this page intentionally avoids suite, pricing, or inventory claims.
          </p>
          <div class="neighborhood-building-list">
            {% for building in buildings %}
              <article class="neighborhood-building-card">
                <div>
                  <h3>{{ building.name }}</h3>
                  <p class="neighborhood-building-card__address">{{ building.address }}</p>
                </div>
                <p>{{ building.reason }}</p>
              </article>
            {% endfor %}
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Space Types</div>
          <h2>Common space types in this district</h2>
          <div class="neighborhood-card-grid">
            {% for item in spaceTypes %}
              <article class="neighborhood-mini-card">
                <h3>{{ item.title }}</h3>
                <p>{{ item.body }}</p>
              </article>
            {% endfor %}
          </div>
        </section>

        <section class="city-card">
          <div class="eyebrow">Market Context</div>
          <h2>Leasing patterns and tradeoffs</h2>
          <p>
            Rofo's historical building and activity signals show meaningful commercial intensity in the Financial District. In the prototype dataset, the district has 274 assigned representative building records, 164 buildings with active historical signals, and 1,812 total historical activity signals.
          </p>
          <p>
            These signals help explain the district's role as a traditional downtown office market. They do not describe today's options. They should be used as context for building patterns, tenant fit, and nearby comparison, not as an inventory count.
          </p>
          <ul class="guide-list">
            <li>Strong central address versus potential parking friction.</li>
            <li>Professional image versus a less creative neighborhood feel.</li>
            <li>Large tower inventory versus boutique buildings nearby.</li>
            <li>Client access versus employee preference for other districts.</li>
          </ul>
        </section>
      </main>
    </div>
  </div>
</section>
