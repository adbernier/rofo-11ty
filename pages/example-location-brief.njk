<script>
  (() => {
    const endpoint = "/api/analytics/search-profile";
    function track(eventName) {
      const payload = {
        event_name: eventName,
        profile_version: "example_location_brief_v1",
        context: {
          page_type: "example_location_brief",
          page_url: window.location.href,
          location_display: "Example Location Brief",
          device_type: window.matchMedia && window.matchMedia("(max-width: 767px)").matches ? "mobile" : "desktop",
        },
        profile: {
          profile_version: "example_location_brief_v1",
        },
        attribution: {
          referrer: document.referrer || "",
          landing_page: window.location.href,
          entry_page_type: "example_location_brief",
        },
      };
      try {
        const body = JSON.stringify(payload);
        if (navigator.sendBeacon) {
          const blob = new Blob([body], { type: "application/json" });
          if (navigator.sendBeacon(endpoint, blob)) return;
        }
        fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body,
          credentials: "same-origin",
          keepalive: true,
        }).catch(() => {});
      } catch (error) {}
    }

    track("example_location_brief_viewed");
    document.querySelectorAll("[data-example-brief-cta]").forEach((link) => {
      link.addEventListener("click", () => track("example_location_brief_cta_clicked"), { once: true });
    });
  })();
</script>
