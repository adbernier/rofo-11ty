---
layout: base.njk
fieldPhotosPublic: true
pagination:
  data: spaceTypePages
  size: 1
  alias: entry
permalink: "/commercial-real-estate/{{ entry.city.state_abbr | upper }}/{{ entry.city_slug }}/{{ entry.page_slug }}/index.html"
eleventyComputed:
  title: "{{ entry.spaceType.label }} Space in {{ entry.city.city }}, {{ entry.city.state_abbr | upper }} | Rofo"
  description: "Compare {{ entry.spaceType.label | lower }} location options in {{ entry.city.city }}, {{ entry.city.state_abbr | upper }}. Understand areas, buildings, and tradeoffs before narrowing the search."
---

{% set city = entry.city %}
{% set stateAbbr = city.state_abbr | upper %}
{% set spaceType = entry.spaceType %}
{% set representativeBuildings = entry.representativeBuildings %}
{% set searchProfileDefaultSpaceType = "Industrial / Warehouse" if spaceType.slug == "industrial-space" else spaceType.label %}
{% set searchProfileHeadlineType = "industrial" if spaceType.slug == "industrial-space" else (spaceType.label | lower) %}
{% set searchProfileShortlistType = searchProfileHeadlineType | replace(" space", "") %}
{% set searchProfileLocationSuggestions = [] %}
{% if city.nearby_cities and city.nearby_cities.length %}
  {% for nearby in city.nearby_cities.slice(0, 6) %}
    {% set searchProfileLocationSuggestions = (searchProfileLocationSuggestions.push(nearby.city), searchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}
{% set spaceTypeBusinessBriefs = [] %}
{% if businessBriefs and businessBriefs.briefs and spaceType.slug == "office-space" %}
  {% for brief in businessBriefs.briefs %}
    {% if brief.isIndexable and brief.market.marketSlug == city.slug and brief.internalLinks.propertyType == "/commercial-real-estate/" + stateAbbr + "/" + (city.slug | lower) + "/" + spaceType.slug + "/" %}
      {% set spaceTypeBusinessBriefs = (spaceTypeBusinessBriefs.push(brief), spaceTypeBusinessBriefs) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set crumbs = [
  { "label": city.city + ", " + stateAbbr, "url": "/commercial-real-estate/" + stateAbbr + "/" + (city.slug | lower) + "/" },
  { "label": spaceType.pluralLabel, "url": "/commercial-real-estate/" + stateAbbr + "/" + (city.slug | lower) + "/" + spaceType.slug + "/" }
] %}

<section class="market-page market-page--space-type">
  <div class="city-shell">
    {% include "partials/breadcrumbs.njk" %}
    {% set searchProfileContext = {
      "layout": "space-type",
      "submit_enabled": true,
      "submit_endpoint": "/api/leads/submit",
      "target_area": city.city,
      "city": city.city,
      "district": "",
      "street": "",
      "state": stateAbbr,
      "context_type": "space_type",
      "context_label": spaceType.pluralLabel + " in " + city.city + ", " + stateAbbr,
      "page_url": metadata.siteUrl + page.url,
      "page_title": title,
      "routing_market": entry.routing_market or (city.slug + "-" + (stateAbbr | lower)),
      "routing_county": entry.routing_county or "",
      "neighborhood_name": "",
      "neighborhood_slug": "",
      "neighborhood_path": "",
      "commercial_area_id": "",
      "commercial_area_type": "space_type",
      "location_suggestions": searchProfileLocationSuggestions,
      "default_space_type": searchProfileDefaultSpaceType,
      "space_type_context_label": "Searching for: " + spaceType.pluralLabel,
      "card_headline": "Get a personalized " + city.city + " " + searchProfileShortlistType + " shortlist"
    } %}

    <div class="space-type-hero-layout">
      {% include "partials/space-type/hero.njk" %}

      <aside class="space-type-search-profile">
        {% include "partials/shared/recommendation-prompt-card.njk" %}
      </aside>
    </div>

    <div class="space-type-content-layout">
      <div class="page-stack space-type-main-content">
        {% include "partials/space-type/market-snapshot.njk" %}
        {% include "partials/space-type/guide-card.njk" %}
        {% include "partials/space-type/business-briefs.njk" %}

        {% include "partials/space-type/definitions-card.njk" %}
        {% include "partials/space-type/budget-card.njk" %}
        {% include "partials/space-type/timeline-card.njk" %}

        {% include "partials/space-type/representative-buildings.njk" %}
        {% include "partials/space-type/nearby-markets.njk" %}
        {% include "partials/space-type/related-space-types.njk" %}
      </div>
    </div>
  </div>
</section>
