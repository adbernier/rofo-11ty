---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
{% set siteUrl = metadata.siteUrl or "https://www.rofo.com" %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>{{ siteUrl }}/</loc>
  </url>

  <url>
    <loc>{{ siteUrl }}/markets/</loc>
  </url>

  <url>
    <loc>{{ siteUrl }}/commercial-real-estate/market-guides/</loc>
  </url>

  <url>
    <loc>{{ siteUrl }}/commercial-real-estate/lease-guide/</loc>
  </url>

  {% for topic in commercialLeasingHandbook.articles %}
  <url>
    <loc>{{ siteUrl }}{{ topic.url }}</loc>
  </url>
  {% endfor %}

  <url>
    <loc>{{ siteUrl }}/find-locations/</loc>
  </url>

  <url>
    <loc>{{ siteUrl }}/example-location-brief/</loc>
  </url>

  <url>
    <loc>{{ siteUrl }}/how-rofo-works/</loc>
  </url>

  <url>
    <loc>{{ siteUrl }}/why-rofo/</loc>
  </url>

  <url>
    <loc>{{ siteUrl }}/about/</loc>
  </url>

  {% for city in cities %}
  <url>
    <loc>{{ siteUrl }}{{ city.path }}</loc>
  </url>
  <url>
    <loc>{{ siteUrl }}{{ city.path }}buildings/</loc>
  </url>
  {% endfor %}

  {% for entry in spaceTypePages %}
  <url>
    <loc>{{ siteUrl }}/commercial-real-estate/{{ entry.state_abbr }}/{{ entry.city_slug }}/{{ entry.page_slug }}/</loc>
  </url>
  {% endfor %}

  {% set guideUrls = [] %}
  {% for guide in marketGuides %}
  {% set guideLoc = siteUrl + guide.url %}
  {% if guide.url and guide.output_path and "/commercial-real-estate-guides/" not in guide.url and guideLoc not in guideUrls %}
  <url>
    <loc>{{ guideLoc }}</loc>
  </url>
  {% set guideUrls = (guideUrls.push(guideLoc), guideUrls) %}
  {% endif %}
  {% endfor %}

  {% for neighborhood in neighborhoodPages %}
  {% if neighborhood.canonical_neighborhood_path and not neighborhood.noindex %}
  <url>
    <loc>{{ siteUrl }}{{ neighborhood.canonical_neighborhood_path }}</loc>
  </url>
  {% endif %}
  {% endfor %}

  {% set comparisonUrls = [] %}
  {% for comparison in locationComparisonPages %}
  {% set comparisonLoc = siteUrl + comparison.path %}
  {% if comparison.path and comparisonLoc not in comparisonUrls %}
  <url>
    <loc>{{ comparisonLoc }}</loc>
  </url>
  {% set comparisonUrls = (comparisonUrls.push(comparisonLoc), comparisonUrls) %}
  {% endif %}
  {% endfor %}

  {% set buildingUrls = [] %}
  {% for building in buildings %}
  {% set buildingLoc = siteUrl + "/commercial-real-estate/building/" + building.state_abbr + "/" + building.city_slug + "/" + building.building_slug + "/" %}
  {% if buildingLoc not in buildingUrls %}
  <url>
    <loc>{{ buildingLoc }}</loc>
  </url>
  {% set buildingUrls = (buildingUrls.push(buildingLoc), buildingUrls) %}
  {% endif %}
  {% endfor %}

  {% for company in companies %}
  <url>
    <loc>{{ siteUrl }}/commercial-real-estate/company/{{ company.slug }}/</loc>
  </url>
  {% endfor %}

</urlset>
