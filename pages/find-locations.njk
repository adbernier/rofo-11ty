---
layout: base.njk
permalink: /find-locations/
title: Business Profile for Location Recommendations | Rofo
description: Create a short Business Profile so Rofo can recommend where your business should begin looking for commercial space.
eleventyComputed:
  canonical: "{{ metadata.siteUrl }}/find-locations/"
---

<section class="city-page search-profile-page">
  <div class="city-shell">
    <div class="search-profile-page__shell">
      <section class="find-locations-context-note" data-profile-query-context hidden>
        <p>Based on what you were exploring:</p>
        <ul data-profile-query-context-list></ul>
        <span>Complete your Business Profile to receive your recommendation.</span>
      </section>
      {% set searchProfileContext = {
        "layout": "page",
        "submit_enabled": true,
        "submit_endpoint": "/api/leads/submit",
        "target_area": "",
        "city": "",
        "district": "",
        "street": "",
        "state": "",
        "context_type": "find_locations",
        "context_label": "Business Profile",
        "card_headline": "Business Profile",
        "primary_cta_label": "Create My Location Brief",
        "contact_heading": "We have enough to build your Location Brief.",
        "contact_prompt": "Add an email to save this Business Profile and receive your recommendation.",
        "contact_cta_label": "Create My Location Brief",
        "finished_heading": "Your Business Profile is ready.",
        "finished_copy": "Rofo has enough context to prepare your recommendation and Location Brief.",
        "location_helper": "A city, district, neighborhood, or street is enough.",
        "location_chip_mode": "selected_only",
        "page_url": metadata.siteUrl + page.url,
        "page_title": title,
        "routing_market": "",
        "routing_county": "",
        "neighborhood_name": "",
        "neighborhood_slug": "",
        "neighborhood_path": "",
        "commercial_area_id": "",
        "commercial_area_type": "",
        "location_suggestions": []
      } %}
      {% include "partials/shared/search-profile-card.njk" %}
    </div>
  </div>
</section>

<script src="/js/search-profile.js" defer></script>
<script>
  (() => {
    const endpoint = "/api/analytics/search-profile";
    const profileVersion = "V2.1";
    const pageType = "find_locations";
    const pageUrl = window.location.href;
    const sessionKey = "rofo_recommendation_session_id";
    const viewedKey = "rofo_find_locations_page_viewed";

    function sessionId() {
      try {
        let id = window.sessionStorage.getItem(sessionKey);
        if (!id) {
          id = (window.crypto && window.crypto.randomUUID)
            ? window.crypto.randomUUID()
            : `${Date.now()}-${Math.random().toString(16).slice(2)}`;
          window.sessionStorage.setItem(sessionKey, id);
        }
        return id;
      } catch (error) {
        return "";
      }
    }

    function track(eventName, extraContext = {}) {
      const payload = {
        event_name: eventName,
        profile_version: profileVersion,
        context: {
          page_type: pageType,
          page_url: pageUrl,
          location_display: "Business Profile",
          device_type: window.matchMedia && window.matchMedia("(max-width: 767px)").matches ? "mobile" : "desktop",
          ...extraContext,
        },
        profile: {
          profile_version: profileVersion,
        },
        attribution: {
          referrer: document.referrer || "",
          landing_page: pageUrl,
          entry_page_type: pageType,
          session_id: sessionId(),
        },
      };

      try {
        const body = JSON.stringify(payload);
        if (navigator.sendBeacon) {
          const blob = new Blob([body], { type: "application/json" });
          if (navigator.sendBeacon(endpoint, blob)) return;
        }
        fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body,
          credentials: "same-origin",
          keepalive: true,
        }).catch(() => {});
      } catch (error) {}
    }

    try {
      if (!window.sessionStorage.getItem(viewedKey)) {
        window.sessionStorage.setItem(viewedKey, "1");
        track("find_locations_page_viewed");
      }
    } catch (error) {
      track("find_locations_page_viewed");
    }
    const fallbackReason = new URLSearchParams(window.location.search).get("v2Fallback");
    if (fallbackReason) track("vnext_entry_fallback", { reason_code: fallbackReason });

    document.addEventListener("click", (event) => {
      const button = event.target && event.target.closest("[data-profile-next]");
      if (!button) return;
      if (button.dataset.profileAction !== "build_location_brief") return;
      track("find_locations_primary_cta_clicked");
    }, { capture: true });
  })();
</script>
