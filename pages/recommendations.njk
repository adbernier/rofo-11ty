      <div class="location-brief-contact__header">
        <div class="kicker" data-recommendation-cta-kicker>Optional Expert Review</div>
        <h2 id="market-investigation" data-recommendation-cta-heading>Request expert review when you are ready.</h2>
        <p data-recommendation-cta-copy>
          Share your profile only when you want expert follow-up on listings, comps, sublease options, incentives, and market guidance.
        </p>
      </div>

      <div class="recommendations-cta__panel">
        <h3>What an expert can help with</h3>
        <ul>
          <li>Current availability</li>
          <li>Asking rents</li>
          <li>Landlord incentives</li>
          <li>Sublease opportunities</li>
          <li>Upcoming vacancies</li>
          <li>Off-market options</li>
          <li>Comparable buildings</li>
        </ul>
      </div>

      <div class="location-brief-contact__grid">
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required>
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label>
          <span>Company <em>optional</em></span>
          <input type="text" name="company" autocomplete="organization">
        </label>
        <label>
          <span>Phone <em>optional</em></span>
          <input type="tel" name="phone" autocomplete="tel">
        </label>
      </div>
      <div class="location-brief-contact__actions">
        <button class="recommendations-button" type="submit">Request Expert Review</button>
        <p data-location-brief-contact-status></p>
      </div>
    </form>
