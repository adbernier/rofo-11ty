          <h3 id="brief-questions-heading">Questions to validate next</h3>
          <ul class="location-brief-question-list" data-location-brief-questions>
            <li>Current availability in the recommended market path.</li>
            <li>Asking rents, concessions, and lease structure.</li>
            <li>Comparable buildings and nearby alternatives.</li>
          </ul>
        </section>

        <section class="location-brief-refinement__panel" aria-labelledby="brief-notes-heading">
          <h3 id="brief-notes-heading">Additional notes</h3>
          <label class="location-brief-notes-label" for="location-brief-notes">Optional notes</label>
          <textarea id="location-brief-notes" data-location-brief-notes rows="4" placeholder="Example: We are growing quickly, parking is critical, or clients visit weekly."></textarea>
