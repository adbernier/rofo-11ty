---
layout: base.njk
pagination:
  data: buildingPages
  size: 1
  alias: building
permalink: "/commercial-real-estate/building/{{ building.state_abbr }}/{{ building.city_slug }}/{{ building.building_slug }}/index.html"
eleventyComputed:
  title: >
    {% if building.meta_title %}
      {{ building.meta_title }}
    {% elseif building.editorial_representative %}
      {{ building.address }} | Representative Commercial Building | {{ building.city }}, {{ building.state_abbr }} | Rofo
    {% else %}
      {{ building.address }} | Commercial Building | {{ building.city }}, {{ building.state_abbr }} | Rofo
    {% endif %}
  description: >
    {% if building.meta_description %}
      {{ building.meta_description }}
    {% elseif building.editorial_representative %}
      See why businesses may evaluate {{ building.address }} in {{ building.city }}, {{ building.state_abbr }}. Understand fit, tradeoffs, and what to validate before adding similar buildings to a shortlist.
    {% else %}
      Review commercial building context for {{ building.address }} in {{ building.city }}, {{ building.state_abbr }} and compare the location with nearby markets, space types, and alternatives.
    {% endif %}
---

{% set placeholderSrc = building | buildingPlaceholder %}
{% set stateName = stateNames[building.state_abbr] or building.state_abbr %}
{% set semanticEnvironment = semanticBuildingPreview[building.semantic_source_building_id] %}
{% set isRepresentativeBuilding = building.editorial_representative %}
{% set buildingBrief = building.building_brief %}
{% set buildingBriefName = building.commercial_building_intelligence.identity.name if building.commercial_building_intelligence and building.commercial_building_intelligence.identity and building.commercial_building_intelligence.identity.name else building.display_name or building.name or building.address %}
{% set buildingBriefArea = building.commercial_building_intelligence.identity.canonicalDistrict if buildingBrief and building.commercial_building_intelligence and building.commercial_building_intelligence.identity and building.commercial_building_intelligence.identity.canonicalDistrict else building.commercial_area %}
{% set relatedHandbookTopics = building.related_handbook_topics or [] %}
{% set relatedComparisonPaths = commercialBuildingComparisons.relationshipGraph.bySubjectPath[building.building_path] or [] %}
{% set buildingStartSearchUrl = "/find-locations/?city=" + (building.city | urlencode) + "&state=" + building.state_abbr %}
{% set crumbs = [
  { "label": "Markets", "url": "/markets/" },
  { "label": stateName, "url": "/commercial-real-estate/" + building.state_abbr + "/" },
  { "label": building.city + ", " + building.state_abbr, "url": "/commercial-real-estate/" + building.state_abbr + "/" + building.city_slug + "/" },
  { "label": building.address, "url": page.url }
] %}

<section class="building-page{% if isRepresentativeBuilding %} building-page--representative{% endif %}">
  <div class="building-shell">
    {% include "partials/breadcrumbs.njk" %}

    <div class="building-hero">
      <div class="building-card">
        <div class="eyebrow">{% if buildingBrief %}Building Brief{% else %}Building{% endif %}</div>
        <h1>{{ buildingBriefName }}</h1>
        {% if buildingBrief %}
          <p class="building-hero-address">{{ building.address }} · {% if buildingBriefArea %}<a href="{{ buildingBriefArea.path }}">{{ buildingBriefArea.name }}</a>, {% endif %}{{ building.city }}, {{ building.state_abbr }}</p>
          <p class="lead">{{ buildingBrief.summary }}</p>
        {% elseif building.building_description %}
          <p class="lead">{{ building.building_description }}</p>
        {% else %}
          <p class="lead">
            {{ building.address }} is a {{ building.type | lower }} property in {{ building.city }}, {{ building.state_abbr }}.
          </p>
        {% endif %}
        {% if building.has_availability and not isRepresentativeBuilding %}
          <p class="lead">This building currently appears to have available space based on recent market data.</p>
        {% endif %}

        <div class="pill-row">
          <span class="pill">{{ building.type }}</span>
          {% if building.primary_space_type and building.primary_space_type != building.type %}
            <span class="pill">{{ building.primary_space_type }}</span>
          {% endif %}
          {% if building.commercial_asset_class %}
            <span class="pill">{{ building.commercial_asset_class }}</span>
          {% endif %}
          {% if building.editorial_role %}
            <span class="pill">{{ building.editorial_role }}</span>
          {% endif %}
          {% if building.size_label %}
            <span class="pill">{{ building.size_label }}</span>
          {% endif %}
          {% if building.has_availability and not isRepresentativeBuilding %}
            <span class="pill">Availability signal</span>
          {% endif %}
          {% if buildingBriefArea %}
            <a class="pill" href="{{ buildingBriefArea.path }}">Located in {{ buildingBriefArea.name }}</a>
          {% endif %}
          <span class="pill">{{ building.city }}, {{ building.state_abbr }}</span>
        </div>

        <div class="building-hero-actions">
          <a class="btn-primary" href="{{ buildingStartSearchUrl }}">Start Your Search</a>
        </div>
      </div>

      <div class="building-sidecard">
        <div class="hero-media">
          <img
            class="hero-image"
            src="{{ building.hero_image or placeholderSrc }}"
            alt="{{ building.address or building.display_name or building.name }} in {{ building.city }}, {{ building.state_abbr }}"
            width="1600"
            height="900"
            decoding="async"
            fetchpriority="high"
            loading="eager"
          />
          <div class="hero-overlay">
            <p class="hero-overlay-title">{{ building.address }}</p>
            <p class="hero-overlay-meta">{{ building.type }} · {{ building.city }}, {{ building.state_abbr }}</p>
          </div>
        </div>
      </div>
    </div>

    {% if isRepresentativeBuilding %}
      {% if buildingBrief %}
        {% include "partials/building/brief-journey.njk" %}
      {% else %}
      <div class="representative-building-journey">
        <section class="representative-building-section representative-building-section--opening building-decision-card--opening">
          <div class="eyebrow">Shortlist Decision</div>
          <h2>Why businesses evaluate this building</h2>
          {% if building.shortlist_reason %}
            <p class="building-decision-lead">{{ building.shortlist_reason }}</p>
          {% elif building.building_description %}
            <p class="building-decision-lead">{{ building.building_description }}</p>
          {% endif %}
        </section>

        <section class="representative-building-section representative-building-section--grouped building-fit-card">
          <div class="eyebrow">Fit</div>
          <h2>Is this building likely to fit?</h2>
          <div class="building-fit-grid">
            {% if building.best_for and building.best_for.length %}
              <div class="building-fit-panel building-fit-panel--positive">
                <h3>Good fit for</h3>
                <ul class="mini-list">
                  {% for item in building.best_for %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            {% if building.less_suitable_for and building.less_suitable_for.length %}
              <div class="building-fit-panel">
                <h3>May be less suitable for</h3>
                <ul class="mini-list">
                  {% for item in building.less_suitable_for %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        </section>

        {% if (building.strengths and building.strengths.length) or (building.tradeoffs and building.tradeoffs.length) %}
          <section class="representative-building-section representative-building-section--grouped building-decision-card">
            <div class="eyebrow">Tradeoffs</div>
            <h2>Strengths and tradeoffs</h2>
            <div class="building-decision-grid">
              {% if building.strengths and building.strengths.length %}
                <div class="building-decision-panel">
                  <h3>Strengths</h3>
                  <ul class="mini-list">
                    {% for item in building.strengths %}
                      <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}

              {% if building.tradeoffs and building.tradeoffs.length %}
                <div class="building-decision-panel">
                  <h3>Tradeoffs</h3>
                  <ul class="mini-list">
                    {% for item in building.tradeoffs %}
                      <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </div>
          </section>
        {% endif %}

        {% if building.validation_questions and building.validation_questions.length %}
          <section class="representative-building-section representative-building-section--grouped building-validation-card">
            <div class="eyebrow">Validate</div>
            <h2>What to validate before adding it to your shortlist</h2>
            <ul class="building-question-list">
              {% for item in building.validation_questions %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        {% if building.related_buildings and building.related_buildings.length %}
          <section class="representative-building-section representative-building-section--grouped building-comparison-card">
            <div class="eyebrow">Compare</div>
            <h2>What businesses often compare</h2>
            <p>Use nearby buildings and district alternatives to understand what this option solves, where it creates friction, and whether another format may fit better.</p>

            <div class="related-building-list">
              {% for related in building.related_buildings %}
                {% if loop.index <= 4 %}
                  <a class="related-building-card" href="{{ related.building_path }}">
                    <span class="related-building-card__title">{{ related.display_name or related.address }}</span>
                    <span class="related-building-card__meta">
                      Compare this option for a different building format, address signal, or nearby tradeoff in {{ building.city }}.
                    </span>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% if relatedComparisonPaths and relatedComparisonPaths.length %}
          <section class="representative-building-section representative-building-section--grouped building-comparison-card">
            <div class="eyebrow">Related comparisons</div>
            <h2>Compare this building against nearby options</h2>
            <div class="related-building-list">
              {% for comparisonPath in relatedComparisonPaths %}
                {% set relatedComparison = commercialBuildingComparisons.byPath[comparisonPath] %}
                {% if relatedComparison and loop.index <= 3 %}
                  <a class="related-building-card" href="{{ relatedComparison.path }}">
                    <span class="related-building-card__title">{{ relatedComparison.short_title }}</span>
                    <span class="related-building-card__meta">Compare another {{ building.commercial_area.name if building.commercial_area else building.city }} option with a different address, amenity, or workplace tradeoff.</span>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% if building.location_context or building.district_relationship or building.commercial_area %}
          <section class="representative-building-section representative-building-section--editorial building-district-card">
            <div class="eyebrow">District</div>
            <h2>
              {% if building.commercial_area %}
                How this building fits into {{ building.commercial_area.name }}
              {% else %}
                How this building fits into {{ building.city }}
              {% endif %}
            </h2>
            {% if building.district_relationship %}
              <p>{{ building.district_relationship }}</p>
            {% elif building.location_context %}
              <p>{{ building.location_context }}</p>
            {% endif %}

            {% if building.commercial_area %}
              <a class="building-link" href="{{ building.commercial_area.path }}">Return to {{ building.commercial_area.name }}</a>
            {% endif %}

            {% if building.nearby_alternatives and building.nearby_alternatives.length %}
              <div class="building-nearby-links">
                <h3>Nearby districts to compare</h3>
                <div class="building-next-link-grid">
                  {% for alternative in building.nearby_alternatives %}
                    <a class="related-building-card" href="{{ alternative.url }}">
                      <span class="related-building-card__title">{{ alternative.label }}</span>
                      <span class="related-building-card__meta">Compare the district tradeoff before narrowing the building shortlist.</span>
                    </a>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          </section>
        {% endif %}

        {% if relatedHandbookTopics and relatedHandbookTopics.length %}
          <section class="representative-building-section representative-building-section--grouped building-handbook-card">
            <div class="eyebrow">Decision Guide</div>
            <h2>What to understand before deciding</h2>
            <div class="related-building-list">
              {% for topic in relatedHandbookTopics %}
                {% if loop.index <= 3 %}
                  <a class="related-building-card" href="{{ topic.url }}">
                    <span class="related-building-card__title">{{ topic.title }}</span>
                    <span class="related-building-card__meta">{{ topic.summary }}</span>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <section class="representative-building-section representative-building-section--editorial representative-building-explainer">
          <div class="eyebrow">Rofo Context</div>
          <h2>Why this building appears on Rofo</h2>
          <p>
            Rofo uses representative buildings to make commercial location decisions more concrete. They help explain what a district feels like in practice and what types of buildings businesses may compare.
          </p>
          <p>
            Current availability changes over time. This page is decision support, not an advertisement for available space.
          </p>
        </section>

        <section class="representative-building-section representative-building-section--action building-continue-search">
          <div class="eyebrow">Next</div>
          <h2>Continue Your Search</h2>
          <p>Use this building as a reference point, then compare the district, nearby alternatives, and questions that still need validation.</p>

          <div class="building-next-link-grid">
            {% if building.commercial_area %}
              <a class="related-building-card" href="{{ building.commercial_area.path }}">
                <span class="related-building-card__title">Return to {{ building.commercial_area.name }}</span>
                <span class="related-building-card__meta">Review why this district may or may not fit the search.</span>
              </a>
            {% endif %}

            {% if building.commercial_area %}
              <a class="related-building-card" href="{{ building.commercial_area.path }}">
                <span class="related-building-card__title">Compare other representative buildings</span>
                <span class="related-building-card__meta">See other building examples that explain {{ building.commercial_area.name }}.</span>
              </a>
            {% endif %}

            {% for comparisonPath in relatedComparisonPaths %}
              {% set relatedComparison = commercialBuildingComparisons.byPath[comparisonPath] %}
              {% if relatedComparison and loop.index <= 2 %}
                <a class="related-building-card" href="{{ relatedComparison.path }}">
                  <span class="related-building-card__title">{{ relatedComparison.short_title }}</span>
                  <span class="related-building-card__meta">Compare this building with another option before narrowing the shortlist.</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </section>

        <section class="representative-building-section representative-building-section--quiet building-help-card">
          <div class="eyebrow">Optional</div>
          <h2>Need more than the initial analysis?</h2>
          <p>
            Depending on the market and requirements, additional building examples, market comparisons, deeper location analysis, or local introductions may be available.
          </p>
          <ul class="mini-list">
            <li>Request additional building examples when coverage supports it</li>
            <li>Compare nearby markets or districts before touring</li>
            <li>Explore local expert help when available</li>
          </ul>
        </section>

        <section class="representative-building-section representative-building-section--details building-details-card">
          <div class="eyebrow">Details</div>
          <h2>Property details</h2>

          <div class="detail-list detail-list--compact">
            <div class="detail-row">
              <div class="detail-label">Address</div>
              <div class="detail-value">{{ building.address }}</div>
            </div>

            {% if building.type %}
              <div class="detail-row">
                <div class="detail-label">Type</div>
                <div class="detail-value">{{ building.type }}</div>
              </div>
            {% endif %}

            {% if building.commercial_area %}
              <div class="detail-row">
                <div class="detail-label">District</div>
                <div class="detail-value">{{ building.commercial_area.name }}</div>
              </div>
            {% endif %}

            <div class="detail-row">
              <div class="detail-label">Market</div>
              <div class="detail-value">{{ building.city }}, {{ building.state_abbr }}</div>
            </div>
          </div>
        </section>

        {% set productTransitionVariant = "building" %}
        {% set productTransitionCtaUrl = "/find-locations/?city=" + (building.city | urlencode) + "&state=" + building.state_abbr %}
        {% include "partials/building/product-transition-card.njk" %}
        {% set productTransitionVariant = "" %}
        {% set productTransitionCtaUrl = "" %}
      </div>
      {% endif %}
    {% else %}
    <div class="stats-grid">
      <div class="building-stat">
        <div class="stat-label">Address</div>
        <div class="stat-value">{{ building.address }}</div>
        <p class="stat-note">Property location</p>
      </div>

      <div class="building-stat">
        <div class="stat-label">Type</div>
        <div class="stat-value">{{ building.type }}</div>
        <p class="stat-note">Property category</p>
      </div>

      <div class="building-stat">
        <div class="stat-label">Typical Space</div>
        <div class="stat-value">{{ building.size_label }}</div>
        <p class="stat-note">Common suite configuration</p>
      </div>

      <div class="building-stat">
        <div class="stat-label">Market</div>
        <div class="stat-value">{{ building.city }}</div>
        <p class="stat-note">{{ building.state_abbr }}</p>
      </div>
    </div>

    <div class="building-main">
      <div class="stack">
        <div class="building-card">
          <div class="eyebrow">Overview</div>
          <h2>About {{ building.address }}</h2>
          {% if building.about_context %}
            <p>{{ building.about_context }}</p>
          {% else %}
            <p>This property reflects the types of commercial environments commonly found in the {{ building.city }} market.</p>
          {% endif %}
          {% if building.virtual_tour_url %}
            <a class="building-link" href="{{ building.virtual_tour_url }}">View virtual tour</a>
          {% endif %}
        </div>

        {% if building.ecosystem_context %}
          <section class="building-card">
            <div class="eyebrow">Commercial Environment</div>
            <h2>{{ building.ecosystem_context.profile_label }}</h2>
            <p>{{ building.ecosystem_context.environment_sentence }}</p>
            {% if building.ecosystem_context.space_types and building.ecosystem_context.space_types.length %}
              <div class="semantic-chip-row">
                {% for item in building.ecosystem_context.space_types %}
                  <span class="semantic-chip">{{ item.label }}</span>
                {% endfor %}
              </div>
            {% endif %}
            <p class="semantic-footnote">Commercial context does not indicate current availability.</p>
          </section>
        {% endif %}

        {% if semanticEnvironment and semanticEnvironment.building_path == building.building_path %}
          <section class="building-card semantic-building-card">
            <div class="eyebrow">Building Environment</div>
            <h2>Building Environment</h2>
            <div class="semantic-chip-row">
              {% for label in semanticEnvironment.signal_labels %}
                <span class="semantic-chip">{{ label }}</span>
              {% endfor %}
            </div>
            <p>{{ semanticEnvironment.context_sentence }}</p>
            <p class="semantic-footnote">Historical signals do not indicate current availability.</p>
          </section>
        {% endif %}

        {% if building.best_for and building.best_for.length %}
          <section class="building-card">
            <div class="eyebrow">Best For</div>
            <h2>Who this property may work well for</h2>
            <ul class="mini-list">
              {% for item in building.best_for %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        {% if building.location_context %}
          <section class="building-card">
            <div class="eyebrow">Location Context</div>
            <h2>Where this property fits in {{ building.city }}</h2>
            {% if building.commercial_area %}
              <p>
                Located in <a class="building-link" href="{{ building.commercial_area.path }}">{{ building.commercial_area.name }}</a>, this property can also be reviewed within the surrounding {{ building.commercial_area.area_type | replace("_", " ") }} context.
              </p>
            {% endif %}
            <p>{{ building.location_context }}</p>
          </section>
        {% endif %}

        {% if isRepresentativeBuilding and (building.shortlist_reason or (building.strengths and building.strengths.length) or (building.tradeoffs and building.tradeoffs.length) or (building.validation_questions and building.validation_questions.length)) %}
          <section class="building-card building-decision-card">
            <div class="eyebrow">Shortlist Context</div>
            <h2>Why businesses evaluate this building</h2>
            {% if building.shortlist_reason %}
              <p>{{ building.shortlist_reason }}</p>
            {% endif %}

            <div class="building-decision-grid">
              {% if building.building_character %}
                <div class="building-decision-panel">
                  <h3>Building character</h3>
                  <p>{{ building.building_character }}</p>
                </div>
              {% endif %}

              {% if building.typical_tenant_profile %}
                <div class="building-decision-panel">
                  <h3>Common fit</h3>
                  <p>{{ building.typical_tenant_profile }}</p>
                </div>
              {% endif %}
            </div>

            {% if building.strengths and building.strengths.length %}
              <div class="building-decision-list">
                <h3>Strengths to consider</h3>
                <ul class="mini-list">
                  {% for item in building.strengths %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            {% if building.tradeoffs and building.tradeoffs.length %}
              <div class="building-decision-list">
                <h3>Tradeoffs to validate</h3>
                <ul class="mini-list">
                  {% for item in building.tradeoffs %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            {% if building.validation_questions and building.validation_questions.length %}
              <div class="building-decision-list">
                <h3>Questions to validate before touring</h3>
                <ul class="mini-list">
                  {% for item in building.validation_questions %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </section>
        {% endif %}

        {% set buildingSpaceTypeKey = building.state_abbr + "/" + building.city_slug + "/" + building.space_type_slug %}
        {% if building.space_type_url and spaceTypePageLookup[buildingSpaceTypeKey] %}
          <section class="building-card">
            <div class="eyebrow">Related Market</div>
            <h2>Explore similar space in {{ building.city }}</h2>
            <p>Browse {{ building.space_type_label | lower }} across {{ building.city }} to compare nearby options in the market.</p>
            <a class="building-link" href="{{ building.space_type_url }}">View {{ building.space_type_label | lower }} in {{ building.city }}</a>
          </section>
        {% endif %}

        {% if building.city_market_guide_url %}
          <section class="building-card">
            <div class="eyebrow">Market Guide</div>
            <h2>{{ building.city }} Commercial Real Estate Guide</h2>
            <p>Review broader market context, nearby markets, and space-type options before comparing buildings in {{ building.city }}.</p>
            <a class="building-link" href="{{ building.city_market_guide_url }}">Read the {{ building.city }} market guide</a>
          </section>
        {% endif %}

        {% if building.related_buildings and building.related_buildings.length %}
          <section class="building-card">
            <div class="eyebrow">Similar Buildings</div>
            <h2>Similar buildings in {{ building.city }}</h2>
            <p>Compare other buildings in {{ building.city }}{% if building.space_type_label %}, starting with {{ building.space_type_label | lower }} where available{% endif %}.</p>

            <div class="related-building-list">
              {% for related in building.related_buildings %}
                <a class="related-building-card" href="{{ related.building_path }}">
                  <span class="related-building-card__title">{{ related.display_name or related.address }}</span>
                  <span class="related-building-card__meta">
                    {{ related.type }}{% if related.size_label %} · {{ related.size_label }}{% endif %}
                  </span>
                </a>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <div class="building-card">
          <div class="eyebrow">Property Details</div>
          <h2>Building information</h2>

          <div class="detail-list">
            <div class="detail-row">
              <div class="detail-label">Address</div>
              <div class="detail-value">{{ building.address }}</div>
            </div>

            <div class="detail-row">
              <div class="detail-label">Property Type</div>
              <div class="detail-value">{{ building.type }}</div>
            </div>

            <div class="detail-row">
              <div class="detail-label">Typical Space</div>
              <div class="detail-value">{{ building.size_label }}</div>
            </div>

            <div class="detail-row">
              <div class="detail-label">Market</div>
              <div class="detail-value">{{ building.city }}, {{ building.state_abbr }}</div>
            </div>

            {% if building.common_fit or building.detail_summary %}
              <div class="detail-row">
                <div class="detail-label">Common Fit</div>
                <div class="detail-value">{{ building.common_fit or building.detail_summary }}</div>
              </div>
            {% endif %}
          </div>
        </div>

{% include "partials/building/building-guidance-card.njk" %}

        {% if isRepresentativeBuilding %}
          <section class="building-card representative-building-explainer">
            <div class="eyebrow">Rofo Context</div>
            <h2>Why this building appears on Rofo</h2>
            <p>
              Representative buildings are selected because they help explain the character of a district and the types of commercial environments businesses commonly evaluate.
            </p>
            <p>
              Current availability changes over time. These pages are intended to support better location decisions rather than advertise available space.
            </p>
          </section>

          <section class="building-card building-continue-search">
            <div class="eyebrow">Continue</div>
            <h2>Continue Your Search</h2>
            <p>
              Use this building as one reference point, then compare the surrounding district, nearby alternatives, and the leasing questions that still need validation.
            </p>

            <div class="building-next-link-grid">
              {% if building.commercial_area %}
                <a class="related-building-card" href="{{ building.commercial_area.path }}">
                  <span class="related-building-card__title">Return to {{ building.commercial_area.name }}</span>
                  <span class="related-building-card__meta">Review the district context behind this building.</span>
                </a>
              {% endif %}

              {% if building.nearby_alternatives and building.nearby_alternatives.length %}
                {% for alternative in building.nearby_alternatives %}
                  {% if loop.index <= 2 %}
                    <a class="related-building-card" href="{{ alternative.url }}">
                      <span class="related-building-card__title">Compare {{ alternative.label }}</span>
                      <span class="related-building-card__meta">Pressure-test whether a nearby district solves the same need.</span>
                    </a>
                  {% endif %}
                {% endfor %}
              {% endif %}

              {% if building.commercial_area %}
                <a class="related-building-card" href="{{ building.commercial_area.path }}">
                  <span class="related-building-card__title">View additional representative buildings</span>
                  <span class="related-building-card__meta">See other examples that help explain {{ building.commercial_area.name }}.</span>
                </a>
              {% endif %}

              {% for topic in relatedHandbookTopics %}
                {% if loop.index <= 2 %}
                  <a class="related-building-card" href="{{ topic.url }}">
                    <span class="related-building-card__title">{{ topic.title }}</span>
                    <span class="related-building-card__meta">{{ topic.summary }}</span>
                  </a>
                {% endif %}
              {% endfor %}

              {% for comparisonPath in relatedComparisonPaths %}
                {% set relatedComparison = commercialBuildingComparisons.byPath[comparisonPath] %}
                {% if relatedComparison and loop.index <= 2 %}
                  <a class="related-building-card" href="{{ relatedComparison.path }}">
                    <span class="related-building-card__title">{{ relatedComparison.short_title }}</span>
                    <span class="related-building-card__meta">Compare this building with another option before narrowing the shortlist.</span>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </section>

          {% set productTransitionVariant = "building" %}
          {% set productTransitionCtaUrl = "/find-locations/?city=" + (building.city | urlencode) + "&state=" + building.state_abbr %}
          {% include "partials/building/product-transition-card.njk" %}
          {% set productTransitionVariant = "" %}
          {% set productTransitionCtaUrl = "" %}
        {% else %}
          <div class="building-card">
            <div class="eyebrow">Next Step</div>
            <h2>Explore more in {{ building.city }}</h2>
            <p>
              Continue browsing the broader {{ building.city }} market to compare buildings and nearby opportunities.
            </p>

            <a class="btn-secondary" href="/commercial-real-estate/{{ building.state_abbr }}/{{ building.city_slug }}/">
              Back to {{ building.city }} Market
            </a>
          </div>
        {% endif %}
      </div>

      <div class="stack">
        {% if isRepresentativeBuilding %}
          <aside class="building-card building-help-card">
            <div class="eyebrow">Optional Help</div>
            <h2>Need additional help?</h2>
            <p>
              Depending on market coverage, Rofo may be able to help with additional representative buildings, market comparisons, detailed location analysis, or introductions to local experts when available.
            </p>
            <ul class="mini-list">
              <li>Additional representative building context</li>
              <li>Market and district comparisons</li>
              <li>Detailed location analysis</li>
              <li>Local expert introductions when available</li>
            </ul>
            <a class="btn-secondary" href="/find-locations/">Start Your Search</a>
          </aside>

          {% if relatedHandbookTopics and relatedHandbookTopics.length %}
            <aside class="building-card building-handbook-card">
              <div class="eyebrow">Leasing Guide</div>
              <h2>Questions this building raises</h2>
              <div class="related-building-list">
                {% for topic in relatedHandbookTopics %}
                  <a class="related-building-card" href="{{ topic.url }}">
                    <span class="related-building-card__title">{{ topic.title }}</span>
                    <span class="related-building-card__meta">{{ topic.summary }}</span>
                  </a>
                {% endfor %}
              </div>
            </aside>
          {% endif %}
        {% else %}
          <div class="building-form">
  <form
    action="/api/leads/submit"
    method="POST"
  >
    <div class="eyebrow">Get Help</div>
    <h2>Want options like this?</h2>
    <p>
      We’ll help you find similar spaces or better options nearby.
    </p>

    <input type="text" name="_gotcha" style="display:none">
    <input type="text" name="company_website" style="display:none;">
    <input type="hidden" name="form_start_time" value="">
    <script>
      document.currentScript.previousElementSibling.value = Date.now();
    </script>
    <input type="hidden" name="source" value="rofo-building-page" />
    <input type="hidden" name="lead_type" value="building" />
    <input type="hidden" name="page_type" value="building" />
    <input type="hidden" name="page_url" value="{{ metadata.siteUrl }}{{ page.url }}" />
    <input type="hidden" name="rofo_source" value="{{ metadata.siteUrl }}{{ page.url }}" />

    <input type="hidden" name="building_name" value="{{ building.display_name or building.name or '' }}" />
    <input type="hidden" name="building_address" value="{{ building.address or '' }}" />
    <input type="hidden" name="building_slug" value="{{ building.building_slug or '' }}" />

    <input type="hidden" name="city" value="{{ building.city or '' }}" />
    <input type="hidden" name="state" value="{{ building.state_abbr or '' }}" />
    <input type="hidden" name="market" value="{{ building.city or '' }}, {{ building.state_abbr or '' }}" />
    <input type="hidden" name="space_type" value="{{ building.primary_type_label or building.type or '' }}" />

    <input type="hidden" name="primary_source" value="{{ building.primary_source or '' }}" />
    <input type="hidden" name="building_company" value="{{ building.company or building.primary_source or '' }}" />
    <input type="hidden" name="building_source_companies" value="{{ (building.source_companies or []) | join(', ') }}" />
    <input type="hidden" name="building_space_types" value="{{ (building.space_types or []) | join(', ') }}" />
    <input type="hidden" name="is_exec_suite_present" value="{{ building.is_exec_suite_present or false }}" />
    {% if building.commercial_area %}
      <input type="hidden" name="neighborhood_name" value="{{ building.commercial_area.name or '' }}" />
      <input type="hidden" name="neighborhood_slug" value="{{ building.commercial_area.slug or '' }}" />
      <input type="hidden" name="neighborhood_path" value="{{ building.commercial_area.path or '' }}" />
      <input type="hidden" name="commercial_area_id" value="{{ building.commercial_area.id or '' }}" />
      <input type="hidden" name="commercial_area_type" value="{{ building.commercial_area.area_type or '' }}" />
    {% endif %}

    <input type="hidden" name="routing_candidates" value="{{ building.routing_candidates | join(',') }}" />
    <input type="hidden" name="routing_market" value="{{ building.routing_market }}" />
    <input type="hidden" name="routing_county" value="{{ building.routing_county }}" />
    <input type="hidden" name="routing_space_type" value="{{ building.routing_space_type }}" />
    <input type="hidden" name="routing_key" value="{{ (building.primary_source or 'unknown') | lower }}__{{ building.city_slug or '' }}__{{ (building.type or 'unknown') | lower }}" />

      <div class="form-stack">
        <div class="field">
          <label for="building-lead-name">Name</label>
          <input
            id="building-lead-name"
            name="name"
            type="text"
            placeholder="Your name"
            required
          >
        </div>
      </div>

      <div class="form-stack">
        <div class="field">
          <label for="building-lead-email">Email</label>
          <input
            id="building-lead-email"
            name="email"
            type="email"
            placeholder="Your email"
            required
          >
        </div>
      </div>

      <div class="form-stack">
        <div class="field">
          <label for="building-lead-phone">Phone</label>
          <input
            id="building-lead-phone"
            name="phone"
            type="tel"
            placeholder="Your phone number"
            required
          >
        </div>
      </div>

      <div class="form-stack">
        <div class="field">
          <label for="building-lead-requested-type">What type of space do you need?</label>
          <select
            id="building-lead-requested-type"
            name="requested_space_type"
            required
          >
            <option value="">Select one</option>
            <option>Office Space</option>
            <option>Retail Space</option>
            <option>Industrial Space</option>
            <option>Coworking Space</option>
            <option>Flex Space</option>
            <option>Not Sure</option>
          </select>
        </div>
      </div>

      <div class="form-stack">
        <div class="field">
          <label for="building-lead-size">Space size</label>
          <select
            id="building-lead-size"
            name="space_needed"
            required
          >
            <option value="">Select one</option>
            <option>Under 1,000 sqft</option>
            <option>1,000–2,500 sqft</option>
            <option>2,500–5,000 sqft</option>
            <option>5,000–10,000 sqft</option>
            <option>10,000+ sqft</option>
            <option>Not Sure</option>
          </select>
        </div>
      </div>

      <div class="form-stack">
        <div class="field">
          <label for="building-lead-type">Page space type</label>
          <input
            id="building-lead-type"
            type="text"
            value="{{ building.type }}"
            disabled
          >
        </div>
      </div>

      <div class="form-stack">
        <div class="field">
          <label for="building-lead-notes">Other requirements for your space</label>
          <textarea
            id="building-lead-notes"
            name="notes"
            placeholder="Example: 2–4 person office, move in May, flexible budget"
          ></textarea>
        </div>
      </div>

      <div class="btn-row">
        <label>
          <input type="checkbox" name="human_check" required>
          I’m a real person looking for space
        </label>
        <button class="btn-primary" type="submit">Get Options Like This</button>
      </div>

    <p class="form-note">✓ No cost • ✓ No obligation • ✓ Local Expertise</p>
  </form>
</div>
        {% endif %}

        <div class="building-card">
          <div class="eyebrow">Why Rofo</div>
          <h2>Commercial real estate discovery</h2>
          <p>
            Rofo helps businesses explore markets, compare buildings, and narrow their search more efficiently.
          </p>

          <ul class="mini-list">
            <li>Explore markets quickly</li>
            <li>Compare buildings</li>
            <li>Evaluate nearby options</li>
            <li>Get help finding the right space</li>
          </ul>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</section>
