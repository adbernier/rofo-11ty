---
layout: base.njk
fieldPhotosPublic: true
pagination:
  data: cities
  size: 1
  alias: city
permalink: "/commercial-real-estate/{{ city.state_abbr }}/{{ city.slug }}/index.html"
eleventyComputed:
  title: >
    {% if city.seo_title %}
      {{ city.seo_title }}
    {% else %}
      Commercial Real Estate in {{ city.city }}, {{ city.state_abbr }} | Rofo
    {% endif %}
  description: >
    {% if city.seo_description %}
      {{ city.seo_description }}
    {% else %}
      Find the right commercial location in {{ city.city }}, {{ city.state_abbr }}. Compare areas, understand tradeoffs, review representative buildings, and start the search with more confidence.
    {% endif %}
---
{% set stateName = stateNames[city.state_abbr] or city.state_abbr %}
{% set crumbs = [
  { "label": "Markets", "url": "/markets/" },
  { "label": stateName, "url": "/commercial-real-estate/" + city.state_abbr + "/" },
  { "label": city.city + ", " + city.state_abbr, "url": page.url }
] %}
{% set isSanFranciscoDecisionJourney = city.slug == "san-francisco" and city.state_abbr == "CA" %}
{% set commercialKnowledgeSnapshot = city.commercial_knowledge_snapshot or {} %}

{% set cityBuildings = [] %}
{% for b in buildingPages %}
  {% if b.city_slug == city.slug and b.state_abbr == city.state_abbr %}
    {% set cityBuildings = (cityBuildings.push(b), cityBuildings) %}
  {% endif %}
{% endfor %}
{% set cityLocationFragments = cityBuildings | cityStreetFragments %}
{% set availableSpaceTypes = [] %}
{% set citySpaceTypeLinks = [
  { "slug": "office-space", "label": "Office space", "search": "Office space for lease in " + city.city },
  { "slug": "retail-space", "label": "Retail space", "search": "Retail space for lease in " + city.city },
  { "slug": "industrial-space", "label": "Industrial space", "search": "Industrial space in " + city.city },
  { "slug": "flex-space", "label": "Flex space", "search": "Flex space in " + city.city },
  { "slug": "coworking-space", "label": "Coworking space", "search": "Coworking space in " + city.city }
] %}
{% for item in citySpaceTypeLinks %}
  {% set pageKey = (city.state_abbr | upper) + "/" + (city.slug | lower) + "/" + item.slug %}
  {% if spaceTypePageLookup[pageKey] %}
    {% set availableSpaceTypes = (availableSpaceTypes.push(item), availableSpaceTypes) %}
  {% endif %}
{% endfor %}
{% set cityMarketGuides = [] %}
{% for item in citySpaceTypeLinks %}
  {% set guideKey = (city.state_abbr | upper) + "/" + (city.slug | lower) + "/" + item.slug %}
  {% if marketGuideLookup[guideKey] %}
    {% set cityMarketGuides = (cityMarketGuides.push(marketGuideLookup[guideKey]), cityMarketGuides) %}
  {% endif %}
{% endfor %}
{% set cityMarketGuideKey = (city.state_abbr | upper) + "/" + (city.slug | lower) + "/" %}
{% set cityMarketGuide = marketGuideLookup[cityMarketGuideKey] %}
{% set cityBusinessBriefs = [] %}
{% for brief in businessBriefs.briefs %}
  {% if brief.market.marketSlug == city.slug and brief.market.state == city.state_abbr and brief.propertyType == "office" and brief.isIndexable %}
    {% set cityBusinessBriefs = (cityBusinessBriefs.push(brief), cityBusinessBriefs) %}
  {% endif %}
{% endfor %}
{% set cityNeighborhoods = [] %}
{% for neighborhood in neighborhoodPages %}
  {% if neighborhood.city_slug == city.slug and neighborhood.state_abbr == city.state_abbr and not neighborhood.noindex %}
    {% set cityNeighborhoods = (cityNeighborhoods.push(neighborhood), cityNeighborhoods) %}
  {% endif %}
{% endfor %}
{% set cityEcosystemBuildings = [] %}
{% for building in ecosystemPublicBuildings %}
  {% if building.city_slug == city.slug and building.state_abbr == city.state_abbr %}
    {% set cityEcosystemBuildings = (cityEcosystemBuildings.push(building), cityEcosystemBuildings) %}
  {% endif %}
{% endfor %}
{% set snapshotItems = [] %}
{% set marketSnapshot = city.market_snapshot or {} %}
{% set snapshotTitle = marketSnapshot.snapshot_title or city.snapshot_title or "Market Snapshot" %}
{% if marketSnapshot.average_rent %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Average Rent", "value": marketSnapshot.average_rent, "note": marketSnapshot.average_rent_label, "direction": marketSnapshot.average_rent_direction }), snapshotItems) %}
{% elseif city.avg_rent %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Average Rent", "value": city.avg_rent, "note": city.avg_rent_label or city.average_rent_label, "direction": city.average_rent_direction }), snapshotItems) %}
{% elseif city.average_rent %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Average Rent", "value": city.average_rent, "note": city.average_rent_label, "direction": city.average_rent_direction }), snapshotItems) %}
{% endif %}
{% if marketSnapshot.availability_rate %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Availability", "value": marketSnapshot.availability_rate, "note": marketSnapshot.availability_label, "direction": marketSnapshot.availability_direction }), snapshotItems) %}
{% elseif city.availability_rate %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Availability", "value": city.availability_rate, "note": city.availability_label, "direction": city.availability_direction }), snapshotItems) %}
{% elseif city.vacancy_rate %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Availability", "value": city.vacancy_rate, "note": city.vacancy_label or city.vacancy_rate_label, "direction": city.availability_direction }), snapshotItems) %}
{% endif %}
{% if marketSnapshot.market_trend %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Market Trend", "value": marketSnapshot.market_trend, "note": marketSnapshot.market_trend_label, "direction": marketSnapshot.market_trend_direction }), snapshotItems) %}
{% elseif city.market_trend %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Market Trend", "value": city.market_trend, "note": city.market_trend_label, "direction": city.market_trend_direction }), snapshotItems) %}
{% endif %}
{% if marketSnapshot.notable_areas and marketSnapshot.notable_areas.length %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Notable Areas", "areas": marketSnapshot.notable_areas, "note": marketSnapshot.notable_areas_label }), snapshotItems) %}
{% elseif city.notable_areas and city.notable_areas.length %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Notable Areas", "areas": city.notable_areas, "note": city.notable_areas_label }), snapshotItems) %}
{% elseif city.trending_neighborhood %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Notable Areas", "value": city.trending_neighborhood, "note": city.trending_neighborhood_label }), snapshotItems) %}
{% elseif city.notable_neighborhood %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Notable Areas", "value": city.notable_neighborhood, "note": city.notable_neighborhood_label }), snapshotItems) %}
{% endif %}
{% set featuredBuildings = [] %}
{% for b in buildingPages %}
  {% if b.city_slug == city.slug and b.state_abbr == city.state_abbr and not b.featured_company_slug %}
    {% set featuredBuildings = (featuredBuildings.push(b), featuredBuildings) %}
  {% endif %}
{% endfor %}
{% set displayBuildings = featuredBuildings if featuredBuildings.length else cityBuildings %}
{% set editorialRepresentativeBuildings = [] %}
{% for building in cityBuildings %}
  {% if building.editorial_representative %}
    {% set editorialRepresentativeBuildings = (editorialRepresentativeBuildings.push(building), editorialRepresentativeBuildings) %}
  {% endif %}
{% endfor %}
{% if editorialRepresentativeBuildings.length %}
  {% set displayBuildings = editorialRepresentativeBuildings %}
{% endif %}
{% set cityLocationModelPath = "/commercial-real-estate/" + city.state_abbr + "/" + city.slug + "/" %}
{% set cityLocationModel = commercialLocationModel.byPath[cityLocationModelPath] %}
{% set cityInsights = [] %}
{% set cityOverviewInsights = [] %}
{% set cityHubInsights = [] %}
{% for insight in rofoInsights %}
  {% if insight.published and insight.relatedCityPage == cityLocationModelPath %}
    {% set cityInsights = (cityInsights.push(insight), cityInsights) %}
    {% if not insight.primaryDistrict %}
      {% set cityOverviewInsights = (cityOverviewInsights.push(insight), cityOverviewInsights) %}
    {% endif %}
    {% if insight.cityHubFeatured %}
      {% set cityHubInsights = (cityHubInsights.push(insight), cityHubInsights) %}
    {% endif %}
  {% endif %}
{% endfor %}
{% set cityLocationComparisons = [] %}
{% if cityLocationModel and cityLocationModel.compare_with and cityLocationModel.compare_with.length %}
  {% for comparison in cityLocationModel.compare_with %}
    {% if comparison.comparison_path %}
      {% set cityLocationComparisons = (cityLocationComparisons.push(comparison), cityLocationComparisons) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set cityComparisonPages = [] %}
{% for comparisonPage in locationComparisonPages %}
  {% if comparisonPage.city_slug == city.slug and comparisonPage.state_abbr == city.state_abbr %}
    {% set cityComparisonPages = (cityComparisonPages.push(comparisonPage), cityComparisonPages) %}
  {% endif %}
{% endfor %}
{% set searchProfileLocationSuggestions = [] %}
{% if cityNeighborhoods.length %}
  {% for neighborhood in cityNeighborhoods.slice(0, 6) %}
    {% set searchProfileLocationSuggestions = (searchProfileLocationSuggestions.push(neighborhood.name), searchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}
{% if cityLocationComparisons.length %}
  {% for comparison in cityLocationComparisons.slice(0, 6) %}
    {% set searchProfileLocationSuggestions = (searchProfileLocationSuggestions.push(comparison.district_name), searchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}
{% if city.nearby_cities and city.nearby_cities.length %}
  {% for nearby in city.nearby_cities.slice(0, 6) %}
    {% set searchProfileLocationSuggestions = (searchProfileLocationSuggestions.push(nearby.city), searchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}
{% set editorialDistrictMap = editorialDistrictMaps.byCityPath[page.url] %}
{% set hasAreaChapter = editorialDistrictMap or cityNeighborhoods.length or cityLocationComparisons.length or cityComparisonPages.length or (city.nearby_cities and city.nearby_cities.length) %}
{% set hasEducationChapter = true %}
{% set hasRepresentativeBuildingChapter = editorialRepresentativeBuildings.length %}
{% set hasLocalHelpChapter = true %}

<section class="city-page">
  <div class="city-shell">
    {% include "partials/breadcrumbs.njk" %}

    <div class="city-primary-layout city-primary-layout--single-column">
      <div class="city-primary-main">
        <div class="city-hero city-hero--content-only city-hero--decision-v2">
          <div class="city-card city-decision-hero">
            <div class="city-hero-copy">
              <div class="eyebrow">{{ city.city }} Commercial Real Estate</div>

              <h1>Commercial Real Estate in {{ city.city }}, {{ city.state_abbr }}</h1>

              {% set recommendationPromptContext = {
                "context_type": "city",
                "city": city.city,
                "state": city.state_abbr,
                "context_label": city.city,
                "page_url": page.url
              } %}
              {% include "partials/shared/recommendation-prompt-card.njk" %}
              {% set recommendationPromptContext = null %}

              <nav class="city-decision-anchor-nav" aria-label="{{ city.city }} commercial real estate guide">
                {% if hasAreaChapter %}<a href="#city-commercial-areas-heading">Explore Areas</a>{% endif %}
                {% if hasEducationChapter %}<a href="#city-what-to-expect-heading">What to Expect</a>{% endif %}
                {% if hasRepresentativeBuildingChapter %}<a href="#city-example-buildings-heading">Example Buildings</a>{% endif %}
                {% if hasLocalHelpChapter %}<a href="#city-local-help-heading">Local Help</a>{% endif %}
              </nav>
            </div>
          </div>
        </div>

        {% set fieldPhotoSubjectType = "city" %}
        {% set fieldPhotoSubjectId = city.city_state_slug or (city.slug + "-" + (city.state_abbr | lower)) %}
        {% set fieldPhotoPlacement = "city" %}
        {% include "partials/shared/editorial-photo-slot.njk" %}

        <div class="city-grid city-primary-content">
          {% if commercialKnowledgeSnapshot and commercialKnowledgeSnapshot.commercialCharacter %}
            <section class="city-decision-section city-decision-section--knowledge-snapshot" aria-labelledby="city-market-snapshot-heading">
              <div class="city-decision-section__header">
                <div class="eyebrow">Market Snapshot</div>
                <h2 id="city-market-snapshot-heading">{{ commercialKnowledgeSnapshot.title or (city.city + " Market Snapshot") }}</h2>
                <p>{{ commercialKnowledgeSnapshot.commercialCharacter }}</p>
              </div>

              <div class="city-knowledge-snapshot">
                {% if commercialKnowledgeSnapshot.businessDrivers and commercialKnowledgeSnapshot.businessDrivers.length %}
                  <div class="city-knowledge-snapshot__brief">
                    {% for driver in commercialKnowledgeSnapshot.businessDrivers %}
                      <p>{{ driver }}</p>
                    {% endfor %}
                  </div>
                {% endif %}

                {% if commercialKnowledgeSnapshot.propertyTypeContext %}
                  <div class="city-knowledge-snapshot__grid" aria-label="{{ city.city }} commercial property context">
                    {% for key, context in commercialKnowledgeSnapshot.propertyTypeContext %}
                      {% if context %}
                        <article>
                          <span>{{ key | title }}</span>
                          <p>{{ context }}</p>
                        </article>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                <div class="city-knowledge-snapshot__columns">
                  {% if commercialKnowledgeSnapshot.keyDistricts and commercialKnowledgeSnapshot.keyDistricts.length %}
                    <div>
                      <h3>Key Commercial Districts</h3>
                      <div class="city-knowledge-snapshot__links">
                        {% for district in commercialKnowledgeSnapshot.keyDistricts %}
                          <a href="{{ district.path }}">{{ district.label }}</a>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}

                  {% if commercialKnowledgeSnapshot.businessLocationContext and commercialKnowledgeSnapshot.businessLocationContext.length %}
                    <div>
                      <h3>Business Location Context</h3>
                      <ul>
                        {% for item in commercialKnowledgeSnapshot.businessLocationContext %}
                          <li>{{ item }}</li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}
                </div>

                {% if commercialKnowledgeSnapshot.cta %}
                  <div class="city-knowledge-snapshot__cta">
                    <p>Rofo can turn this market context into a personalized Location Brief based on your business.</p>
                    <a class="btn-primary" href="{{ commercialKnowledgeSnapshot.cta.href }}">{{ commercialKnowledgeSnapshot.cta.label }}</a>
                  </div>
                {% endif %}
              </div>
            </section>
          {% endif %}

          {% if hasAreaChapter %}
            <section class="city-decision-section city-decision-section--explore" aria-labelledby="city-commercial-areas-heading">
              <div class="city-decision-section__header">
                <div class="eyebrow">Where should I look?</div>
                <h2 id="city-commercial-areas-heading">Start with the Right {{ city.city }} Commercial Area</h2>
                <p>The district often shapes the decision before the building does. Start by comparing which areas fit the business model, customer access, employee commute patterns, budget, and next stage of growth.</p>
              </div>
              <div class="city-decision-flow city-decision-flow--commercial-areas">
          {% endif %}

          {% if hasAreaChapter %}
            {% include "partials/shared/editorial-district-map.njk" %}
          {% endif %}

          {% if cityNeighborhoods.length and not editorialDistrictMap %}
            <div class="city-card city-neighborhoods-card">
              <div class="eyebrow">Commercial areas</div>
              <h2>Compare {{ city.city }} districts and commercial areas</h2>
              <p>Use these areas as a starting point before you spend time evaluating individual buildings.</p>
              {% set visibleNeighborhoods = cityNeighborhoods.slice(0, 8) %}
              {% set hiddenNeighborhoods = cityNeighborhoods.slice(8) %}
              <div class="city-neighborhood-link-list">
                {% for neighborhood in visibleNeighborhoods %}
                  <a href="{{ neighborhood.canonical_neighborhood_path }}">{{ neighborhood.name }}</a>
                {% endfor %}
              </div>
              {% if hiddenNeighborhoods.length %}
                <details class="city-neighborhoods-all">
                  <summary>View more commercial areas</summary>
                  <div class="city-neighborhood-link-list city-neighborhood-link-list--all">
                    {% for neighborhood in hiddenNeighborhoods %}
                      <a href="{{ neighborhood.canonical_neighborhood_path }}">{{ neighborhood.name }}</a>
                    {% endfor %}
                  </div>
                </details>
              {% endif %}
            </div>
          {% endif %}

          {% if cityLocationComparisons.length or cityComparisonPages.length %}
            <div class="city-card city-location-comparisons-card city-support-module">
              <div class="eyebrow">Compare Commercial Areas</div>
              <h2>Tradeoffs worth checking early</h2>
              <p>Nearby districts can solve very different business problems. These comparisons show what changes when the search prioritizes image, transit, building character, flexibility, or cost.</p>
              <div class="neighborhood-comparison-grid">
                {% if cityLocationComparisons.length %}
                  {% for comparison in cityLocationComparisons %}
                    <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ comparison.comparison_path }}">
                      <h3>{{ city.city }} vs {{ comparison.district_name }}</h3>
                      <p>{{ comparison.reason }}</p>
                    </a>
                  {% endfor %}
                {% else %}
                  {% for comparison in cityComparisonPages.slice(0, 6) %}
                    <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ comparison.path }}">
                      <h3>{{ comparison.short_title or comparison.title }}</h3>
                      <p>
                        {% if comparison.comparison_notes and comparison.comparison_notes.length %}
                          {{ comparison.comparison_notes[0] }}
                        {% else %}
                          {{ comparison.verdict_a or comparison.lead_prompt }}
                        {% endif %}
                      </p>
                    </a>
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if city.nearby_cities and city.nearby_cities.length %}
            <div class="city-card city-nearby-markets-card city-support-module">
              <div class="eyebrow">Nearby commercial areas</div>
              <h2>Nearby markets may change the answer</h2>
              <p>If {{ city.city }} is not the only acceptable location, nearby markets can change the answer around cost, commute patterns, building format, and availability.</p>
              <div class="market-links">
                {% for nearby in city.nearby_cities %}
                  <a href="{{ nearby.path }}">{{ nearby.city }}, {{ nearby.state_abbr }}</a>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          {% if hasAreaChapter %}
              </div>
            </section>
          {% endif %}

          {% if hasEducationChapter %}
            <section class="city-decision-section city-decision-section--learn" aria-labelledby="city-what-to-expect-heading">
              <div class="city-decision-section__header">
                <div class="eyebrow">What should I expect?</div>
                <h2 id="city-what-to-expect-heading">What to Expect When Leasing Commercial Space in {{ city.city }}</h2>
                <p>Experienced tenants know that asking rent and availability are only part of the decision. Understand location strategy, timing, lease structure, and comparison criteria before tours start.</p>
              </div>
              <div class="city-learning-panel">
          {% endif %}

          {% set featuredInsight = cityOverviewInsights[0] or cityInsights[0] %}
          {% set insightList = cityOverviewInsights.concat(cityHubInsights) %}
          {% set moduleFeaturedInsight = featuredInsight or insightList[0] %}
          {% if moduleFeaturedInsight %}
            <div class="city-learning-feature" aria-labelledby="city-featured-insight-heading">
              <div class="eyebrow">Rofo Insight</div>
              <a class="city-learning-feature__link" href="/insights/{{ moduleFeaturedInsight.slug }}/">
                <span>{{ moduleFeaturedInsight.readingTime or moduleFeaturedInsight.readTime or "3 minute read" }}</span>
                <h3 id="city-featured-insight-heading">{{ moduleFeaturedInsight.title }}</h3>
                <p>{{ moduleFeaturedInsight.heroSummary or moduleFeaturedInsight.summary }}</p>
              </a>
            </div>
          {% endif %}

          <div class="city-learning-support">
            {% if insightList and insightList.length %}
              <div class="city-learning-links">
                <div class="eyebrow">What experienced tenants consider</div>
                <ul>
                  {% for relatedInsight in insightList.slice(0, 5) %}
                    {% if not moduleFeaturedInsight or relatedInsight.slug != moduleFeaturedInsight.slug %}
                      <li>
                        <a href="/insights/{{ relatedInsight.slug }}/">{{ relatedInsight.title }}</a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
                {% if isSanFranciscoDecisionJourney %}
                  <a class="building-link" href="{{ cityLocationModelPath }}insights/">Read more San Francisco location guidance →</a>
                {% endif %}
              </div>
            {% endif %}

          {% if cityMarketGuide %}
            <div class="city-card city-market-guide-card city-support-module city-learning-resource">
              <div class="eyebrow">Market context</div>
              <h2>Know the {{ city.city }} market before comparing buildings</h2>
              <p>
                Rent, availability, and neighborhood dynamics matter most when they are tied back to your business needs.
              </p>
              <a class="building-link" href="{{ cityMarketGuide.url }}">Review {{ city.city }} market context →</a>
            </div>
          {% endif %}

          {% if snapshotItems.length >= 2 %}
            <div class="city-card city-market-snapshot city-support-module">
              <div class="eyebrow">{{ snapshotTitle }}</div>
              <div class="city-market-snapshot__grid">
                {% for item in snapshotItems %}
                  <div class="city-market-snapshot__item">
                    <div class="stat-label">{{ item.label }}</div>
                    {% if item.areas and item.areas.length %}
                      <div class="stat-value stat-value--list">
                        {% for area in item.areas %}
                          <span>{{ area }}</span>
                        {% endfor %}
                      </div>
                    {% else %}
                      <div class="stat-value">
                        {{ item.value }}
                        {% if item.direction == "up" %}
                          <span class="stat-direction" aria-label="Up">↑</span>
                        {% elseif item.direction == "down" %}
                          <span class="stat-direction" aria-label="Down">↓</span>
                        {% elseif item.direction == "flat" %}
                          <span class="stat-direction" aria-label="Flat">→</span>
                        {% endif %}
                      </div>
                    {% endif %}
                    {% if item.note %}
                      <p class="stat-note">{{ item.note }}</p>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
              {% if city.market_snapshot_note %}
                <p>{{ city.market_snapshot_note }}</p>
              {% endif %}
            </div>
          {% endif %}

          {% if city.slug == "oceanside" and city.state_abbr == "CA" %}
            <aside class="city-card city-location-comparisons-card city-support-module" aria-labelledby="oceanside-industrial-decision-bridge-heading" data-experiment="oceanside-industrial-decision-bridge">
              <div class="eyebrow">North County Industrial Decisions</div>
              <h2 id="oceanside-industrial-decision-bridge-heading">Looking for Industrial Space in Oceanside?</h2>
              <p>Oceanside may fit contractors, service-commercial operations, smaller warehouse or flex requirements, and businesses prioritizing Highway 78 or coastal North County customer and employee geography. The right location depends on how the operation needs to function.</p>
              <div class="neighborhood-comparison-grid">
                <a class="neighborhood-comparison-card neighborhood-link-card" href="/commercial-real-estate/CA/oceanside/oceanside-industrial/">
                  <h3>Oceanside Industrial</h3>
                  <p>Explore the local path for practical operating space, service distribution, lighter industrial uses, and coastal North County access.</p>
                </a>
                <a class="neighborhood-comparison-card neighborhood-link-card" href="/commercial-real-estate/CA/vista/vista-business-park/">
                  <h3>Vista Business Park</h3>
                  <p>Consider Vista when deeper industrial and flex utility, manufacturing, loading and truck functionality, or warehouse depth matters more.</p>
                </a>
                <a class="neighborhood-comparison-card neighborhood-link-card" href="/commercial-real-estate/CA/carlsbad/carlsbad-business-park/">
                  <h3>Carlsbad Business Park</h3>
                  <p>Consider Carlsbad when engineering, technology, office/R&amp;D, office-production hybrids, or a more polished flex environment matters.</p>
                </a>
              </div>
              <div class="city-knowledge-snapshot__columns">
                <div>
                  <h3>Compare the tradeoffs</h3>
                  <div class="city-knowledge-snapshot__links">
                    <a href="/commercial-real-estate/CA/oceanside/oceanside-industrial-vs-vista-business-park/">Oceanside Industrial vs Vista Business Park</a>
                    <a href="/commercial-real-estate/CA/carlsbad/carlsbad-business-park-vs-oceanside-industrial/">Oceanside Industrial vs Carlsbad Business Park</a>
                  </div>
                </div>
                <div>
                  <h3>Validate the building</h3>
                  <p>District fit narrows the search. Verify loading, yard or outdoor storage, power, zoning and permitted use, building format, parking, and truck circulation at the property level.</p>
                </div>
              </div>
              <div class="city-knowledge-snapshot__cta">
                <p>Not sure whether Oceanside, Vista, or Carlsbad fits your operation?</p>
                <a class="btn-primary" href="/find-locations/?city=Oceanside&amp;state=CA&amp;spaceType=Industrial%20%2F%20Warehouse&amp;source=oceanside_industrial_decision_bridge">Get My Recommendation</a>
              </div>
            </aside>
          {% endif %}

          {% if city.slug == "antioch" and city.state_abbr == "CA" %}
            <aside class="city-card city-location-comparisons-card city-support-module" aria-labelledby="antioch-industrial-decision-bridge-heading" data-experiment="antioch-industrial-decision-bridge">
              <div class="eyebrow">East Contra Costa Industrial Decisions</div>
              <h2 id="antioch-industrial-decision-bridge-heading">Looking for Industrial Space in Antioch?</h2>
              <p>Antioch may fit local-serving contractors, service-industrial operations, storage or dispatch needs, smaller warehouse requirements, and selective office/warehouse users focused on East Contra Costa. Start with the local operating geography, then validate the property.</p>
              <div class="neighborhood-comparison-grid">
                <a class="neighborhood-comparison-card neighborhood-link-card" href="/commercial-real-estate/CA/antioch/antioch-east-18th-industrial/">
                  <h3>Antioch East 18th Industrial</h3>
                  <p>Review the source-supported local Industrial path, the requirements it may fit, its limitations, and the property questions that remain.</p>
                </a>
              </div>
              <div class="city-knowledge-snapshot__columns">
                <div>
                  <h3>When Antioch may fit</h3>
                  <p>Consider it when East Contra Costa customer, workforce, or service geography and practical local operations matter more than a broader regional logistics position.</p>
                </div>
                <div>
                  <h3>Validate the building</h3>
                  <p>District fit narrows the search. Verify loading, truck circulation, yard or outdoor storage, power, parking, permitted use, building format, and office/warehouse ratio at each property.</p>
                </div>
              </div>
              <div class="city-knowledge-snapshot__cta">
                <p>Not sure whether Antioch fits your operation?</p>
                <a class="btn-primary" href="/find-locations/?city=Antioch&amp;state=CA&amp;spaceType=Industrial%20%2F%20Warehouse&amp;source=antioch_industrial_decision_bridge">Get My Recommendation</a>
              </div>
            </aside>
          {% endif %}

          {% if city.slug == "aliso-viejo" and city.state_abbr == "CA" %}
            <aside class="city-card city-location-comparisons-card city-support-module" aria-labelledby="aliso-oc-decision-bridge-heading" data-experiment="aliso-oc-decision-bridge">
              <div class="eyebrow">Orange County Location Decisions</div>
              <h2 id="aliso-oc-decision-bridge-heading">Considering Locations Beyond Aliso Viejo?</h2>
              <p>Orange County is not one uniform commercial market. If your search can extend beyond Aliso Viejo, different South Orange County and Irvine environments may fit materially different operating requirements.</p>
              <div class="neighborhood-comparison-grid">
                <a class="neighborhood-comparison-card neighborhood-link-card" href="/commercial-real-estate/CA/irvine/irvine-spectrum/">
                  <h3>Irvine Spectrum</h3>
                  <p>Consider for corporate technology, R&amp;D, recruiting, growth, and a stronger campus environment.</p>
                </a>
                <a class="neighborhood-comparison-card neighborhood-link-card" href="/commercial-real-estate/CA/lake-forest/lake-forest-business-center/">
                  <h3>Lake Forest Business Park</h3>
                  <p>Consider for practical South Orange County flex, technical services, light industrial, and operational requirements.</p>
                </a>
                <a class="neighborhood-comparison-card neighborhood-link-card" href="/commercial-real-estate/CA/mission-viejo/mission-viejo/">
                  <h3>South OC Medical &amp; Professional</h3>
                  <p>Consider when patient or customer geography, medical or professional services, and South County access matter.</p>
                </a>
                <a class="neighborhood-comparison-card neighborhood-link-card" href="/commercial-real-estate/CA/irvine/irvine-business-complex/">
                  <h3>Irvine Business Complex</h3>
                  <p>Consider for airport access, professional services, client meetings, and central Orange County accessibility.</p>
                </a>
              </div>
              <div class="city-knowledge-snapshot__cta">
                <p>Not sure which Orange County location fits your business?</p>
                <a class="btn-primary" href="/find-locations/?city=Aliso%20Viejo&amp;state=CA&amp;source=aliso_oc_decision_bridge">Get My Recommendation</a>
              </div>
            </aside>
          {% endif %}

          <div class="city-card city-commercial-knowledge-card city-support-module">
            <div class="eyebrow">Commercial Leasing Guide</div>
            <h2>Know the questions before the tour</h2>
            <p>Lease structure, timing, tenant improvements, and broker roles can shape the real cost and risk of a space. Use these guides when the location is promising but the leasing details still need context.</p>
            <ul class="mini-list">
              <li><a href="/commercial-real-estate/lease-guide/choosing-the-right-commercial-location/">Choosing the right commercial location</a></li>
              <li><a href="/commercial-real-estate/lease-guide/how-to-compare-commercial-spaces/">How to compare commercial spaces</a></li>
              <li><a href="/commercial-real-estate/lease-guide/commercial-leasing-timeline/">Commercial leasing timeline</a></li>
              <li><a href="/commercial-real-estate/lease-guide/how-commercial-brokers-help/">How commercial brokers help</a></li>
            </ul>
          </div>

          {% if hasEducationChapter %}
              </div>
            </div>
          </section>
          {% endif %}

          {% if hasRepresentativeBuildingChapter %}
            <section class="city-decision-section city-decision-section--browse" aria-labelledby="city-example-buildings-heading">
              <div class="city-decision-section__header">
                <div class="eyebrow">Example Buildings</div>
                <h2 id="city-example-buildings-heading">Example Commercial Buildings in {{ city.city }}</h2>
                <p>Buildings make more sense after the location strategy is clear. These examples illustrate the types of environments businesses may evaluate; they do not indicate current availability.</p>
              </div>
              <div class="city-browse-panel">
          {% endif %}

          {% if hasRepresentativeBuildingChapter %}
            <div class="city-card city-buildings-card">
              <div class="eyebrow">Building Examples</div>
              <h2>Use buildings to understand the market</h2>
              <p>
                Review examples to understand building types, locations, and tradeoffs before checking current availability or requesting introductions.
              </p>

              <div class="building-grid">
                {% for b in displayBuildings.slice(0, 4) %}
                  {% set building = b %}
                  {% include "partials/shared/building-card-compact.njk" %}
                {% endfor %}
              </div>

              {% if cityEcosystemBuildings.length %}
                <div class="buildings-explore-card__footer-link">
                  {% for building in cityEcosystemBuildings %}
                    <a href="{{ building.canonical_path }}">{{ building.display_title }}</a>{% if not loop.last %} · {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              <div class="buildings-explore-card__footer-link">
                <a href="/commercial-real-estate/{{ city.state_abbr }}/{{ city.slug }}/buildings/">
                  View more {{ city.city }} building examples →
                </a>
              </div>
            </div>
          {% endif %}

          {% if hasRepresentativeBuildingChapter %}
            {# ===== FEATURED COMPANY CARD ===== #}
            {% set company = companies[0] %}
            {% include "partials/city/featured-company-card.njk" %}
          {% endif %}

          {% if cityMarketGuides.length %}
            <div class="city-card city-leasing-guides-card city-support-module">
              <div class="eyebrow">What to Expect</div>
              <h2>Space type changes the search</h2>
              <p>Office, retail, industrial, coworking, and flex searches each raise different questions about location, layout, access, buildout, and cost.</p>
              <ul class="mini-list">
                {% for guide in cityMarketGuides %}
                  <li>
                    <a href="{{ guide.url }}">{{ guide.space_type_label }} Guide</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if cityBusinessBriefs.length %}
            <div class="city-card city-support-module">
              <div class="eyebrow">Office by Business Type</div>
              <h2>Start with the right office districts</h2>
              <p>
                Different businesses should begin the {{ city.city }} office search in different districts. These Business Briefs explain the first places Rofo would compare and why.
              </p>
              <ul class="mini-list">
                {% for brief in cityBusinessBriefs %}
                  <li>
                    <a href="{{ brief.url }}">{{ brief.archetype.pluralLabel }}</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if availableSpaceTypes.length %}
            <div class="city-card city-popular-searches-card city-support-module">
              <div class="eyebrow">Common searches</div>
              <h2>When you are ready to look at space</h2>
              <ul class="mini-list">
                {% for item in availableSpaceTypes %}
                  <li>
                    <a href="/commercial-real-estate/{{ city.state_abbr | upper }}/{{ city.slug | lower }}/{{ item.slug }}/">
                      {{ item.search }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if hasRepresentativeBuildingChapter %}
              </div>
            </section>
          {% endif %}

          {% if hasLocalHelpChapter %}
            <section class="city-decision-section city-decision-section--broker" aria-labelledby="city-local-help-heading">
              <div class="city-decision-section__header">
                <div class="eyebrow">How do I get the deal done?</div>
                <h2 id="city-local-help-heading">Work with a Local Commercial Real Estate Expert in {{ city.city }}</h2>
                <p>A broker can help validate availability, pricing, lease terms, and building-specific tradeoffs when the search is ready for live market review. The Location Brief keeps that step grounded in the business requirements.</p>
              </div>
              <div class="city-card city-broker-journey-card">
                <div>
                  <h3>Choose when to move from analysis to introductions</h3>
                  <p>Start with an initial location analysis. Additional building examples, market information, or local introductions may be available depending on the market, requirements, and partner coverage.</p>
                </div>
                <a class="btn-primary" href="/find-locations/?city={{ city.city | urlencode }}&state={{ city.state_abbr }}&source=city_broker">Start Your Search</a>
              </div>
            </section>
          {% endif %}

        </div>

      </div>
    </div>
  </div>
</section>
