---
layout: base.njk
pagination:
  data: cities
  size: 1
  alias: city
permalink: "/commercial-real-estate/{{ city.state_abbr }}/{{ city.slug }}/index.html"
eleventyComputed:
  title: >
    {% if city.seo_title %}
      {{ city.seo_title }}
    {% else %}
      Commercial Real Estate in {{ city.city }}, {{ city.state_abbr }} | Office, Retail, Industrial | Rofo
    {% endif %}
  description: >
    {% if city.seo_description %}
      {{ city.seo_description }}
    {% else %}
      Explore office, retail, and industrial space in {{ city.city }}, {{ city.state_abbr }}. Browse buildings, compare nearby markets, and get help finding the right space.
    {% endif %}
---
{% set stateName = stateNames[city.state_abbr] or city.state_abbr %}
{% set crumbs = [
  { "label": "Markets", "url": "/markets/" },
  { "label": stateName, "url": "/commercial-real-estate/" + city.state_abbr + "/" },
  { "label": city.city + ", " + city.state_abbr, "url": page.url }
] %}

{% set cityBuildings = [] %}
{% for b in buildingPages %}
  {% if b.city_slug == city.slug and b.state_abbr == city.state_abbr %}
    {% set cityBuildings = (cityBuildings.push(b), cityBuildings) %}
  {% endif %}
{% endfor %}
{% set cityLocationFragments = cityBuildings | cityStreetFragments %}
{% set availableSpaceTypes = [] %}
{% set citySpaceTypeLinks = [
  { "slug": "office-space", "label": "Office space", "search": "Office space for lease in " + city.city },
  { "slug": "retail-space", "label": "Retail space", "search": "Retail space for lease in " + city.city },
  { "slug": "industrial-space", "label": "Industrial space", "search": "Industrial space in " + city.city },
  { "slug": "flex-space", "label": "Flex space", "search": "Flex space in " + city.city },
  { "slug": "coworking-space", "label": "Coworking space", "search": "Coworking space in " + city.city }
] %}
{% for item in citySpaceTypeLinks %}
  {% set pageKey = (city.state_abbr | upper) + "/" + (city.slug | lower) + "/" + item.slug %}
  {% if spaceTypePageLookup[pageKey] %}
    {% set availableSpaceTypes = (availableSpaceTypes.push(item), availableSpaceTypes) %}
  {% endif %}
{% endfor %}
{% set cityMarketGuides = [] %}
{% for item in citySpaceTypeLinks %}
  {% set guideKey = (city.state_abbr | upper) + "/" + (city.slug | lower) + "/" + item.slug %}
  {% if marketGuideLookup[guideKey] %}
    {% set cityMarketGuides = (cityMarketGuides.push(marketGuideLookup[guideKey]), cityMarketGuides) %}
  {% endif %}
{% endfor %}
{% set cityMarketGuideKey = (city.state_abbr | upper) + "/" + (city.slug | lower) + "/" %}
{% set cityMarketGuide = marketGuideLookup[cityMarketGuideKey] %}
{% set cityNeighborhoods = [] %}
{% for neighborhood in neighborhoodPages %}
  {% if neighborhood.city_slug == city.slug and neighborhood.state_abbr == city.state_abbr and not neighborhood.noindex %}
    {% set cityNeighborhoods = (cityNeighborhoods.push(neighborhood), cityNeighborhoods) %}
  {% endif %}
{% endfor %}
{% set cityEcosystemBuildings = [] %}
{% for building in ecosystemPublicBuildings %}
  {% if building.city_slug == city.slug and building.state_abbr == city.state_abbr %}
    {% set cityEcosystemBuildings = (cityEcosystemBuildings.push(building), cityEcosystemBuildings) %}
  {% endif %}
{% endfor %}
{% set snapshotItems = [] %}
{% set marketSnapshot = city.market_snapshot or {} %}
{% set snapshotTitle = marketSnapshot.snapshot_title or city.snapshot_title or "Market Snapshot" %}
{% if marketSnapshot.average_rent %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Average Rent", "value": marketSnapshot.average_rent, "note": marketSnapshot.average_rent_label, "direction": marketSnapshot.average_rent_direction }), snapshotItems) %}
{% elseif city.avg_rent %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Average Rent", "value": city.avg_rent, "note": city.avg_rent_label or city.average_rent_label, "direction": city.average_rent_direction }), snapshotItems) %}
{% elseif city.average_rent %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Average Rent", "value": city.average_rent, "note": city.average_rent_label, "direction": city.average_rent_direction }), snapshotItems) %}
{% endif %}
{% if marketSnapshot.availability_rate %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Availability", "value": marketSnapshot.availability_rate, "note": marketSnapshot.availability_label, "direction": marketSnapshot.availability_direction }), snapshotItems) %}
{% elseif city.availability_rate %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Availability", "value": city.availability_rate, "note": city.availability_label, "direction": city.availability_direction }), snapshotItems) %}
{% elseif city.vacancy_rate %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Availability", "value": city.vacancy_rate, "note": city.vacancy_label or city.vacancy_rate_label, "direction": city.availability_direction }), snapshotItems) %}
{% endif %}
{% if marketSnapshot.market_trend %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Market Trend", "value": marketSnapshot.market_trend, "note": marketSnapshot.market_trend_label, "direction": marketSnapshot.market_trend_direction }), snapshotItems) %}
{% elseif city.market_trend %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Market Trend", "value": city.market_trend, "note": city.market_trend_label, "direction": city.market_trend_direction }), snapshotItems) %}
{% endif %}
{% if marketSnapshot.notable_areas and marketSnapshot.notable_areas.length %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Notable Areas", "areas": marketSnapshot.notable_areas, "note": marketSnapshot.notable_areas_label }), snapshotItems) %}
{% elseif city.notable_areas and city.notable_areas.length %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Notable Areas", "areas": city.notable_areas, "note": city.notable_areas_label }), snapshotItems) %}
{% elseif city.trending_neighborhood %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Notable Areas", "value": city.trending_neighborhood, "note": city.trending_neighborhood_label }), snapshotItems) %}
{% elseif city.notable_neighborhood %}
  {% set snapshotItems = (snapshotItems.push({ "label": "Notable Areas", "value": city.notable_neighborhood, "note": city.notable_neighborhood_label }), snapshotItems) %}
{% endif %}
{% set featuredBuildings = [] %}
{% for b in buildingPages %}
  {% if b.city_slug == city.slug and b.state_abbr == city.state_abbr and not b.featured_company_slug %}
    {% set featuredBuildings = (featuredBuildings.push(b), featuredBuildings) %}
  {% endif %}
{% endfor %}
{% set displayBuildings = featuredBuildings if featuredBuildings.length else cityBuildings %}
{% set cityLocationModelPath = "/commercial-real-estate/" + city.state_abbr + "/" + city.slug + "/" %}
{% set cityLocationModel = commercialLocationModel.byPath[cityLocationModelPath] %}
{% set cityLocationComparisons = [] %}
{% if cityLocationModel and cityLocationModel.compare_with and cityLocationModel.compare_with.length %}
  {% for comparison in cityLocationModel.compare_with %}
    {% if comparison.comparison_path %}
      {% set cityLocationComparisons = (cityLocationComparisons.push(comparison), cityLocationComparisons) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set searchProfileLocationSuggestions = [] %}
{% if cityNeighborhoods.length %}
  {% for neighborhood in cityNeighborhoods.slice(0, 6) %}
    {% set searchProfileLocationSuggestions = (searchProfileLocationSuggestions.push(neighborhood.name), searchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}
{% if cityLocationComparisons.length %}
  {% for comparison in cityLocationComparisons.slice(0, 6) %}
    {% set searchProfileLocationSuggestions = (searchProfileLocationSuggestions.push(comparison.district_name), searchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}
{% if city.nearby_cities and city.nearby_cities.length %}
  {% for nearby in city.nearby_cities.slice(0, 6) %}
    {% set searchProfileLocationSuggestions = (searchProfileLocationSuggestions.push(nearby.city), searchProfileLocationSuggestions) %}
  {% endfor %}
{% endif %}

<section class="city-page">
  <div class="city-shell">
    {% include "partials/breadcrumbs.njk" %}

    <div class="city-hero">
      <div class="city-card">
        <div class="city-hero-copy">
          <div class="eyebrow">Market</div>

          <h1>Commercial Real Estate in {{ city.city }}, {{ city.state_abbr }}</h1>

          <p class="lead">
            Explore office, retail, and industrial space for lease in {{ city.city }}, {{ city.state_abbr }}.
            Browse buildings, compare nearby markets, or get help finding available space.
          </p>

          <div class="hero-actions">
            <a class="btn-secondary" href="/commercial-real-estate/{{ city.state_abbr }}/{{ city.slug }}/buildings/">
              Browse Buildings
            </a>
          </div>

          <div class="hero-pill-wrap">
            {% include "partials/space-type/pill-nav.njk" %}
          </div>
        </div>
      </div>

      <div class="city-sidecard">
        <div class="hero-media">

          {% if city.hero_image %}
            <img
              class="hero-image"
              src="{{ city.hero_image }}"
              alt="{{ city.hero_image_alt or (city.city + ", " + city.state_abbr) }}"
              width="1200"
              height="400"
              fetchpriority="high"
              decoding="async"
            />
          {% else %}
            <div
              class="hero-image hero-image--placeholder hero-image--theme-{{ city.placeholder_theme }}"
              data-location="{{ city.city }}, {{ city.state_abbr }}"
              aria-label="{{ city.city }}, {{ city.state_abbr }}"
            ></div>
          {% endif %}

          <div class="hero-overlay">
            <p class="hero-overlay-title">{{ city.city }}, {{ city.state_abbr }}</p>
            <p class="hero-overlay-meta">Commercial Real Estate Market</p>
          </div>

        </div>
      </div>
    </div>

    <div class="city-main">
      <div class="city-main-left">
        <div class="city-grid">
          {% if cityMarketGuide %}
            <div class="city-card city-market-guide-card">
              <div class="eyebrow">Market Guide</div>
              <h2>{{ city.city }} Commercial Real Estate Market Guide</h2>
              <p>
                See leasing trends, average rents, neighborhood notes, and nearby market comparisons for {{ city.city }}.
              </p>
              <a class="building-link" href="{{ cityMarketGuide.url }}">View the {{ city.city }} Market Guide →</a>
            </div>
          {% endif %}

          {% if cityLocationComparisons.length %}
            <div class="city-card city-location-comparisons-card">
              <div class="eyebrow">Location comparisons</div>
              <h2>
                {% if cityLocationModel.warehouse_flex_profile %}
                  Compare nearby industrial markets
                {% else %}
                  Businesses comparing this market also evaluate
                {% endif %}
              </h2>
              <p>
                {% if cityLocationModel.warehouse_flex_profile %}
                  Warehouse, flex, and service-commercial users often compare {{ city.city }} with nearby markets based on access, loading needs, building format, and operational fit.
                {% else %}
                  Businesses often compare {{ city.city }} with nearby markets before narrowing to specific buildings or spaces.
                {% endif %}
              </p>
              <div class="neighborhood-comparison-grid">
                {% for comparison in cityLocationComparisons %}
                  <a class="neighborhood-comparison-card neighborhood-link-card" href="{{ comparison.comparison_path }}">
                    <h3>{{ city.city }} vs {{ comparison.district_name }}</h3>
                    <p>{{ comparison.reason }}</p>
                  </a>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          {% if snapshotItems.length >= 2 %}
            <div class="city-card city-market-snapshot">
              <div class="eyebrow">{{ snapshotTitle }}</div>
              <div class="city-market-snapshot__grid">
                {% for item in snapshotItems %}
                  <div class="city-market-snapshot__item">
                    <div class="stat-label">{{ item.label }}</div>
                    {% if item.areas and item.areas.length %}
                      <div class="stat-value stat-value--list">
                        {% for area in item.areas %}
                          <span>{{ area }}</span>
                        {% endfor %}
                      </div>
                    {% else %}
                      <div class="stat-value">
                        {{ item.value }}
                        {% if item.direction == "up" %}
                          <span class="stat-direction" aria-label="Up">↑</span>
                        {% elseif item.direction == "down" %}
                          <span class="stat-direction" aria-label="Down">↓</span>
                        {% elseif item.direction == "flat" %}
                          <span class="stat-direction" aria-label="Flat">→</span>
                        {% endif %}
                      </div>
                    {% endif %}
                    {% if item.note %}
                      <p class="stat-note">{{ item.note }}</p>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
              {% if city.market_snapshot_note %}
                <p>{{ city.market_snapshot_note }}</p>
              {% endif %}
            </div>
          {% endif %}

          {% if cityNeighborhoods.length %}
            <div class="city-card city-neighborhoods-card">
              <div class="eyebrow">Neighborhoods</div>
              <h2>Explore neighborhoods and commercial areas</h2>
              <p>Compare neighborhoods, business districts, and commercial areas within {{ city.city }}.</p>
              {% set visibleNeighborhoods = cityNeighborhoods.slice(0, 8) %}
              {% set hiddenNeighborhoods = cityNeighborhoods.slice(8) %}
              <div class="city-neighborhood-link-list">
                {% for neighborhood in visibleNeighborhoods %}
                  <a href="{{ neighborhood.canonical_neighborhood_path }}">{{ neighborhood.name }}</a>
                {% endfor %}
              </div>
              {% if city.slug == "new-york" and hiddenNeighborhoods.length %}
                {% set manhattanNeighborhoods = [] %}
                {% set brooklynNeighborhoods = [] %}
                {% set otherNycNeighborhoods = [] %}
                {% for neighborhood in cityNeighborhoods %}
                  {% if neighborhood.borough == "Manhattan" %}
                    {% set manhattanNeighborhoods = (manhattanNeighborhoods.push(neighborhood), manhattanNeighborhoods) %}
                  {% elseif neighborhood.borough == "Brooklyn" %}
                    {% set brooklynNeighborhoods = (brooklynNeighborhoods.push(neighborhood), brooklynNeighborhoods) %}
                  {% else %}
                    {% set otherNycNeighborhoods = (otherNycNeighborhoods.push(neighborhood), otherNycNeighborhoods) %}
                  {% endif %}
                {% endfor %}
                <details class="city-neighborhoods-all">
                  <summary>View more neighborhoods</summary>
                  {% if manhattanNeighborhoods.length %}
                    <h3>Manhattan</h3>
                    <div class="city-neighborhood-link-list city-neighborhood-link-list--all">
                      {% for neighborhood in manhattanNeighborhoods %}
                        <a href="{{ neighborhood.canonical_neighborhood_path }}">{{ neighborhood.name }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% if brooklynNeighborhoods.length %}
                    <h3>Brooklyn</h3>
                    <div class="city-neighborhood-link-list city-neighborhood-link-list--all">
                      {% for neighborhood in brooklynNeighborhoods %}
                        <a href="{{ neighborhood.canonical_neighborhood_path }}">{{ neighborhood.name }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% if otherNycNeighborhoods.length %}
                    <h3>Other areas</h3>
                    <div class="city-neighborhood-link-list city-neighborhood-link-list--all">
                      {% for neighborhood in otherNycNeighborhoods %}
                        <a href="{{ neighborhood.canonical_neighborhood_path }}">{{ neighborhood.name }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                </details>
              {% elseif hiddenNeighborhoods.length %}
                <details class="city-neighborhoods-all">
                  <summary>View more neighborhoods</summary>
                  <div class="city-neighborhood-link-list city-neighborhood-link-list--all">
                    {% for neighborhood in hiddenNeighborhoods %}
                      <a href="{{ neighborhood.canonical_neighborhood_path }}">{{ neighborhood.name }}</a>
                    {% endfor %}
                  </div>
                </details>
              {% endif %}
            </div>
          {% endif %}

          {% if cityBuildings.length > 0 %}
            <div class="city-card city-buildings-card">
              <div class="eyebrow">Buildings to Explore</div>
              <h2>Buildings to Explore in {{ city.city }}</h2>
              <p>
                Explore {{ cityBuildings.length }} {% if cityBuildings.length == 1 %}building{% else %}buildings{% endif %} in {{ city.city }}{% if availableSpaceTypes.length %}, including {% for item in availableSpaceTypes %}{% if loop.index > 1 and loop.last %} and {% elseif loop.index > 1 %}, {% endif %}{{ item.label | lower }}{% endfor %} options{% endif %}.
              </p>
              {% if cityLocationFragments.length >= 3 %}
                <p>
                  Example locations include {% for fragment in cityLocationFragments.slice(0, 3) %}{% if loop.index > 1 and loop.last %} and {% elseif loop.index > 1 %}, {% endif %}{{ fragment }}{% endfor %}.
                </p>
              {% endif %}

              <div class="building-grid">
                {% for b in displayBuildings.slice(0, 6) %}
                  {% set building = b %}
                  {% include "partials/shared/building-card-compact.njk" %}
                {% endfor %}
              </div>

              {% if cityEcosystemBuildings.length %}
                <div class="buildings-explore-card__footer-link">
                  {% for building in cityEcosystemBuildings %}
                    <a href="{{ building.canonical_path }}">{{ building.display_title }}</a>{% if not loop.last %} · {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              <div class="buildings-explore-card__footer-link">
                <a href="/commercial-real-estate/{{ city.state_abbr }}/{{ city.slug }}/buildings/">
                  Browse all buildings in {{ city.city }} →
                </a>
              </div>
            </div>
          {% endif %}

          {# ===== FEATURED COMPANY CARD ===== #}
          {% set company = companies[0] %}
          {% include "partials/city/featured-company-card.njk" %}

          {% if cityMarketGuides.length %}
            <div class="city-card city-leasing-guides-card">
              <div class="eyebrow">Leasing Guides</div>
              <h2>Leasing guides for {{ city.city }}</h2>
              <p>Explore space-specific leasing guides for {{ city.city }}, including office, retail, industrial, coworking, and flex space where available.</p>
              <ul class="mini-list">
                {% for guide in cityMarketGuides %}
                  <li>
                    <a href="{{ guide.url }}">{{ guide.space_type_label }} Guide</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if availableSpaceTypes.length %}
            <div class="city-card city-popular-searches-card">
              <div class="eyebrow">Popular Searches</div>
              <h2>Popular commercial real estate searches in {{ city.city }}</h2>
              <ul class="mini-list">
                {% for item in availableSpaceTypes %}
                  <li>
                    <a href="/commercial-real-estate/{{ city.state_abbr | upper }}/{{ city.slug | lower }}/{{ item.slug }}/">
                      {{ item.search }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <div class="city-card city-nearby-markets-card">
            <div class="eyebrow">Nearby Markets</div>
            <h2>Compare nearby markets</h2>
            <p>Businesses often compare {{ city.city }} with nearby markets when evaluating pricing, access, inventory, and location fit.</p>

            <div class="market-links">
              {% if city.nearby_cities and city.nearby_cities.length %}
                {% for nearby in city.nearby_cities %}
                  <a href="{{ nearby.path }}">
                    {{ nearby.city }}, {{ nearby.state_abbr }}
                  </a>
                {% endfor %}
              {% else %}
                <span class="subtle-note">Nearby markets will appear here as city coverage expands.</span>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="city-main-right">
        {% set searchProfileContext = {
          "layout": "inline",
          "submit_enabled": true,
          "submit_endpoint": "/api/leads/submit",
          "target_area": city.city,
          "city": city.city,
          "district": "",
          "street": "",
          "state": city.state_abbr,
          "context_type": "city",
          "context_label": city.city + ", " + city.state_abbr,
          "page_url": metadata.siteUrl + page.url,
          "page_title": title,
          "routing_market": city.routing_market or (city.slug + "-" + (city.state_abbr | lower)),
          "routing_county": city.routing_county or "",
          "neighborhood_name": "",
          "neighborhood_slug": "",
          "neighborhood_path": "",
          "commercial_area_id": "",
          "commercial_area_type": "",
          "location_suggestions": searchProfileLocationSuggestions
        } %}
        {% include "partials/shared/search-profile-card.njk" %}
      </div>
    </div>
  </div>
</section>

<script src="/js/search-profile.js" defer></script>
